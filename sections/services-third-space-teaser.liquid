{%- style -%}
  #ts-{{ section.id }} {
    background: #1B3A2D;
    padding: 8rem 5%;
    box-sizing: border-box;
    width: 100%;
  }

  #ts-{{ section.id }} .ts-eyebrow {
    font-family: 'Poppins', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0 0 1.5rem;
  }

  #ts-{{ section.id }} .ts-heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    color: #F5F0E8;
    margin: 0 0 1.5rem;
  }

  #ts-{{ section.id }} .ts-heading em {
    font-style: italic;
  }

  #ts-{{ section.id }} .ts-subtitle {
    font-family: 'Poppins', sans-serif;
    font-size: 1.15rem;
    line-height: 1.7;
    color: #F5F0E8;
    opacity: 0.9;
    margin: 0;
  }

  #ts-{{ section.id }} .ts-branch-label {
    font-family: 'Poppins', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0 0 0.6rem;
  }

  #ts-{{ section.id }} .ts-branch-name {
    font-family: var(--font-heading-family);
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    font-weight: 700;
    line-height: 1.2;
    color: #F5F0E8;
    margin: 0 0 0.6rem;
  }

  #ts-{{ section.id }} .ts-branch-vibe {
    font-family: 'Poppins', sans-serif;
    font-size: 1rem;
    font-style: italic;
    line-height: 1.65;
    color: #F5F0E8;
    opacity: 0.85;
    margin: 0 0 2rem;
  }

  #ts-{{ section.id }} .ts-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2.2rem;
    background: transparent;
    color: #F5F0E8;
    border-radius: 50px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1.5px solid rgba(245, 240, 232, 0.6);
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
    white-space: nowrap;
  }

  #ts-{{ section.id }} .ts-button:hover {
    background: #C8A96E;
    color: #1B3A2D;
    border-color: #C8A96E;
  }

  #ts-{{ section.id }} .ts-img-inner {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 749px) {
    #ts-{{ section.id }} {
      padding: 6rem 5%;
    }
    #ts-{{ section.id }} .ts-branches-row {
      flex-direction: column !important;
      gap: 4rem !important;
    }
    #ts-{{ section.id }} .ts-branch-divider {
      display: none !important;
    }
    #ts-{{ section.id }} .ts-branch-col {
      padding: 0 !important;
    }
  }
{%- endstyle -%}

<section id="ts-{{ section.id }}" aria-label="The Third Space">

  {%- comment -%}── Page Container ──{%- endcomment -%}
  <div style="max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:5rem;">

    {%- comment -%}── Part 1: Intro ──{%- endcomment -%}
    <div style="max-width:800px;margin:0 auto;text-align:center;">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ts-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ts-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="ts-subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>

    {%- comment -%}── Part 2: Branch Columns ──{%- endcomment -%}
    <div class="ts-branches-row" style="display:flex;flex-direction:row;align-items:flex-start;gap:0;">

      {%- comment -%}Branch 1{%- endcomment -%}
      <div class="ts-branch-col" style="flex:1 1 0%;min-width:0;display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 3rem;box-sizing:border-box;">
        <div style="position:relative;width:100%;padding-bottom:62.5%;border-radius:12px;overflow:hidden;margin-bottom:2rem;background:rgba(245,240,232,0.08);flex-shrink:0;">
          {%- if section.settings.branch_1_image != blank -%}
            {{ section.settings.branch_1_image | image_url: width: 900 | image_tag: class: 'ts-img-inner', loading: 'lazy' }}
          {%- endif -%}
        </div>
        {%- if section.settings.branch_1_label != blank -%}
          <p class="ts-branch-label">{{ section.settings.branch_1_label | escape }}</p>
        {%- endif -%}
        {%- if section.settings.branch_1_name != blank -%}
          <h3 class="ts-branch-name">{{ section.settings.branch_1_name | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.branch_1_vibe != blank -%}
          <p class="ts-branch-vibe">{{ section.settings.branch_1_vibe | escape }}</p>
        {%- endif -%}
        {%- if section.settings.branch_1_btn_label != blank -%}
          <a href="{{ section.settings.branch_1_btn_url }}?branch=opus" class="ts-button">
            {{ section.settings.branch_1_btn_label | escape }}
          </a>
        {%- endif -%}
      </div>

      {%- comment -%}Gold Divider{%- endcomment -%}
      <div class="ts-branch-divider" style="width:1px;align-self:stretch;background:#C8A96E;opacity:0.4;flex-shrink:0;" aria-hidden="true"></div>

      {%- comment -%}Branch 2{%- endcomment -%}
      <div class="ts-branch-col" style="flex:1 1 0%;min-width:0;display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 3rem;box-sizing:border-box;">
        <div style="position:relative;width:100%;padding-bottom:62.5%;border-radius:12px;overflow:hidden;margin-bottom:2rem;background:rgba(245,240,232,0.08);flex-shrink:0;">
          {%- if section.settings.branch_2_image != blank -%}
            {{ section.settings.branch_2_image | image_url: width: 900 | image_tag: class: 'ts-img-inner', loading: 'lazy' }}
          {%- endif -%}
        </div>
        {%- if section.settings.branch_2_label != blank -%}
          <p class="ts-branch-label">{{ section.settings.branch_2_label | escape }}</p>
        {%- endif -%}
        {%- if section.settings.branch_2_name != blank -%}
          <h3 class="ts-branch-name">{{ section.settings.branch_2_name | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.branch_2_vibe != blank -%}
          <p class="ts-branch-vibe">{{ section.settings.branch_2_vibe | escape }}</p>
        {%- endif -%}
        {%- if section.settings.branch_2_btn_label != blank -%}
          <a href="{{ section.settings.branch_2_btn_url }}?branch=alabang" class="ts-button">
            {{ section.settings.branch_2_btn_label | escape }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Third Space Teaser",
  "settings": [
    {
      "type": "header",
      "content": "Intro Block"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE THIRD SPACE"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading (HTML allowed)",
      "default": "Find Your <em>Third Place.</em>",
      "info": "Use <em> tags to italicize text."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A quiet corner to work, a table for a meeting, or the entire space for an event — we have a spot for you."
    },
    {
      "type": "header",
      "content": "Branch 1 (Opus)"
    },
    {
      "type": "image_picker",
      "id": "branch_1_image",
      "label": "Branch 1 Image"
    },
    {
      "type": "text",
      "id": "branch_1_label",
      "label": "Branch 1 Label",
      "default": "WTP OPUS"
    },
    {
      "type": "text",
      "id": "branch_1_name",
      "label": "Branch 1 Name",
      "default": "Opus Mall, Bridgetowne"
    },
    {
      "type": "text",
      "id": "branch_1_vibe",
      "label": "Branch 1 Vibe Description",
      "default": "A vibrant oasis in the heart of Bridgetowne."
    },
    {
      "type": "text",
      "id": "branch_1_btn_label",
      "label": "Branch 1 Button Label",
      "default": "Reserve at Opus"
    },
    {
      "type": "url",
      "id": "branch_1_btn_url",
      "label": "Branch 1 Button URL"
    },
    {
      "type": "header",
      "content": "Branch 2 (Alabang)"
    },
    {
      "type": "image_picker",
      "id": "branch_2_image",
      "label": "Branch 2 Image"
    },
    {
      "type": "text",
      "id": "branch_2_label",
      "label": "Branch 2 Label",
      "default": "WTP ALABANG"
    },
    {
      "type": "text",
      "id": "branch_2_name",
      "label": "Branch 2 Name",
      "default": "Ayala Alabang, Muntinlupa"
    },
    {
      "type": "text",
      "id": "branch_2_vibe",
      "label": "Branch 2 Vibe Description",
      "default": "Your cozy neighborhood retreat in the south."
    },
    {
      "type": "text",
      "id": "branch_2_btn_label",
      "label": "Branch 2 Button Label",
      "default": "Reserve at Alabang"
    },
    {
      "type": "url",
      "id": "branch_2_btn_url",
      "label": "Branch 2 Button URL"
    }
  ],
  "presets": [
    {
      "name": "Third Space Teaser"
    }
  ]
}
{% endschema %}
