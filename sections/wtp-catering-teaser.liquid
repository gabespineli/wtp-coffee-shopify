{%- style -%}
  #wtp-catering-teaser-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: 6rem 5%;
    color: {{ section.settings.text_color }};
    overflow: hidden;
  }

  .ct-container {
    max-width: 1380px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7rem;
    align-items: center;
  }

  /* ── Text Side ── */
  .ct-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .ct-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin: 0;
  }

  .ct-heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 4vw, 3.5rem);
    font-weight: 700;
    font-style: italic;
    line-height: 1.1;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .ct-desc {
    font-size: 1.1rem;
    line-height: 1.8;
    color: {{ section.settings.text_color }};
    opacity: 0.8;
    margin: 0;
    max-width: 520px;
  }

  /* ── Bullets ── */
  .ct-bullets {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0.5rem 0;
  }

  .ct-bullet {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: {{ section.settings.text_color }};
  }

  .ct-bullet-icon {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1.5px solid {{ section.settings.accent_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: {{ section.settings.accent_color }};
  }

  .ct-bullet-icon svg {
    width: 20px;
    height: 20px;
  }

  /* ── CTA Button ── */
  .ct-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    align-self: flex-start;
    padding: 1.1rem 2.5rem;
    background: {{ section.settings.text_color }};
    color: {{ section.settings.bg_color }};
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1.5px solid {{ section.settings.text_color }};
    transition: background 0.25s ease, color 0.25s ease;
    margin-top: 0.5rem;
  }

  .ct-cta:hover {
    background: transparent;
    color: {{ section.settings.text_color }};
  }

  /* ── Image Side ── */
  .ct-image-col {
    position: relative;
  }

  .ct-img-wrap {
    width: 100%;
    aspect-ratio: 4/5;
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 24px 60px rgba(0,0,0,0.35);
  }

  .ct-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ct-img-placeholder {
    width: 100%;
    height: 100%;
    background: rgba(255,255,255,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ct-img-placeholder svg {
    width: 60px;
    height: 60px;
    opacity: 0.2;
    color: #fff;
  }

  /* ── Overlapping Quote Card ── */
  .ct-quote-card {
    position: absolute;
    bottom: -2rem;
    left: -2.5rem;
    background: #FFFFFF;
    border-radius: 16px;
    padding: 2rem 2.2rem;
    max-width: 320px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.22);
    z-index: 2;
  }

  .ct-quote-mark {
    font-family: var(--font-heading-family);
    font-size: 4rem;
    color: {{ section.settings.accent_color }};
    line-height: 0.5;
    margin-bottom: 1rem;
    display: block;
    opacity: 0.5;
  }

  .ct-quote-text {
    font-family: var(--font-heading-family);
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 600;
    line-height: 1.5;
    color: #1B3A2D;
    margin: 0 0 1rem;
  }

  .ct-quote-attr {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin: 0;
  }

  /* ── Mobile ── */
  @media screen and (max-width: 900px) {
    .ct-container {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .ct-image-col {
      order: -1;
      padding-bottom: 3.5rem;
    }

    .ct-img-wrap {
      aspect-ratio: 3/2;
    }

    .ct-quote-card {
      left: 50%;
      transform: translateX(-50%);
      bottom: -3rem;
      width: 90%;
      max-width: 380px;
    }
  }

  @media screen and (max-width: 600px) {
    #wtp-catering-teaser-{{ section.id }} {
      padding: 5rem 5%;
    }

    .ct-image-col {
      padding-bottom: 4rem;
    }
  }
{%- endstyle -%}

<section id="wtp-catering-teaser-{{ section.id }}" aria-label="{{ section.settings.heading | escape }}">
  <div class="ct-container">

    {%- comment -%} ── Text Column ── {%- endcomment -%}
    <div class="ct-text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ct-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="ct-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="ct-desc">{{ section.settings.description | escape }}</p>
      {%- endif -%}

      <div class="ct-bullets">
        {%- if section.settings.bullet_1 != blank -%}
          <div class="ct-bullet">
            <span class="ct-bullet-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17 8h1a4 4 0 1 1 0 8h-1"/>
                <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/>
                <line x1="6" x2="6" y1="2" y2="4"/>
                <line x1="10" x2="10" y1="2" y2="4"/>
                <line x1="14" x2="14" y1="2" y2="4"/>
              </svg>
            </span>
            {{ section.settings.bullet_1 | escape }}
          </div>
        {%- endif -%}

        {%- if section.settings.bullet_2 != blank -%}
          <div class="ct-bullet">
            <span class="ct-bullet-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 3h18v13H3z"/>
                <path d="M3 21h18"/>
                <path d="M7 21v-5"/>
                <path d="M17 21v-5"/>
                <path d="M12 16v5"/>
              </svg>
            </span>
            {{ section.settings.bullet_2 | escape }}
          </div>
        {%- endif -%}

        {%- if section.settings.bullet_3 != blank -%}
          <div class="ct-bullet">
            <span class="ct-bullet-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                <line x1="7" y1="7" x2="7.01" y2="7"/>
              </svg>
            </span>
            {{ section.settings.bullet_3 | escape }}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_url }}"
          class="ct-cta"
          {%- if section.settings.button_url == blank -%} aria-disabled="true" {%- endif -%}
        >
          {{ section.settings.button_label | escape }}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} ── Image Column ── {%- endcomment -%}
    <div class="ct-image-col">
      <div class="ct-img-wrap">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
        {%- else -%}
          <div class="ct-img-placeholder">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.quote != blank -%}
        <div class="ct-quote-card">
          <span class="ct-quote-mark" aria-hidden="true">&ldquo;</span>
          <p class="ct-quote-text">{{ section.settings.quote | escape }}</p>
          {%- if section.settings.quote_attr != blank -%}
            <p class="ct-quote-attr">{{ section.settings.quote_attr | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Catering Teaser",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1B3A2D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Eyebrow Color",
      "default": "#C8A96E"
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Event Coffee Services"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bring WTP to Your Event."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "From intimate private gatherings to large-scale corporate functions, our coffee cart and third space services bring the full WTP experience to you. Every cup, crafted with intention."
    },
    {
      "type": "text",
      "id": "bullet_1",
      "label": "Bullet 1 Label",
      "default": "Coffee Cart — Mobile specialty bar for your event"
    },
    {
      "type": "text",
      "id": "bullet_2",
      "label": "Bullet 2 Label",
      "default": "Third Space — Host at our café in Alabang or Bridgetowne"
    },
    {
      "type": "text",
      "id": "bullet_3",
      "label": "Bullet 3 Label",
      "default": "Wholesale & Custom Blends — For cafés and businesses"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Inquire for Bookings"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Image and Quote"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote Text",
      "default": "Every cup we serve is an opportunity to create connection and care."
    },
    {
      "type": "text",
      "id": "quote_attr",
      "label": "Quote Attribution",
      "default": "WTP Coffee, Our Mission"
    }
  ],
  "presets": [
    {
      "name": "Catering Teaser"
    }
  ]
}
{% endschema %}
