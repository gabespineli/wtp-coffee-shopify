{%- style -%}
  #wtp-catering-teaser-{{ section.id }} {
    background: #F5F0E8;
    padding: 6rem 5%;
    overflow: hidden;
  }

  .ct-card {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: 16px;
    box-shadow: 0 16px 48px rgba(0,0,0,0.08);
    overflow: hidden;
    background: #1B3A2D;
  }

  /* ── Left Column (Text) ── */
  .ct-left-col {
    padding: 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    background: #1B3A2D;
    color: #F5F0E8;
  }

  .ct-eyebrow {
    font-family: 'Poppins', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0;
  }

  .ct-heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 4vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: #F5F0E8;
    margin: 0;
  }

  .ct-desc {
    font-family: 'Poppins', sans-serif;
    font-size: 1.05rem;
    line-height: 1.7;
    color: #F5F0E8;
    opacity: 0.85;
    margin: 0;
    max-width: 520px;
  }

  /* ── Bullets ── */
  .ct-bullets {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    margin: 0.5rem 0;
  }

  .ct-bullet {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: 'Poppins', sans-serif;
    font-size: 1.05rem;
    font-weight: 500;
    color: #F5F0E8;
  }

  .ct-bullet-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(245, 240, 232, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #C8A96E;
  }

  .ct-bullet-icon svg {
    width: 14px;
    height: 14px;
  }

  /* ── CTA Button ── */
  .ct-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    padding: 1rem 2.5rem;
    background: transparent;
    color: #F5F0E8;
    border-radius: 50px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1.5px solid #F5F0E8;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    margin-top: 1rem;
  }

  .ct-cta:hover {
    background: #C8A96E;
    color: #1B3A2D;
    border-color: #C8A96E;
  }

  /* ── Right Column (Image) ── */
  .ct-right-col {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 450px;
    display: flex;
  }

  .ct-right-col img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ct-img-placeholder {
    width: 100%;
    height: 100%;
    background: #E8E2D5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ct-img-placeholder svg {
    width: 60px;
    height: 60px;
    opacity: 0.5;
    color: #C8A96E;
  }

  /* ── Overlapping Quote Card ── */
  .ct-quote-card {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    background: #F5F0E8;
    border-radius: 12px;
    padding: 1.8rem 2rem;
    max-width: 320px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.15);
    z-index: 2;
  }

  .ct-quote-mark {
    font-family: var(--font-heading-family);
    font-size: 3.5rem;
    color: #C8A96E;
    line-height: 0.5;
    margin-bottom: 0.5rem;
    display: block;
  }

  .ct-quote-text {
    font-family: var(--font-heading-family);
    font-size: 1.15rem;
    font-style: italic;
    font-weight: 600;
    line-height: 1.4;
    color: #1B3A2D;
    margin: 0 0 1rem;
  }

  .ct-quote-attr {
    font-family: 'Poppins', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0;
  }

  /* ── Mobile ── */
  @media screen and (max-width: 900px) {
    .ct-card {
      grid-template-columns: 1fr;
    }

    .ct-left-col {
      padding: 3rem 2rem;
    }

    .ct-right-col {
      min-height: 400px;
    }

    .ct-quote-card {
      bottom: 1.5rem;
      right: 1.5rem;
      left: 1.5rem;
      max-width: none;
    }
  }

  @media screen and (max-width: 600px) {
    #wtp-catering-teaser-{{ section.id }} {
      padding: 4rem 1.25rem;
    }
  }
{%- endstyle -%}

<section id="wtp-catering-teaser-{{ section.id }}" aria-label="{{ section.settings.heading | escape }}">
  <div class="ct-card">

    {%- comment -%} ── Text Column ── {%- endcomment -%}
    <div class="ct-left-col">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ct-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="ct-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="ct-desc">{{ section.settings.description | escape }}</p>
      {%- endif -%}

      <div class="ct-bullets">
        {%- if section.settings.bullet_1 != blank -%}
          <div class="ct-bullet">
            <span class="ct-bullet-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17 8h1a4 4 0 1 1 0 8h-1"/>
                <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/>
                <line x1="6" x2="6" y1="2" y2="4"/>
                <line x1="10" x2="10" y1="2" y2="4"/>
                <line x1="14" x2="14" y1="2" y2="4"/>
              </svg>
            </span>
            {{ section.settings.bullet_1 | escape }}
          </div>
        {%- endif -%}

        {%- if section.settings.bullet_2 != blank -%}
          <div class="ct-bullet">
            <span class="ct-bullet-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 3h18v13H3z"/>
                <path d="M3 21h18"/>
                <path d="M7 21v-5"/>
                <path d="M17 21v-5"/>
                <path d="M12 16v5"/>
              </svg>
            </span>
            {{ section.settings.bullet_2 | escape }}
          </div>
        {%- endif -%}

        {%- if section.settings.bullet_3 != blank -%}
          <div class="ct-bullet">
            <span class="ct-bullet-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                <line x1="7" y1="7" x2="7.01" y2="7"/>
              </svg>
            </span>
            {{ section.settings.bullet_3 | escape }}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_url }}"
          class="ct-cta"
          {%- if section.settings.button_url == blank -%} aria-disabled="true" {%- endif -%}
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} ── Image Column ── {%- endcomment -%}
    <div class="ct-right-col">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
      {%- else -%}
        <div class="ct-img-placeholder">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
      {%- endif -%}

      {%- if section.settings.quote != blank -%}
        <div class="ct-quote-card">
          <span class="ct-quote-mark" aria-hidden="true">&ldquo;</span>
          <p class="ct-quote-text">{{ section.settings.quote | escape }}</p>
          {%- if section.settings.quote_attr != blank -%}
            <p class="ct-quote-attr">{{ section.settings.quote_attr | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Catering Teaser",
  "settings": [
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "EXPERIENCE EXCELLENCE ANYWHERE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Host an Event with WTP Coffee."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "From intimate private gatherings to large-scale corporate functions, our coffee cart and third space services bring the full WTP experience to you. Every cup, crafted with intention."
    },
    {
      "type": "text",
      "id": "bullet_1",
      "label": "Bullet 1 Label",
      "default": "Coffee Cart Service"
    },
    {
      "type": "text",
      "id": "bullet_2",
      "label": "Bullet 2 Label",
      "default": "Wholesale Programs"
    },
    {
      "type": "text",
      "id": "bullet_3",
      "label": "Bullet 3 Label",
      "default": "Wholesale & Custom Blends"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Inquire for Bookings →"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Image and Quote"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote Text",
      "default": "Every cup we serve is an opportunity to create connection and care."
    },
    {
      "type": "text",
      "id": "quote_attr",
      "label": "Quote Attribution",
      "default": "WTP Coffee, Our Mission"
    }
  ],
  "presets": [
    {
      "name": "Catering Teaser"
    }
  ]
}
{% endschema %}
