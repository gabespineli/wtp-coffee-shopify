{%- style -%}
  /* ════════════════════════════════════════
     SECTION WRAPPER
  ════════════════════════════════════════ */
  #wtp-locations-{{ section.id }} {
    background: #F5F0E8;
    padding: 8rem 5% 0;
    overflow: hidden;
  }

  .loc-container {
    max-width: 1380px;
    margin: 0 auto;
  }

  /* ════════════════════════════════════════
     PART 1: HEADER ROW
  ════════════════════════════════════════ */
  .loc-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .loc-header-text {
    flex: 1;
  }

  .loc-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0 0 1rem;
  }

  .loc-heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    font-weight: 700;
    line-height: 1.08;
    color: #1B3A2D;
    margin: 0 0 1.25rem;
  }

  .loc-subtext {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #1B3A2D;
    opacity: 0.7;
    margin: 0;
    max-width: 520px;
  }

  .loc-header-action {
    flex-shrink: 0;
  }

  .loc-btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 2.2rem;
    border: 1.5px solid #1B3A2D;
    color: #1B3A2D;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 50px;
    background: transparent;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease;
    white-space: nowrap;
  }

  .loc-btn-outline:hover {
    background: #1B3A2D;
    color: #F5F0E8;
  }

  .loc-btn-outline svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: stroke 0.25s ease;
  }

  .loc-btn-outline:hover svg {
    stroke: #F5F0E8;
  }

  /* ════════════════════════════════════════
     MAP CONTAINER
  ════════════════════════════════════════ */
  .loc-map-wrap {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(27, 58, 45, 0.1);
    margin-bottom: 3rem;
    background: #d4cfc5;
  }

  .loc-map-wrap iframe {
    width: 100%;
    height: 480px;
    border: 0;
    display: block;
  }

  .loc-map-placeholder {
    width: 100%;
    height: 480px;
    background: linear-gradient(135deg, #ddd8ce 0%, #c8c3b8 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: #1B3A2D;
    opacity: 0.55;
  }

  .loc-map-placeholder svg {
    width: 52px;
    height: 52px;
  }

  .loc-map-placeholder p {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0;
  }

  /* ════════════════════════════════════════
     LOCATION CARDS GRID
  ════════════════════════════════════════ */
  .loc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-bottom: 6rem;
  }

  .loc-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(27, 58, 45, 0.07);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .loc-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 36px rgba(27, 58, 45, 0.13);
  }

  .loc-card-img-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    flex-shrink: 0;
  }

  .loc-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .loc-card:hover .loc-card-img {
    transform: scale(1.04);
  }

  .loc-card-img-placeholder {
    width: 100%;
    height: 100%;
    background: #ebe7de;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .loc-card-img-placeholder svg {
    width: 48px;
    height: 48px;
    opacity: 0.35;
  }

  .loc-card-body {
    padding: 1.75rem 2rem 2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0;
  }

  .loc-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    gap: 1rem;
  }

  .loc-card-title {
    font-family: var(--font-heading-family);
    font-size: 1.5rem;
    font-weight: 700;
    color: #1B3A2D;
    margin: 0;
    line-height: 1.15;
  }

  .loc-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #2a7a4b;
    background: #eaf6ee;
    padding: 0.3rem 0.8rem;
    border-radius: 50px;
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .loc-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2a7a4b;
    flex-shrink: 0;
    animation: loc-pulse 2s ease-in-out infinite;
  }

  @keyframes loc-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .loc-card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-bottom: 1.25rem;
  }

  .loc-meta-row {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.92rem;
    color: #1B3A2D;
    opacity: 0.7;
    line-height: 1.4;
  }

  .loc-meta-row svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    margin-top: 1px;
    stroke: #C8A96E;
  }

  .loc-amenities {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(27, 58, 45, 0.08);
    flex-wrap: wrap;
  }

  .loc-amenity {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #1B3A2D;
    opacity: 0.55;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .loc-amenity svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .loc-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1rem 2.2rem;
    background: #1B3A2D;
    color: #F5F0E8;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.2s ease;
    margin-top: auto;
    align-self: flex-start;
  }

  .loc-btn-primary:hover {
    background: #0f2218;
    transform: translateY(-2px);
  }

  .loc-btn-primary svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  /* ════════════════════════════════════════
     PART 2: CATERING TEASER BANNER
  ════════════════════════════════════════ */
  .loc-catering {
    background: #1B3A2D;
    margin: 0 -5%;
    padding: 7rem 10%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
  }

  .loc-catering-text {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .loc-cat-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0 0 1.25rem;
  }

  .loc-cat-heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    font-weight: 700;
    font-style: italic;
    line-height: 1.08;
    color: #fff;
    margin: 0 0 1.5rem;
  }

  .loc-cat-desc {
    font-size: 1.1rem;
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 2rem;
    max-width: 480px;
  }

  .loc-cat-bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .loc-cat-bullets li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
  }

  .loc-cat-bullets li::before {
    content: '';
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #C8A96E;
    flex-shrink: 0;
  }

  .loc-btn-white {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1rem 2.4rem;
    background: #fff;
    color: #1B3A2D;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.2s ease;
    align-self: flex-start;
  }

  .loc-btn-white:hover {
    background: #F5F0E8;
    transform: translateY(-2px);
  }

  /* ─── Catering Image Side ─── */
  .loc-catering-visual {
    position: relative;
  }

  .loc-cat-img-wrap {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.25);
  }

  .loc-cat-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .loc-cat-img-placeholder {
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .loc-cat-img-placeholder svg {
    width: 64px;
    height: 64px;
    opacity: 0.25;
  }

  .loc-cat-quote-card {
    position: absolute;
    bottom: -2rem;
    left: -2.5rem;
    background: #fff;
    border-radius: 14px;
    padding: 1.4rem 1.8rem;
    max-width: 280px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
  }

  .loc-cat-quote-text {
    font-family: var(--font-heading-family);
    font-size: 1.05rem;
    font-style: italic;
    line-height: 1.45;
    color: #1B3A2D;
    margin: 0 0 0.75rem;
  }

  .loc-cat-quote-author {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0;
  }

  /* ════════════════════════════════════════
     RESPONSIVE
  ════════════════════════════════════════ */
  @media screen and (max-width: 990px) {
    .loc-catering {
      grid-template-columns: 1fr;
      gap: 4rem;
      padding: 5rem 7%;
    }

    .loc-cat-quote-card {
      left: 0;
      bottom: -1.5rem;
      max-width: 240px;
    }

    .loc-catering-visual {
      padding-bottom: 2.5rem;
    }
  }

  @media screen and (max-width: 750px) {
    #wtp-locations-{{ section.id }} {
      padding: 5rem 5% 0;
    }

    .loc-header {
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: 3rem;
    }

    .loc-map-wrap iframe,
    .loc-map-placeholder {
      height: 320px;
    }

    .loc-grid {
      grid-template-columns: 1fr;
      margin-bottom: 4rem;
    }

    .loc-catering {
      margin: 0 -5%;
      padding: 5rem 5%;
      gap: 3rem;
    }

    .loc-cat-quote-card {
      position: static;
      margin-top: 1.5rem;
      max-width: 100%;
    }
  }
{%- endstyle -%}

<section id="wtp-locations-{{ section.id }}" aria-label="WTP Coffee Locations">
  <div class="loc-container">

    {%- comment -%} ── PART 1: HEADER ── {%- endcomment -%}
    <div class="loc-header">
      <div class="loc-header-text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="loc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="loc-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="loc-subtext">{{ section.settings.subtext | escape }}</p>
        {%- endif -%}
      </div>
      <div class="loc-header-action">
        <button class="loc-btn-outline" type="button" aria-label="Use your current location to find cafes">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#1B3A2D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          Use Current Location
        </button>
      </div>
    </div>

    {%- comment -%} ── MAP ── {%- endcomment -%}
    <div class="loc-map-wrap">
      {%- if section.settings.map_embed_url != blank -%}
        <iframe
          src="{{ section.settings.map_embed_url | escape }}"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="WTP Coffee Locations Map"
          aria-label="Google Map showing WTP Coffee locations">
        </iframe>
      {%- else -%}
        <div class="loc-map-placeholder" role="img" aria-label="Map placeholder">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
            <line x1="9" y1="3" x2="9" y2="18"/>
            <line x1="15" y1="6" x2="15" y2="21"/>
          </svg>
          <p>Add your Google Maps Embed URL in section settings</p>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ── LOCATION CARDS ── {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="loc-grid">
        {%- for block in section.blocks -%}
          <article class="loc-card" {{ block.shopify_attributes }}>
            <div class="loc-card-img-wrap">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: class: 'loc-card-img', loading: 'lazy', alt: block.settings.title }}
              {%- else -%}
                <div class="loc-card-img-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
              {%- endif -%}
            </div>
            <div class="loc-card-body">
              <div class="loc-card-top">
                {%- if block.settings.title != blank -%}
                  <h3 class="loc-card-title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                <span class="loc-status" aria-label="Currently open">
                  <span class="loc-status-dot" aria-hidden="true"></span>
                  Open Now
                </span>
              </div>
              <div class="loc-card-meta">
                {%- if block.settings.address != blank -%}
                  <span class="loc-meta-row">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#C8A96E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                    {{ block.settings.address | escape }}
                  </span>
                {%- endif -%}
                {%- if block.settings.hours != blank -%}
                  <span class="loc-meta-row">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#C8A96E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"/>
                      <polyline points="12 6 12 12 16 14"/>
                    </svg>
                    {{ block.settings.hours | escape }}
                  </span>
                {%- endif -%}
              </div>
              <div class="loc-amenities" aria-label="Available amenities">
                <span class="loc-amenity">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12.55a11 11 0 0 1 14.08 0"/>
                    <path d="M1.42 9a16 16 0 0 1 21.16 0"/>
                    <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
                    <line x1="12" y1="20" x2="12.01" y2="20"/>
                  </svg>
                  WiFi
                </span>
                <span class="loc-amenity">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="1" y="3" width="15" height="13"/>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                    <circle cx="5.5" cy="18.5" r="2.5"/>
                    <circle cx="18.5" cy="18.5" r="2.5"/>
                  </svg>
                  Parking
                </span>
                <span class="loc-amenity">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                    <line x1="7" y1="7" x2="7.01" y2="7"/>
                  </svg>
                  Dine-in
                </span>
              </div>
              {%- if block.settings.map_link != blank -%}
                <a
                  href="{{ block.settings.map_link }}"
                  class="loc-btn-primary"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Get directions to {{ block.settings.title | escape }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polygon points="3 11 22 2 13 21 11 13 3 11"/>
                  </svg>
                  Get Directions
                </a>
              {%- else -%}
                <button class="loc-btn-primary" type="button" disabled aria-label="No directions link available for {{ block.settings.title | escape }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polygon points="3 11 22 2 13 21 11 13 3 11"/>
                  </svg>
                  Get Directions
                </button>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>

  {%- comment -%} ── PART 2: CATERING TEASER ── {%- endcomment -%}
  <div class="loc-catering">
    <div class="loc-catering-text">
      {%- if section.settings.cat_eyebrow != blank -%}
        <p class="loc-cat-eyebrow">{{ section.settings.cat_eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.cat_heading != blank -%}
        <h2 class="loc-cat-heading">{{ section.settings.cat_heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.cat_desc != blank -%}
        <p class="loc-cat-desc">{{ section.settings.cat_desc | escape }}</p>
      {%- endif -%}
      <ul class="loc-cat-bullets" aria-label="Catering services offered">
        {%- if section.settings.bullet_1 != blank -%}
          <li>{{ section.settings.bullet_1 | escape }}</li>
        {%- endif -%}
        {%- if section.settings.bullet_2 != blank -%}
          <li>{{ section.settings.bullet_2 | escape }}</li>
        {%- endif -%}
      </ul>
      {%- if section.settings.cat_cta_label != blank -%}
        <a
          href="{{ section.settings.cat_cta_url | default: '#' }}"
          class="loc-btn-white"
          aria-label="{{ section.settings.cat_cta_label | escape }}">
          {{ section.settings.cat_cta_label | escape }}
        </a>
      {%- endif -%}
    </div>

    <div class="loc-catering-visual">
      <div class="loc-cat-img-wrap">
        {%- if section.settings.cat_image != blank -%}
          {{ section.settings.cat_image | image_url: width: 1000 | image_tag: class: 'loc-cat-img', loading: 'lazy', alt: section.settings.cat_heading }}
        {%- else -%}
          <div class="loc-cat-img-placeholder">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
        {%- endif -%}
      </div>
      <div class="loc-cat-quote-card" aria-label="Client testimonial">
        {%- if section.settings.quote_text != blank -%}
          <p class="loc-cat-quote-text">&ldquo;{{ section.settings.quote_text | escape }}&rdquo;</p>
        {%- endif -%}
        {%- if section.settings.quote_author != blank -%}
          <p class="loc-cat-quote-author">{{ section.settings.quote_author | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>

</section>

{% schema %}
{
  "name": "WTP Locations",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Find Us"
    },
    {
