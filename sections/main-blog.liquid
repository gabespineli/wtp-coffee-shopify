{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* ════════════════════════════════════════════════
     WTP Coffee — Editorial Blog Archive Override
  ════════════════════════════════════════════════ */

  /* ── Section Shell ── */
  #shopify-section-{{ section.id }} {
    background-color: #F5F0E8 !important;
  }

  .wtp-blog-archive {
    max-width: 1280px;
    margin: 0 auto;
  }

  /* ── Page Header ── */
  .wtp-blog__header {
    text-align: center;
    padding: 5rem 2rem 3.5rem;
  }

  .wtp-blog__eyebrow {
    font-family: var(--font-body-family);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #C8A96E;
    margin: 0 0 1rem;
    display: block;
  }

  .wtp-blog__title {
    font-family: var(--font-heading-family);
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-style: italic;
    line-height: 1.08;
    color: #1B3A2D;
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
  }

  .wtp-blog__subtitle {
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    line-height: 1.65;
    color: rgba(27, 58, 45, 0.6);
    max-width: 520px;
    margin: 0 auto;
  }

  /* ── Article Grid ── */
  .wtp-blog__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding: 0 1.5rem 6rem;
  }

  @media screen and (min-width: 750px) {
    .wtp-blog__grid {
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 3rem;
      padding: 0 2.5rem 8rem;
    }
  }

  @media screen and (min-width: 1200px) {
    .wtp-blog__grid {
      padding: 0 3rem 8rem;
    }
  }

  /* ── Article Card ── */
  .wtp-article-card {
    display: flex;
    flex-direction: column;
    background: transparent;
    border: none;
    box-shadow: none;
    text-decoration: none;
    color: inherit;
  }

  /* ── Image Wrapper ── */
  .wtp-article-card__img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5; /* This forces every box to be the exact same height */
    overflow: hidden;
    border-radius: 12px;
    margin-bottom: 1.4rem;
  }

  .wtp-article-card__img-wrap img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* This makes the image fill the box without stretching */
    display: block;
    transition: transform 0.5s ease;
  }

  .wtp-article-card:hover .wtp-article-card__img-wrap img {
    transform: scale(1.04);
  }

  /* Image overlay gradient */
  .wtp-article-card__img-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.3) 0%, transparent 55%);
    pointer-events: none;
    border-radius: 12px;
  }

  /* ── Tag Pill (overlaid) ── */
  .wtp-article-card__tag {
    position: absolute;
    top: 1.1rem;
    left: 1.1rem;
    z-index: 2;
    background: #C8A96E;
    color: #F5F0E8;
    font-family: var(--font-body-family);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.3rem 0.9rem;
    border-radius: 50px;
    white-space: nowrap;
  }

  /* ── Placeholder ── */
  .wtp-article-card__placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    background: rgba(27, 58, 45, 0.08);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wtp-article-card__placeholder svg {
    width: 48px;
    height: 48px;
    opacity: 0.25;
  }

  /* ── Text Content ── */
  .wtp-article-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .wtp-article-card__meta {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: rgba(27, 58, 45, 0.5);
    margin: 0;
  }

  .wtp-article-card__title {
    font-family: var(--font-heading-family);
    font-style: italic;
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    line-height: 1.2;
    color: #1B3A2D;
    margin: 0.2rem 0 0.1rem;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .wtp-article-card:hover .wtp-article-card__title {
    opacity: 0.75;
  }

  .wtp-article-card__excerpt {
    font-family: var(--font-body-family);
    font-size: 0.98rem;
    line-height: 1.65;
    color: rgba(27, 58, 45, 0.7);
    margin: 0 0 0.75rem;
  }

  .wtp-article-card__cta {
    font-family: var(--font-body-family);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #C8A96E;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    transition: gap 0.2s ease;
  }

  .wtp-article-card:hover .wtp-article-card__cta {
    gap: 0.7rem;
  }

  /* ── Paginator Override ── */
  .wtp-blog-archive .pagination {
    padding: 0 2rem 5rem;
    display: flex;
    justify-content: center;
  }

  /* ── Kill Dawn's default card chrome ── */
  .wtp-blog-archive .card,
  .wtp-blog-archive .card-wrapper,
  .wtp-blog-archive .article-card {
    background: none !important;
    border: none !important;
    box-shadow: none !important;
    border-radius: 0 !important;
  }
{%- endstyle -%}

{%- paginate blog.articles by 9 -%}
  <div class="wtp-blog-archive section-{{ section.id }}-padding">
    {%- comment -%} Page Header {%- endcomment -%}
    <header class="wtp-blog__header">
      <span class="wtp-blog__eyebrow">Archive</span>
      <h1 class="wtp-blog__title">{{ blog.title | escape }}</h1>
      <p class="wtp-blog__subtitle">Stories, cuppings, and community moments from We The People.</p>
    </header>

    {%- comment -%} Article Grid {%- endcomment -%}
    <div class="wtp-blog__grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="wtp-article-card" aria-label="{{ article.title | escape }}">
          {%- comment -%} Image {%- endcomment -%}
          <div class="wtp-article-card__img-wrap">
            {%- if article.image != blank -%}
              {{
                article.image
                | image_url: width: 700
                | image_tag:
                  loading: 'lazy',
                  widths: '350, 500, 700',
                  sizes: '(min-width: 750px) 33vw, 95vw',
                  alt: article.image.alt
                | default: article.title
              }}
            {%- else -%}
              <div class="wtp-article-card__placeholder">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}

            {%- assign first_tag = article.tags | first -%}
            {%- if first_tag != blank -%}
              <span class="wtp-article-card__tag">{{ first_tag | escape }}</span>
            {%- endif -%}
          </div>

          {%- comment -%} Text Content {%- endcomment -%}
          <div class="wtp-article-card__body">
            <p class="wtp-article-card__meta">
              <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                {{- article.published_at | time_tag: format: 'date' -}}
              </time>
            </p>

            <span class="wtp-article-card__title">{{ article.title | escape }}</span>

            {%- if article.excerpt_or_content != blank -%}
              <p class="wtp-article-card__excerpt">
                {{ article.excerpt_or_content | strip_html | truncatewords: 15 }}
              </p>
            {%- endif -%}

            <span class="wtp-article-card__cta">
              Read Story
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.main-blog.settings.layout.options__1.label"
        },
        {
          "value": "collage",
          "label": "t:sections.main-blog.settings.layout.options__2.label"
        }
      ],
      "default": "collage",
      "label": "t:sections.main-blog.settings.layout.label"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.main-blog.settings.show_image.label"
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-blog.settings.image_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.main-blog.settings.image_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.main-blog.settings.image_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.main-blog.settings.image_height.options__4.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.main-blog.settings.image_height.label"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.main-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.main-blog.settings.show_author.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
