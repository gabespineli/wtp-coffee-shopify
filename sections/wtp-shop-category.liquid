{%- style -%}
  #wtp-shop-category-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: 7rem 5%;
  }

  /* ── Header Row ── */
  .sc-header {
    max-width: 1380px;
    margin: 0 auto 3.5rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .sc-heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 700;
    line-height: 1.1;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .sc-explore-link {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    text-decoration: none;
    white-space: nowrap;
    opacity: 0.65;
    transition: opacity 0.2s ease;
    padding-bottom: 0.2rem;
    border-bottom: 1.5px solid currentColor;
    flex-shrink: 0;
  }

  .sc-explore-link:hover {
    opacity: 1;
  }

  /* ── Grid ── */
  .sc-grid {
    max-width: 1380px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  /* ── Card ── */
  .sc-card {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    background: {{ section.settings.card_bg_color }};
    min-height: 400px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.3s ease;
  }

  .sc-card:hover {
    box-shadow: 0 16px 48px rgba(0,0,0,0.1);
  }

  .sc-card:hover .sc-card-img img {
    transform: scale(1.04) translate(-8%, 8%);
  }

  /* ── Card Content (Top Left) ── */
  .sc-card-content {
    padding: 2.5rem 2.5rem 0;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sc-card-title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.8rem, 2.5vw, 2.4rem);
    font-weight: 700;
    line-height: 1.1;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .sc-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    text-decoration: none;
    transition: gap 0.25s ease;
  }

  .sc-card-link:hover {
    gap: 0.65rem;
  }

  .sc-card-link svg {
    width: 14px;
    height: 14px;
    transition: transform 0.25s ease;
  }

  .sc-card-link:hover svg {
    transform: translateX(3px);
  }

  /* ── Card Image (Bottom Right Bleed) ── */
  .sc-card-img {
    position: absolute;
    z-index: 1;
  }

  .sc-card-img img {
    width: 100%;
    display: block;
    object-fit: contain;
    transform: translate(-8%, 8%);
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
    filter: drop-shadow(0 20px 30px rgba(0,0,0,0.12));
  }

  .sc-card-img-placeholder {
    width: 100%;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.15;
    transform: translate(-8%, 8%);
  }

  .sc-card-img-placeholder svg {
    width: 100%;
    height: 100%;
  }

  /* ── Mobile ── */
  @media screen and (max-width: 900px) {
    .sc-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .sc-card {
      min-height: 300px;
    }
  }

  @media screen and (max-width: 600px) {
    #wtp-shop-category-{{ section.id }} {
      padding: 5rem 5%;
    }

    .sc-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
{%- endstyle -%}

<section id="wtp-shop-category-{{ section.id }}" aria-label="{{ section.settings.heading | escape }}">

  <div class="sc-header">
    {%- if section.settings.heading != blank -%}
      <h2 class="sc-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.explore_label != blank and section.settings.explore_url != blank -%}
      <a href="{{ section.settings.explore_url }}" class="sc-explore-link">
        {{ section.settings.explore_label | escape }}
      </a>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="sc-grid">
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        {%- assign card_title = block.settings.title | default: collection.title | default: "Category Title" -%}
        {%- assign card_url = collection.url | default: "#" -%}
        {%- assign card_image = block.settings.image | default: collection.featured_image -%}

        <div class="sc-card" {{ block.shopify_attributes }}>

          <div class="sc-card-content">
            <h3 class="sc-card-title">{{ card_title | escape }}</h3>
            {%- if collection != blank or card_url != "#" -%}
              <a href="{{ card_url }}" class="sc-card-link" tabindex="0" aria-label="View {{ card_title | escape }} collection">
                View Collection
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </a>
            {%- endif -%}
          </div>

          {%- capture img_style -%}width: {{ block.settings.image_size }}%; right: {{ block.settings.offset_right }}%; bottom: {{ block.settings.offset_bottom }}%;{%- endcapture -%}
          <div class="sc-card-img" style="{{ img_style }}">
            {%- if card_image != blank -%}
              {{
                card_image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800',
                  sizes: '(max-width: 900px) 55vw, 23vw',
                  alt: card_title
              }}
            {%- else -%}
              <div class="sc-card-img-placeholder">{{ 'product-2' | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

</section>

{% schema %}
{
  "name": "Shop by Category",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F5F0E8"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#EAE7E0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1B3A2D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Link Color",
      "default": "#C8A96E"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Shop By Category"
    },
    {
      "type": "text",
      "id": "explore_label",
      "label": "Explore All Label",
      "default": "Explore All"
    },
    {
      "type": "url",
      "id": "explore_url",
      "label": "Explore All URL"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title Override",
          "info": "Leave blank to use the collection's title."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image Override",
          "info": "Leave blank to use the collection's featured image. Use a transparent PNG for the best bleeding effect."
        },
        {
          "type": "range",
          "id": "image_size",
          "label": "Image Scale",
          "min": 40,
          "max": 150,
          "step": 5,
          "default": 80,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "offset_right",
          "label": "Horizontal Position (Right)",
          "min": -50,
          "max": 50,
          "step": 2,
          "default": -10,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "offset_bottom",
          "label": "Vertical Position (Bottom)",
          "min": -50,
          "max": 50,
          "step": 2,
          "default": -10,
          "unit": "%"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
