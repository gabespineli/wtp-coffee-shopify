{%- comment -%}
  WTP Coffee — Events Link Tree
  Instagram bio link page that surfaces upcoming events in a clean,
  mobile-first card layout. Uses the same metafield data as community-calendar.liquid.
{%- endcomment -%}

{%- liquid
  assign events_blog   = blogs[section.settings.events_blog]
  assign limit         = section.settings.events_limit | default: 6
  assign raw_events    = events_blog.articles
-%}

{%- comment -%} Build sorted upcoming events list (same logic as community-calendar.liquid) {%- endcomment -%}
{%- capture events_with_dates -%}
  {%- for a in raw_events -%}
    {%- assign a_date = a.metafields.custom.event_date.value -%}
    {%- if a_date != blank -%}
      {{ a_date | date: '%s' }}|{{ a.handle }},
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign sorted_events = events_with_dates | split: ',' | sort -%}

<style>
  /* ── Page Shell ── */
  .lt-page {
    background-color: {{ section.settings.bg_color }};
    min-height: 100vh;
    font-family: var(--font-body-family);
    padding-bottom: 5rem;
  }

  /* ── Profile Header ── */
  .lt-profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 3.5rem 1.5rem 2rem;
    text-align: center;
    gap: 1rem;
  }

  .lt-profile__logo-wrap {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: {{ section.settings.logo_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    flex-shrink: 0;
  }

  .lt-profile__logo-wrap img {
    width: 70%;
    height: 70%;
    object-fit: contain;
  }

  .lt-profile__handle {
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 700;
    color: {{ section.settings.text_color }};
    letter-spacing: 0.02em;
    margin: 0;
  }

  .lt-profile__bio {
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba({{ section.settings.text_color | color_extract: 'red' }}, {{ section.settings.text_color | color_extract: 'green' }}, {{ section.settings.text_color | color_extract: 'blue' }}, 0.65);
    max-width: 300px;
    margin: 0;
  }

  /* ── Section Label ── */
  .lt-section-label {
    text-align: center;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: {{ section.settings.accent_color }};
    padding: 0.5rem 1.5rem 1.5rem;
  }

  /* ── Event Card Grid ── */
  .lt-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
    padding: 0 1.1rem;
    max-width: 500px;
    margin: 0 auto;
  }

  @media screen and (min-width: 480px) {
    .lt-grid {
      padding: 0 1.5rem;
    }
  }

  /* ── Event Card ── */
  .lt-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: {{ section.settings.card_bg_color }};
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 2px 12px rgba(0,0,0,0.07);
  }

  /* Stretched link makes the whole card clickable via the title */
  .lt-card__title-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .lt-card__title-link {
    text-decoration: none;
    color: inherit;
  }

  .lt-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.13);
  }

  /* ── Card Image ── */
  .lt-card__img-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
  }

  .lt-card__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .lt-card:hover .lt-card__img-wrap img {
    transform: scale(1.04);
  }

  .lt-card__img-placeholder {
    width: 100%;
    height: 100%;
    background: {{ section.settings.accent_color }}22;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lt-card__img-placeholder svg {
    width: 40%;
    opacity: 0.25;
  }

  /* ── Date badge overlay ── */
  .lt-card__date-badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background: {{ section.settings.accent_color }};
    color: #fff;
    border-radius: 8px;
    padding: 0.3rem 0.55rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    z-index: 2;
  }

  .lt-card__date-day {
    font-family: var(--font-heading-family);
    font-size: 1.3rem;
    font-weight: 900;
    display: block;
  }

  .lt-card__date-mon {
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: block;
    margin-top: 0.1rem;
  }

  /* gradient overlay */
  .lt-card__img-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, transparent 60%);
    pointer-events: none;
  }

  /* ── Card body ── */
  .lt-card__body {
    padding: 0.75rem 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }

  .lt-card__tag {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin: 0;
  }

  .lt-card__title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.4rem, 5vw, 1.8rem);
    font-style: italic;
    line-height: 1.2;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .lt-card__location {
    font-size: 0.7rem;
    color: rgba({{ section.settings.text_color | color_extract: 'red' }}, {{ section.settings.text_color | color_extract: 'green' }}, {{ section.settings.text_color | color_extract: 'blue' }}, 0.55);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── RSVP pill ── */
  .lt-card__rsvp {
    position: relative;
    z-index: 2;
    display: inline-block;
    margin-top: 0.5rem;
    background: {{ section.settings.text_color }};
    color: {{ section.settings.card_bg_color }};
    border-radius: 50px;
    padding: 0.8rem 1.6rem;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .lt-card__rsvp:hover { opacity: 0.8; }

  .lt-card__rsvp.is-finished {
    background: rgba({{ section.settings.text_color | color_extract: 'red' }}, {{ section.settings.text_color | color_extract: 'green' }}, {{ section.settings.text_color | color_extract: 'blue' }}, 0.15);
    color: rgba({{ section.settings.text_color | color_extract: 'red' }}, {{ section.settings.text_color | color_extract: 'green' }}, {{ section.settings.text_color | color_extract: 'blue' }}, 0.5);
    cursor: not-allowed;
    pointer-events: none;
  }

  /* ── Empty state ── */
  .lt-empty {
    text-align: center;
    padding: 3rem 1.5rem;
    color: rgba({{ section.settings.text_color | color_extract: 'red' }}, {{ section.settings.text_color | color_extract: 'green' }}, {{ section.settings.text_color | color_extract: 'blue' }}, 0.5);
    font-size: 1rem;
  }

  /* ── CTA to website ── */
  .lt-cta-wrap {
    padding: 2.5rem 1.5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    max-width: 500px;
    margin: 0 auto;
  }

  .lt-cta-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba({{ section.settings.text_color | color_extract: 'red' }}, {{ section.settings.text_color | color_extract: 'green' }}, {{ section.settings.text_color | color_extract: 'blue' }}, 0.45);
  }

  .lt-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    padding: 1.2rem 2rem;
    border-radius: 50px;
    border: 1.5px solid {{ section.settings.text_color }};
    background: transparent;
    color: {{ section.settings.text_color }};
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .lt-cta-btn:hover {
    background: {{ section.settings.text_color }};
    color: {{ section.settings.bg_color }};
  }

  .lt-cta-btn svg {
    flex-shrink: 0;
  }
</style>

<div class="lt-page">

  {%- comment -%} ── Profile Header ── {%- endcomment -%}
  <div class="lt-profile">
    <div class="lt-profile__logo-wrap">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 200 | image_tag: loading: 'eager', alt: shop.name }}
      {%- else -%}
        <span style="font-family: var(--font-heading-family); font-weight: 700; font-size: 1.1rem; color: #1B3A2D;">{{ shop.name }}</span>
      {%- endif -%}
    </div>

    {%- if section.settings.handle_label != blank -%}
      <p class="lt-profile__handle">{{ section.settings.handle_label | escape }}</p>
    {%- endif -%}

    {%- if section.settings.bio != blank -%}
      <p class="lt-profile__bio">{{ section.settings.bio | escape }}</p>
    {%- endif -%}
  </div>

  {%- comment -%} ── Section Label ── {%- endcomment -%}
  <p class="lt-section-label">{{ section.settings.section_label | default: 'Upcoming Events' }}</p>

  {%- comment -%} ── Event Cards Grid ── {%- endcomment -%}
  {%- assign events_shown = 0 -%}
  {%- assign has_events   = false -%}
  {%- assign current_ts   = 'now' | date: '%s' | plus: 0 -%}

  {%- assign render_handles = "" -%}

  {%- comment -%} 1. Upcoming Events (Earliest first) {%- endcomment -%}
  {%- for event_string in sorted_events -%}
    {%- assign event_string_trimmed = event_string | strip -%}
    {%- if event_string_trimmed != blank -%}
      {%- assign event_timestamp = event_string_trimmed | split: '|' | first | plus: 0 -%}
      {%- if event_timestamp >= current_ts -%}
        {%- assign handle = event_string_trimmed | split: '|' | last | strip -%}
        {%- assign render_handles = render_handles | append: handle | append: "," -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} 2. Finished Events (Most recent first) {%- endcomment -%}
  {%- assign sorted_events_desc = sorted_events | reverse -%}
  {%- for event_string in sorted_events_desc -%}
    {%- assign event_string_trimmed = event_string | strip -%}
    {%- if event_string_trimmed != blank -%}
      {%- assign event_timestamp = event_string_trimmed | split: '|' | first | plus: 0 -%}
      {%- if event_timestamp < current_ts -%}
        {%- assign handle = event_string_trimmed | split: '|' | last | strip -%}
        {%- assign render_handles = render_handles | append: handle | append: "," -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- assign final_handles = render_handles | split: "," -%}

  <div class="lt-grid">
    {%- for handle in final_handles -%}
      {%- if handle == blank -%}{%- continue -%}{%- endif -%}
      {%- if events_shown >= limit -%}{%- break -%}{%- endif -%}

      {%- assign article = null -%}
      {%- for a in raw_events -%}
        {%- if a.handle == handle -%}
          {%- assign article = a -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if article == null -%}{%- continue -%}{%- endif -%}

      {%- assign event_date_raw  = article.metafields.custom.event_date.value -%}
      {%- assign event_timestamp = event_date_raw | date: '%s' | plus: 0 -%}
      {%- assign event_location  = article.metafields.custom.event_location -%}
      {%- assign rsvp_url        = article.metafields.custom.event_rsvp_url -%}
      {%- assign event_tag       = article.tags.first -%}
      {%- assign is_past         = false -%}
      {%- if event_timestamp < current_ts -%}{%- assign is_past = true -%}{%- endif -%}

      {%- assign events_shown = events_shown | plus: 1 -%}
      {%- assign has_events   = true -%}

      <div class="lt-card">
        <div class="lt-card__img-wrap">
          {%- if article.image != blank -%}
            {{ article.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: article.title }}
          {%- else -%}
            <div class="lt-card__img-placeholder">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
              </svg>
            </div>
          {%- endif -%}

          {%- if event_date_raw != blank -%}
            <div class="lt-card__date-badge" aria-label="{{ event_date_raw | date: '%B %-d' }}">
              <span class="lt-card__date-day">{{ event_date_raw | date: '%-d' }}</span>
              <span class="lt-card__date-mon">{{ event_date_raw | date: '%b' | upcase }}</span>
            </div>
          {%- endif -%}
        </div>

        <div class="lt-card__body">
          {%- if event_tag != blank -%}
            <p class="lt-card__tag">{{ event_tag | escape }}</p>
          {%- endif -%}

          <h2 class="lt-card__title">
            <a href="{{ article.url }}" class="lt-card__title-link">{{ article.title | escape }}</a>
          </h2>

          {%- if event_location != blank -%}
            <p class="lt-card__location">
              <svg viewBox="0 0 12 12" fill="currentColor" width="9" height="9" aria-hidden="true" style="margin-right:2px; opacity:0.5;"><path d="M6 0a4 4 0 0 0-4 4c0 3 4 8 4 8s4-5 4-8a4 4 0 0 0-4-4zm0 5.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/></svg>
              {{ event_location | escape }}
            </p>
          {%- endif -%}

          {%- if is_past -%}
            <span class="lt-card__rsvp is-finished">Finished</span>
          {%- elsif rsvp_url != blank -%}
            <a href="{{ rsvp_url }}" target="_blank" rel="noopener noreferrer" class="lt-card__rsvp" aria-label="Register for {{ article.title | escape }}">Register →</a>
          {%- else -%}
            <span class="lt-card__rsvp is-finished">Coming Soon</span>
          {%- endif -%}
        </div>

      </div>
    {%- endfor -%}
  </div>

  {%- unless has_events -%}
    <p class="lt-empty">No upcoming events right now. Check back soon!</p>
  {%- endunless -%}

  {%- comment -%} ── Explore More CTA ── {%- endcomment -%}
  <div class="lt-cta-wrap">
    <span class="lt-cta-label">Explore More</span>
    <a href="{{ section.settings.community_url | default: '/pages/community' }}" class="lt-cta-btn">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
        <circle cx="10" cy="10" r="8"/><path d="M10 2a14 14 0 0 1 0 16M2 10h16"/>
      </svg>
      Visit Our Community Page
    </a>
  </div>

</div>

{% schema %}
{
  "name": "Events Link Tree",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Page Background",
      "default": "#F5F0E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1B3A2D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Gold Color",
      "default": "#C8A96E"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "logo_bg_color",
      "label": "Logo Circle Background",
      "default": "#1B3A2D"
    },
    {
      "type": "header",
      "content": "Profile"
    },
    {
      "type": "text",
      "id": "handle_label",
      "label": "Handle / Username",
      "default": "@wtpcoffee"
    },
    {
      "type": "textarea",
      "id": "bio",
      "label": "Bio Tagline",
      "default": "Specialty coffee crafted with intention. Alabang & Bridgetowne."
    },
    {
      "type": "header",
      "content": "Events"
    },
    {
      "type": "text",
      "id": "section_label",
      "label": "Section Label",
      "default": "Upcoming Events"
    },
    {
      "type": "blog",
      "id": "events_blog",
      "label": "Events Blog"
    },
    {
      "type": "range",
      "id": "events_limit",
      "label": "Max Events to Show",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 6
    },
    {
      "type": "header",
      "content": "Bottom CTA"
    },
    {
      "type": "url",
      "id": "community_url",
      "label": "Community Page URL",
      "info": "Defaults to /pages/community if left blank"
    }
  ],
  "presets": [
    {
      "name": "Events Link Tree"
    }
  ]
}
{% endschema %}
