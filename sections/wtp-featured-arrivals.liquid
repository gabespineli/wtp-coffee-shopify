{%- style -%}
  #wtp-featured-arrivals-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: 8rem 5%;
  }

  /* ── Header ── */
  .fa-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .fa-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin: 0 0 1rem;
  }

  .fa-heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 5vw, 4rem);
    font-weight: 700;
    font-style: italic;
    line-height: 1.1;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  /* ── Grid ── */
  .fa-grid {
    max-width: 1380px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem 2.5rem;
  }

  /* ── Card ── */
  .fa-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    gap: 0;
  }

  .fa-card:hover .fa-img-inner img {
    transform: scale(1.06);
  }

  /* Image Wrapper */
  .fa-img-wrap {
    width: 100%;
    aspect-ratio: 3/4;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    margin-bottom: 1.75rem;
    background: rgba(0,0,0,0.05);
  }

  .fa-img-inner {
    width: 100%;
    height: 100%;
  }

  .fa-img-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1);
    transition: transform 0.65s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
  }

  .fa-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fa-img-placeholder svg {
    width: 60px;
    height: 60px;
    opacity: 0.2;
  }

  /* Card Text */
  .fa-card-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0 0.25rem;
  }

  .fa-card-vendor {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin: 0;
  }

  .fa-card-title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.4rem, 2vw, 1.75rem);
    font-weight: 600;
    line-height: 1.15;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .fa-card-price {
    font-size: 1rem;
    font-weight: 500;
    color: {{ section.settings.text_color }};
    opacity: 0.75;
    margin: 0.25rem 0 0;
  }

  /* Compare at price */
  .fa-card-price s {
    opacity: 0.5;
    margin-left: 0.5rem;
    font-size: 0.9rem;
  }

  /* ── Responsive ── */
  @media screen and (max-width: 900px) {
    .fa-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem 2rem;
    }
  }

  @media screen and (max-width: 600px) {
    #wtp-featured-arrivals-{{ section.id }} {
      padding: 5rem 5%;
    }

    .fa-header {
      margin-bottom: 3.5rem;
    }

    .fa-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
{%- endstyle -%}

<section id="wtp-featured-arrivals-{{ section.id }}" aria-label="{{ section.settings.heading | escape }}">

  <header class="fa-header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="fa-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="fa-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
  </header>

  {%- if section.blocks.size > 0 -%}
    <div class="fa-grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign product = all_products[block.settings.product] -%}

        {%- if product != blank -%}
          <a href="{{ product.url }}" class="fa-card" role="listitem" aria-label="{{ product.title | escape }}" {{ block.shopify_attributes }}>

            <div class="fa-img-wrap">
              <div class="fa-img-inner">
                {%- if product.featured_image != blank -%}
                  {{
                    product.featured_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800',
                      sizes: '(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw',
                      alt: product.featured_image.alt | default: product.title
                  }}
                {%- else -%}
                  <div class="fa-img-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
                {%- endif -%}
              </div>
            </div>

            <div class="fa-card-text">
              {%- if product.vendor != blank -%}
                <p class="fa-card-vendor">{{ product.vendor | escape }}</p>
              {%- endif -%}

              <h3 class="fa-card-title">{{ product.title | escape }}</h3>

              <p class="fa-card-price">
                {%- if product.compare_at_price > product.price -%}
                  {{ product.price | money }}
                  <s>{{ product.compare_at_price | money }}</s>
                {%- else -%}
                  {{ product.price | money }}
                {%- endif -%}
              </p>
            </div>

          </a>

        {%- else -%}
          {%- comment -%} Placeholder if no product selected yet {%- endcomment -%}
          <div class="fa-card" role="listitem" {{ block.shopify_attributes }}>
            <div class="fa-img-wrap">
              <div class="fa-img-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
            </div>
            <div class="fa-card-text">
              <p class="fa-card-vendor">WTP Coffee</p>
              <h3 class="fa-card-title">Select a product in the editor</h3>
              <p class="fa-card-price">—</p>
            </div>
          </div>
        {%- endif -%}

      {%- endfor -%}
    </div>
  {%- endif -%}

</section>

{% schema %}
{
  "name": "Featured Arrivals",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F0E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1B3A2D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Eyebrow Color",
      "default": "#C8A96E"
    },
    {
      "type": "header",
      "content": "Header Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "NEW IN STORE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Arrivals"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Arrivals",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}
