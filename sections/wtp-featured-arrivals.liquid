<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #wtp-featured-arrivals-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: 8rem 5%;
  }

  /* ── Header ── */
  .fa-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .fa-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin: 0 0 1rem;
  }

  .fa-heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 5vw, 4rem);
    font-weight: 700;
    font-style: italic;
    line-height: 1.1;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  /* ── Grid ── */
  .fa-grid {
    max-width: 1380px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem 2.5rem;
  }



  /* ── Responsive ── */
  @media screen and (max-width: 900px) {
    .fa-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem 2rem;
    }
  }

  @media screen and (max-width: 600px) {
    #wtp-featured-arrivals-{{ section.id }} {
      padding: 4rem 0 4rem 0;
      overflow: hidden;
    }

    .fa-header {
      margin-bottom: 2.5rem;
      padding: 0 1.25rem;
    }

    .fa-heading {
      font-size: clamp(2rem, 8vw, 2.8rem);
    }

    /* Convert grid to horizontal scroll track */
    .fa-grid {
      display: flex;
      flex-direction: row;
      gap: 1.25rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: 0.5rem 1.25rem 2rem;
      grid-template-columns: unset;
      cursor: grab;
    }

    .fa-grid::-webkit-scrollbar {
      display: none;
    }

    .fa-grid:active {
      cursor: grabbing;
    }

    /* Each card snaps into view */
    .fa-card-wrapper {
      flex: 0 0 72vw;
      max-width: 280px;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    /* Card image tall and rounded */
    #wtp-featured-arrivals-{{ section.id }} .card__media,
    #wtp-featured-arrivals-{{ section.id }} .card-wrapper .media {
      aspect-ratio: 3 / 4;
      border-radius: 16px;
      overflow: hidden;
    }

    #wtp-featured-arrivals-{{ section.id }} .card__information {
      padding: 0.85rem 0.25rem 0;
    }

    #wtp-featured-arrivals-{{ section.id }} .card__heading {
      font-size: 1.15rem;
    }
  }

  .fa-carousel-dots {
    display: none;
  }

  @media screen and (max-width: 600px) {
    .fa-carousel-dots {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 1rem;
      padding: 0 1.25rem;
    }

    .fa-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: rgba(27, 58, 45, 0.2);
      transition: background 0.3s ease, transform 0.3s ease;
    }

    .fa-dot--active {
      background: #1B3A2D;
      transform: scale(1.35);
    }
  }
{%- endstyle -%}

<section id="wtp-featured-arrivals-{{ section.id }}" aria-label="{{ section.settings.heading | escape }}">

  <header class="fa-header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="fa-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="fa-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
  </header>

  {%- if section.blocks.size > 0 -%}
    <div class="fa-grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign product = all_products[block.settings.product] -%}

        {%- if product != blank -%}
          <div class="fa-card-wrapper" role="listitem" {{ block.shopify_attributes }}>
            {% render 'product-card', product: product %}
          </div>

        {%- else -%}
          {%- comment -%} Placeholder if no product selected yet {%- endcomment -%}
          <div class="fa-card-wrapper" role="listitem" {{ block.shopify_attributes }} style="opacity: 0.6; text-align: center;">
            <div style="background:#EAE7E0; aspect-ratio:4/5; border-radius:8px; display:flex; align-items:center; justify-content:center;">
              {{ 'product-1' | placeholder_svg_tag: 'width:60px; height:60px; opacity:0.2;' }}
            </div>
            <p style="margin-top:1rem; font-weight:700;">Select a product</p>
          </div>
        {%- endif -%}

      {%- endfor -%}
    </div>

    <div class="fa-carousel-dots" id="fa-dots-{{ section.id }}">
      {%- for block in section.blocks -%}
        <span class="fa-dot{% if forloop.first %} fa-dot--active{% endif %}"></span>
      {%- endfor -%}
    </div>
  {%- endif -%}

</section>

<script>
  (function () {
    if (window.innerWidth > 600) return;

    var grid = document.querySelector(
      '#wtp-featured-arrivals-{{ section.id }} .fa-grid'
    );
    var dots = document.querySelectorAll(
      '#fa-dots-{{ section.id }} .fa-dot'
    );

    if (!grid || !dots.length) return;

    grid.addEventListener('scroll', function () {
      var cardWidth = grid.querySelector('.fa-card-wrapper')
        ? grid.querySelector('.fa-card-wrapper').offsetWidth + 20
        : grid.scrollWidth / dots.length;

      var index = Math.round(grid.scrollLeft / cardWidth);
      index = Math.max(0, Math.min(index, dots.length - 1));

      dots.forEach(function (dot, i) {
        dot.classList.toggle('fa-dot--active', i === index);
      });
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Featured Arrivals",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F0E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1B3A2D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Eyebrow Color",
      "default": "#C8A96E"
    },
    {
      "type": "header",
      "content": "Header Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "NEW IN STORE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Arrivals"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Arrivals",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}
