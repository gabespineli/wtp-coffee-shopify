{%- style -%}
  #wtp-ethos-{{ section.id }} {
    position: relative;
    background: {{ section.settings.bg_color }};
    padding: 10rem 5%;
    overflow: hidden;
    color: #ffffff;
  }

  /* Watermark Typography */
  .ethos-watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-heading-family);
    font-size: min(28vw, 450px);
    font-weight: 800;
    line-height: 1;
    color: #ffffff;
    opacity: 0.04;
    white-space: nowrap;
    pointer-events: none;
    z-index: 0;
  }

  .ethos-container {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    gap: 3rem;
    align-items: flex-start;
  }

  /* Glassmorphic Cards */
  .ethos-card {
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 3.5rem 3rem 2.5rem;
    flex: 1;
    max-width: 500px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.2);
  }

  /* Offset for visual overlap / adjacency */
  .ethos-card:nth-child(2) {
    margin-top: 5rem;
    background: rgba(255, 255, 255, 0.06);
  }

  .ethos-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }

  .ethos-icon img,
  .ethos-icon svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    color: var(--color-accent, #C8A96E);
    opacity: 0.9;
  }

  .ethos-heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .ethos-text {
    font-size: 1.15rem;
    line-height: 1.8;
    font-style: italic;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  .ethos-divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(to right, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0) 100%);
    margin-top: 1.5rem;
    border: none;
  }

  /* Responsive Stacking */
  @media screen and (max-width: 850px) {
    #wtp-ethos-{{ section.id }} {
      padding: 6rem 5%;
    }
    .ethos-container {
      flex-direction: column;
      align-items: center;
      gap: 2rem;
    }
    .ethos-card:nth-child(2) {
      margin-top: 0;
    }
    .ethos-watermark {
      font-size: min(40vw, 300px);
    }
  }
{%- endstyle -%}

<section id="wtp-ethos-{{ section.id }}">
  <div class="ethos-watermark" aria-hidden="true">{{ section.settings.watermark | escape }}</div>
  
  <div class="ethos-container">
    {%- comment -%} Vision Card {%- endcomment -%}
    <div class="ethos-card">
      <div class="ethos-icon">
        {%- if section.settings.vision_icon != blank -%}
          {{ section.settings.vision_icon | image_url: width: 100 | image_tag: loading: 'lazy' }}
        {%- else -%}
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.638 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        {%- endif -%}
      </div>
      <h2 class="ethos-heading">{{ section.settings.vision_heading | escape }}</h2>
      <p class="ethos-text">{{ section.settings.vision_text | escape }}</p>
      <hr class="ethos-divider">
    </div>

    {%- comment -%} Mission Card {%- endcomment -%}
    <div class="ethos-card">
      <div class="ethos-icon">
        {%- if section.settings.mission_icon != blank -%}
          {{ section.settings.mission_icon | image_url: width: 100 | image_tag: loading: 'lazy' }}
        {%- else -%}
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3v1.5M3 21v-6m0 0l2.77-.693a9 9 0 016.208.682l.108.054a9 9 0 006.086.71l3.114-.732a48.524 48.524 0 01-.005-10.499l-3.15.743a9 9 0 01-6.15-.726l-.108-.054a9 9 0 00-6.208-.682L3 4.5M3 15V4.5" />
          </svg>
        {%- endif -%}
      </div>
      <h2 class="ethos-heading">{{ section.settings.mission_heading | escape }}</h2>
      <p class="ethos-text">{{ section.settings.mission_text | escape }}</p>
      <hr class="ethos-divider">
    </div>
  </div>
</section>

{% schema %}
{
  "name": "WTP Ethos",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1B3A2D"
    },
    {
      "type": "text",
      "id": "watermark",
      "label": "Watermark Text",
      "default": "Ethos"
    },
    {
      "type": "header",
      "content": "Vision"
    },
    {
      "type": "image_picker",
      "id": "vision_icon",
      "label": "Vision Icon"
    },
    {
      "type": "text",
      "id": "vision_heading",
      "label": "Vision Heading",
      "default": "Our Vision"
    },
    {
      "type": "textarea",
      "id": "vision_text",
      "label": "Vision Text",
      "default": "To redefine the local coffee landscape by elevating the craft to an art form."
    },
    {
      "type": "header",
      "content": "Mission"
    },
    {
      "type": "image_picker",
      "id": "mission_icon",
      "label": "Mission Icon"
    },
    {
      "type": "text",
      "id": "mission_heading",
      "label": "Mission Heading",
      "default": "Our Mission"
    },
    {
      "type": "textarea",
      "id": "mission_text",
      "label": "Mission Text",
      "default": "Empowering local producers while delivering a meticulously curated cup to our community."
    }
  ],
  "presets": [
    {
      "name": "WTP Ethos"
    }
  ]
}
{% endschema %}
