{% comment %}
  WTP Collab Banner Section
  Cinematic full-width banner with centered content and background overlay.
{% endcomment %}

<style>
  #wtp-collab-banner-{{ section.id }} {
    padding: 6rem 5% 0;
    background: #ffffff;
    overflow: hidden;
  }

  .cb-inner {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cb-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    z-index: 0;
    filter: brightness(var(--bg-brightness, 0.5));
  }

  .cb-bg--placeholder {
    background: #e8e4dc;
  }

  .cb-bg--placeholder svg {
    width: 100%;
    height: 100%;
    opacity: 0.15;
  }

  .cb-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    text-align: center;
    padding: 2rem;
    max-width: 800px;
  }

  .cb-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
    margin: 0;
  }

  .cb-headline {
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 600;
    color: #fff;
    margin: 0;
    line-height: 1.1;
    text-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }

  .cb-cta {
    display: inline-block;
    padding: 0.9rem 2.5rem;
    border: 1.5px solid rgba(255,255,255,0.85);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.25s ease, color 0.25s ease;
    margin-top: 0.5rem;
  }

  .cb-cta:hover {
    background: #fff;
    color: #1B3A2D;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    #wtp-collab-banner-{{ section.id }} {
      padding: 4rem 5% 0;
    }

    .cb-inner {
      height: 320px;
      border-radius: 12px;
    }

    .cb-content {
      gap: 1rem;
      padding: 1.5rem;
    }

    .cb-headline {
      font-size: clamp(1.8rem, 4vw, 2.5rem);
    }

    .cb-cta {
      padding: 0.8rem 2rem;
      font-size: 0.75rem;
    }
  }
</style>

<section id="wtp-collab-banner-{{ section.id }}" aria-label="{{ section.settings.headline | escape }}" style="--bg-brightness: {{ 100 | minus: section.settings.image_darkness | divided_by: 100.0 }};">
  <div class="cb-inner">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag: loading: 'lazy', class: 'cb-bg', alt: section.settings.headline
      }}
    {%- else -%}
      <div class="cb-bg cb-bg--placeholder">
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      </div>
    {%- endif -%}

    <div class="cb-content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cb-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.headline != blank -%}
        <h2 class="cb-headline">{{ section.settings.headline | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="cb-cta">
          {{ section.settings.cta_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collab Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "image_darkness",
      "label": "Image Darkness",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Limited Collaboration"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "WTP x June Digan"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Label",
      "default": "Discover the Collection"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    }
  ],
  "presets": [
    {
      "name": "Collab Banner"
    }
  ]
}
{% endschema %}
