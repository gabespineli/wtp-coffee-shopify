{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* ════════════════════════════════════════
     WTP Auth Pages — Shared Design System
  ════════════════════════════════════════ */
  .wtp-auth {
    --auth-bg:       #F5F0E8;
    --auth-green:    #1B3A2D;
    --auth-gold:     #C8A96E;
    --auth-muted:    rgba(27, 58, 45, 0.5);
    --auth-border:   rgba(27, 58, 45, 0.25);
    --auth-border-focus: #1B3A2D;
    background: var(--auth-bg);
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 1.5rem;
    font-family: var(--font-body-family);
  }

  .wtp-auth__card {
    width: 100%;
    max-width: 500px;
  }

  /* ── Eyebrow ── */
  .wtp-auth__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--auth-gold);
    display: block;
    text-align: center;
    margin-bottom: 0.75rem;
  }

  /* ── Title ── */
  .wtp-auth__title {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    font-style: italic;
    font-weight: 700;
    line-height: 1.1;
    color: var(--auth-green);
    text-align: center;
    margin: 0 0 0.5rem;
  }

  /* ── Subtitle / recover subtext ── */
  .wtp-auth__subtitle {
    font-size: 0.95rem;
    color: var(--auth-muted);
    text-align: center;
    margin: 0 0 2.5rem;
    line-height: 1.6;
  }

  .wtp-auth__divider {
    width: 40px;
    height: 2px;
    background: var(--auth-gold);
    border: none;
    margin: 1rem auto 2.5rem;
  }

  /* ── Field ── */
  .wtp-auth__field {
    position: relative;
    margin-bottom: 1.75rem;
  }

  .wtp-auth__label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--auth-muted);
    margin-bottom: 0.5rem;
  }

  .wtp-auth__input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1.5px solid var(--auth-border);
    border-radius: 0;
    padding: 0.75rem 0;
    font-family: var(--font-body-family);
    font-size: 1.05rem;
    color: var(--auth-green);
    outline: none;
    transition: border-color 0.2s ease;
    -webkit-appearance: none;
  }

  .wtp-auth__input:focus {
    border-bottom-color: var(--auth-border-focus);
  }

  .wtp-auth__input::placeholder {
    color: rgba(27, 58, 45, 0.3);
  }

  /* ── Submit Button ── */
  .wtp-auth__submit {
    width: 100%;
    background: var(--auth-green);
    color: #F5F0E8;
    border: none;
    border-radius: 50px;
    padding: 1.1rem 2rem;
    font-family: var(--font-body-family);
    font-size: 0.88rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
    margin-top: 0.5rem;
  }

  .wtp-auth__submit:hover {
    background: #142e22;
    transform: translateY(-1px);
  }

  /* ── Ghost Button ── */
  .wtp-auth__ghost-btn {
    display: block;
    width: 100%;
    border: 1.5px solid var(--auth-green);
    background: transparent;
    color: var(--auth-green);
    border-radius: 50px;
    padding: 1rem 2rem;
    font-family: var(--font-body-family);
    font-size: 0.88rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    transition: background 0.2s ease;
    margin-top: 0.75rem;
  }

  .wtp-auth__ghost-btn:hover {
    background: rgba(27, 58, 45, 0.06);
  }

  /* ── Misc Links ── */
  .wtp-auth__link {
    display: block;
    text-align: center;
    font-size: 0.9rem;
    color: var(--auth-muted);
    text-decoration: none;
    margin-top: 1.25rem;
    transition: color 0.2s ease;
  }

  .wtp-auth__link:hover {
    color: var(--auth-green);
  }

  /* ── Error / Success messages ── */
  .wtp-auth__message {
    padding: 1rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .wtp-auth__message--error {
    background: rgba(200, 60, 60, 0.07);
    border-left: 3px solid #c83c3c;
    color: #7a1a1a;
  }

  .wtp-auth__message--success {
    background: rgba(27, 58, 45, 0.07);
    border-left: 3px solid #1B3A2D;
    color: var(--auth-green);
  }

  /* ── Separator ── */
  .wtp-auth__sep {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.5rem 0;
    color: var(--auth-muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .wtp-auth__sep::before,
  .wtp-auth__sep::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--auth-border);
  }

  /* ── Section toggle: show recover vs login ── */
  .wtp-auth .customer {
    background: transparent;
    border: none;
    padding: 0;
  }
{%- endstyle -%}

{%- if section.settings.enable_shop_login_button == false -%}
  {%- assign hide_shop_login_button = true -%}
{%- endif -%}

<div class="wtp-auth">
  <div class="wtp-auth__card">

    {%- comment -%} ── RECOVER PASSWORD SECTION ── {%- endcomment -%}
    <div id="recover" tabindex="-1">
      <span class="wtp-auth__eyebrow">WTP Coffee</span>
      <h1 class="wtp-auth__title">Reset Password</h1>
      <hr class="wtp-auth__divider" aria-hidden="true">
      <p class="wtp-auth__subtitle">{{ 'customer.recover_password.subtext' | t }}</p>

      {%- form 'recover_customer_password' -%}
        {%- assign recover_success = form.posted_successfully? -%}

        {%- if form.errors -%}
          <div class="wtp-auth__message wtp-auth__message--error" role="alert">
            {{ form.errors.messages.form }}
          </div>
        {%- endif -%}

        <div class="wtp-auth__field">
          <label class="wtp-auth__label" for="RecoverEmail">{{ 'customer.login_page.email' | t }}</label>
          <input
            type="email"
            value=""
            name="email"
            id="RecoverEmail"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            class="wtp-auth__input"
            {% if form.errors %}aria-invalid="true" aria-describedby="RecoverEmail-email-error" autofocus{% endif %}
            placeholder="{{ 'customer.login_page.email' | t }}"
          >
        </div>

        <button class="wtp-auth__submit">{{ 'customer.login_page.submit' | t }}</button>
        <a href="#login" class="wtp-auth__link">{{ 'customer.login_page.cancel' | t }}</a>
      {%- endform -%}
    </div>

    {%- comment -%} ── LOGIN SECTION ── {%- endcomment -%}
    <div id="login" tabindex="-1">
      <span class="wtp-auth__eyebrow">Welcome Back</span>
      <h1 class="wtp-auth__title">{{ 'customer.login_page.title' | t }}</h1>
      <hr class="wtp-auth__divider" aria-hidden="true">

      {%- if recover_success == true -%}
        <div class="wtp-auth__message wtp-auth__message--success" tabindex="-1" autofocus>
          {{ 'customer.recover_password.success' | t }}
        </div>
      {%- endif -%}

      {%- form 'customer_login', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <div class="wtp-auth__message wtp-auth__message--error" tabindex="-1" autofocus role="alert">
            {{ 'templates.contact.form.error_heading' | t }}
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        {%- if shop.features.login_with_shop_classic_customer_accounts? -%}
          <section name="sign-in-with-shop-provider">
            {{ shop | login_button: hide_button: hide_shop_login_button }}
            {%- unless hide_shop_login_button -%}
              <div class="wtp-auth__sep">{{ 'customer.login_page.alternate_provider_separator' | t }}</div>
            {%- endunless -%}
          </section>
        {%- endif -%}

        <div class="wtp-auth__field">
          <label class="wtp-auth__label" for="CustomerEmail">{{ 'customer.login_page.email' | t }}</label>
          <input
            type="email"
            name="customer[email]"
            id="CustomerEmail"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            class="wtp-auth__input"
            {% if form.errors contains 'form' %}aria-invalid="true"{% endif %}
            placeholder="{{ 'customer.login_page.email' | t }}"
          >
        </div>

        {%- if form.password_needed -%}
          <div class="wtp-auth__field">
            <label class="wtp-auth__label" for="CustomerPassword">{{ 'customer.login_page.password' | t }}</label>
            <input
              type="password"
              value=""
              name="customer[password]"
              id="CustomerPassword"
              autocomplete="current-password"
              class="wtp-auth__input"
              {% if form.errors contains 'form' %}aria-invalid="true"{% endif %}
              placeholder="{{ 'customer.login_page.password' | t }}"
            >
          </div>
          <a href="#recover" class="wtp-auth__link" style="text-align:right; margin-top:-1rem; margin-bottom:1.5rem;">{{ 'customer.login_page.forgot_password' | t }}</a>
        {%- endif -%}

        <button class="wtp-auth__submit">{{ 'customer.login_page.sign_in' | t }}</button>
        <a href="{{ routes.account_register_url }}" class="wtp-auth__ghost-btn">{{ 'customer.login_page.create_account' | t }}</a>
      {%- endform -%}
    </div>

    {%- if shop.checkout.guest_login -%}
      <div style="margin-top: 2rem;">
        <div class="wtp-auth__sep">or</div>
        <h2 style="text-align:center; font-size:1rem; color:var(--auth-muted); margin:0 0 1rem;">{{ 'customer.login_page.guest_title' | t }}</h2>
        {%- form 'guest_login' -%}
          <button class="wtp-auth__ghost-btn">{{ 'customer.login_page.guest_continue' | t }}</button>
        {%- endform -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-login.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_shop_login_button",
      "label": "t:sections.main-login.shop_login_button.enable",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
