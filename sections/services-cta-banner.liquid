{%- style -%}
  /* ═══════════════════════════════════════
     WTP — Services CTA Banner
  ═══════════════════════════════════════ */
  #wtp-services-cta-{{ section.id }} {
    background: #F5F0E8;
    padding: 8rem 5%;
    text-align: center;
  }

  .cta-banner-inner {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    transform: translateY(30px);
    transition: none;
  }

  .cta-banner-inner.is-visible {
    animation: ctaFadeUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes ctaFadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cta-heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: #1B3A2D;
    margin: 0 0 1.5rem;
  }

  .cta-subtitle {
    font-family: 'Poppins', sans-serif;
    font-size: 1.15rem;
    line-height: 1.7;
    color: rgba(27, 58, 45, 0.75);
    margin: 0 0 3rem;
    max-width: 600px;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.1rem 3rem;
    background: #1B3A2D;
    color: #F5F0E8;
    border-radius: 50px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1.5px solid #1B3A2D;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
  }

  .cta-button:hover {
    background: #C8A96E;
    color: #1B3A2D;
    border-color: #C8A96E;
    transform: scale(1.02);
  }

  /* ═══════════════════════════════════════
     Responsive — Mobile
  ═══════════════════════════════════════ */
  @media screen and (max-width: 600px) {
    #wtp-services-cta-{{ section.id }} {
      padding: 6rem 1.25rem;
    }

    .cta-button {
      width: 100%;
    }
  }
{%- endstyle -%}

<section id="wtp-services-cta-{{ section.id }}" aria-label="{{ section.settings.heading | escape }}">
  <div class="cta-banner-inner" data-cta-fade>
    
    {%- if section.settings.heading != blank -%}
      <h2 class="cta-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="cta-subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}

    {%- if section.settings.btn_label != blank -%}
      <a 
        href="{{ section.settings.btn_url }}" 
        class="cta-button"
        {% if section.settings.btn_url == blank %}aria-disabled="true"{% endif %}
      >
        {{ section.settings.btn_label | escape }}
      </a>
    {%- endif -%}

  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('wtp-services-cta-{{ section.id }}');
    if (!section) return;
    
    var fadeEl = section.querySelector('[data-cta-fade]');
    if (!fadeEl) return;

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      observer.observe(fadeEl);
    } else {
      fadeEl.classList.add('is-visible');
    }
  })();
</script>

{% schema %}
{
  "name": "Services CTA Banner",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Work With Us?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Whether it's an event, a wholesale partnership, or a custom blend — let's talk."
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Get in Touch →"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Services CTA Banner"
    }
  ]
}
{% endschema %}
