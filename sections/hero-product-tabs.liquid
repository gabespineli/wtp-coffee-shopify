{% comment %}
  Hero Product Tabs — WTP Coffee
  Full-viewport hero with crossfading background product images,
  vertical indexed tabs, and floating mini product card.
{% endcomment %}

{%- liquid
  assign bg = section.settings.bg_color | default: '#1B3A2D'
  assign pad = section.settings.section_padding | default: 80
-%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<style>
  /* ── Palette ── */
  .wtp-hero-tabs-wrapper-{{ section.id }} {
    --color-bg: {{ bg }};
    --color-cream: #F5F0E8;
    --color-cream-muted: rgba(245, 240, 232, 0.35);
    --color-accent: #C8A96E;
    --color-dark: #0F2318;
    --color-divider: rgba(245, 240, 232, 0.15);
    --color-card-bg: rgba(245, 240, 232, 0.08);
  }

  /* ── Section shell ── */
  .wtp-hero-tabs-wrapper-{{ section.id }} {
    position: relative;
    display: flex;
    background-color: var(--color-bg);
    justify-content: center;
    align-items: stretch;
    width: 95%;
    margin: 2rem auto;
    min-height: 85vh;
    padding: 0;
    box-sizing: border-box;
    overflow: hidden;
    border-radius: 24px;
    z-index: 1;
    isolation: isolate;
    transform: translateZ(0);
    will-change: transform;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  /* ── Stacked background images (one per block, crossfade) ── */
  /* The .wtp-ht__bgs wrapper fills the whole section on desktop */
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__bgs {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 0;
    will-change: opacity;
    transform: translateZ(0);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__bg.is-active {
    opacity: 1;
  }

  /* ── Dark overlay for legibility ── */
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 1;
  }

  /* ── Layout (sits above bg + overlay) ── */
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__layout {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: flex-end;
    width: 100%;
    min-height: 80vh;
  }

  /* ── Right column — tabs + card ── */
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__content {
    width: 45%;
    position: relative;
    z-index: 2;
    min-height: 80vh;
    padding: {{ pad }}px 4rem 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    box-sizing: border-box;
    /* seamless gradient overlay for readability */
    background: linear-gradient(90deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.3) 30%, rgba(0,0,0,0.6) 100%);
  }

  /* ── Tab container ── */
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tabs {
    display: flex;
    gap: 0;
    position: relative;
  }

  /* ── Tab list ── */
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tab-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-left: 2.5rem;
  }

  /* ── Individual tab item ── */
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tab {
    padding: 1.8rem 0;
    cursor: pointer;
    border-bottom: 1px solid var(--color-divider);
    transition: opacity 0.35s ease;
    user-select: none;
    position: relative;
  }

  /* ── Progression Line ── */
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tab::before {
    content: '';
    position: absolute;
    top: 0;
    left: -2.5rem;
    width: 2px;
    height: 100%;
    background: #ffffff;
    transform: scaleY(0);
    transform-origin: top;
    z-index: 2;
  }

  /* ── Static Base Line (Grey) ── */
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tab::after {
    content: '';
    position: absolute;
    top: 0;
    left: -2.5rem;
    width: 2px;
    height: 100%;
    background: rgba(255, 255, 255, 0.35);
    z-index: 1;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tab.is-active::before {
    animation: wtpTabProgress 5s linear forwards;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tabs.is-paused .wtp-ht__tab.is-active::before,
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tabs.is-offscreen .wtp-ht__tab.is-active::before {
    animation-play-state: paused;
  }

  @media screen and (min-width: 769px) {
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tabs:hover .wtp-ht__tab.is-active::before {
      animation-play-state: paused;
    }
  }

  @keyframes wtpTabProgress {
    0% { transform: scaleY(0); }
    100% { transform: scaleY(1); }
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tab:first-child {
    padding-top: 0;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tab:last-child {
    border-bottom: none;
  }

  /* ── Index label — explicit Poppins ── */
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__index {
    font-family: 'Poppins', sans-serif;
    font-size: 0.7rem;
    color: var(--color-cream-muted);
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    display: block;
  }

  /* ── Blend name — explicit Grava ── */
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__name {
    font-family: var(--font-heading-family);
    text-transform: uppercase;
    color: var(--color-cream);
    line-height: 1.15;
    margin: 0;
    transition: font-size 0.35s ease, opacity 0.35s ease;
    font-size: 2.8rem;
    opacity: 0.3;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tab.is-active .wtp-ht__name {
    font-size: 4rem;
    opacity: 1;
  }

  /* ── Descriptor — explicit Poppins ── */
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__desc {
    font-family: 'Poppins', sans-serif;
    font-size: 1.5rem;
    line-height: 1.65;
    color: var(--color-cream);
    margin: 0;
    max-width: 70ch;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease, margin-top 0.35s ease;
    margin-top: 0;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tab.is-active .wtp-ht__desc {
    max-height: 120px;
    margin-top: 0.75rem;
  }

  /* ── Mini product card ── */
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card {
    position: relative;
    bottom: unset;
    left: unset;
    margin-top: auto;
    margin-bottom: 3rem;
    background: var(--color-card-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(245, 240, 232, 0.12);
    border-radius: 20px;
    padding: 1.5rem 2rem;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
    width: 100%;
    max-width: 440px;
    overflow: hidden;
    z-index: 5;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-content {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    transition: opacity 0.3s ease, transform 0.3s ease;
    opacity: 1;
    transform: translateY(0);
  }

  /* Overlay that sweeps across */
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-overlay {
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    transform: scaleY(0);
    transform-origin: bottom;
    z-index: 10;
    transition: transform 0.4s cubic-bezier(0.77, 0, 0.175, 1);
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card.is-animating .wtp-ht__card-overlay {
    transform: scaleY(1);
    transform-origin: top;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card.is-animating .wtp-ht__card-content {
    opacity: 0;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-thumb {
    width: 120px;
    height: 120px;
    border-radius: 14px;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--color-dark);
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Card text — all explicit Poppins ── */
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-title {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--color-cream);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
    padding-bottom: 0.15rem;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-subtitle {
    font-family: 'Poppins', sans-serif;
    font-size: 1.1rem;
    color: var(--color-cream-muted);
    margin: 0;
    padding-bottom: 0.75rem;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-price {
    font-family: 'Poppins', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #fff;
    margin: 0;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-atc,
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-view {
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    border-radius: 50px;
    padding: 0.75rem 1.4rem;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.15s ease, color 0.25s ease, border-color 0.25s ease;
    white-space: nowrap;
    text-align: center;
    text-decoration: none;
    align-self: flex-start;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-atc {
    color: var(--color-dark);
    background: var(--color-accent);
    border: none;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-view {
    color: var(--color-cream);
    background: transparent;
    border: 1px solid var(--color-cream-muted);
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-atc:hover {
    background: var(--color-cream);
    transform: scale(1.03);
  }

  /* ── Per-tab product-form wrapper ── */
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tab-form {
    display: contents; /* transparent in layout — button is the real child */
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tab-form.is-hidden {
    display: none;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-view:hover {
    background: rgba(245, 240, 232, 0.1);
    color: #fff;
    border-color: rgba(245, 240, 232, 0.6);
    transform: scale(1.03);
  }

  /* ── Loading State ── */
  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-atc.loading {
    background: #F5F0E8 !important;
    border: 1.5px solid rgba(27, 58, 45, 0.2);
    cursor: wait;
    pointer-events: none;
    transform: none;
    opacity: 1;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-atc.loading > span {
    display: none;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-atc .loading__spinner {
    display: none;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-atc.loading .loading__spinner {
    display: flex;
    position: static;
    width: 20px;
    height: 20px;
  }

  .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-atc.loading .loading__spinner .path {
    stroke: var(--color-bg) !important;
  }

  /* ── Tablet (900px and below) — minor tweaks only ── */
  @media (max-width: 900px) {
    .wtp-hero-tabs-wrapper-{{ section.id }} {
      border-radius: 16px;
    }
  }

  /* ── Mobile (768px and below) — full vertical stack ── */
  @media (max-width: 768px) {
    /* Outer shell: switch to vertical stack on mobile */
    .wtp-hero-tabs-wrapper-{{ section.id }} {
      border-radius: 0;
      overflow: visible;
      width: 100%;
      margin: 0 auto;
      background-color: transparent !important;
      flex-direction: column;
      min-height: auto;
      align-items: stretch;
    }

    /* Layout layer sits below .wtp-ht__bgs; remove its min-height */
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__layout {
      flex-direction: column;
      min-height: auto;
      /* Layout only wraps the content panel; it's after the bgs block */
      position: relative;
      z-index: 2;
    }

    /* Overlay: on mobile scope it to just the image region */
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__overlay {
      position: absolute;
      inset: 0;
      /* Only overlay the square image block — clip to the bgs area */
      height: 100vw; /* same as the 1/1 square */
      max-height: 100vw;
      pointer-events: none;
    }

    /* ── Top block: bg image area — square on mobile ── */
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__bgs {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      flex-shrink: 0;
      overflow: hidden;
    }

    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__bg {
      position: absolute;
      inset: 0;
    }

    /* On mobile always center the image (mobile image is composed for this viewport) */
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__bg-img {
      object-position: center !important;
    }

    /* ── Bottom block: tabs panel ── */
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__content {
      position: relative;
      width: 100%;
      min-height: auto;
      padding: 0 1.25rem 2.5rem;
      background: transparent;
      justify-content: flex-start;
      box-sizing: border-box;
      transition: none;
      display: flex;
      flex-direction: column;
    }

    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tabs-panel {
      order: 2;
      position: relative;
      width: 100%;
      padding: 1.5rem 1.25rem;
      background: var(--mobile-content-bg, var(--color-bg));
      color: var(--mobile-content-text, var(--color-cream));
      transition: background 0.4s ease, color 0.4s ease;
      border-radius: 24px;
      display: flex;
      flex-direction: column;
      box-sizing: border-box;
    }

    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__name,
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__desc,
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-title {
      color: currentColor;
    }

    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__index,
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-subtitle {
      color: currentColor;
      opacity: 0.6;
    }

    /* Selection Lines on Mobile */
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tab::before {
      background: currentColor;
    }
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tab::after {
      background: currentColor;
      opacity: 0.2;
    }

    /* View More Button on Mobile */
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-view {
      color: currentColor;
      border-color: currentColor;
    }

    /* Tab items: reduce vertical padding */
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tab {
      padding: 0.85rem 0;
    }

    /* Index label */
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__index {
      font-size: 0.6rem;
      margin-bottom: 0.25rem;
    }

    /* Active tab name */
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tab.is-active .wtp-ht__name {
      font-size: 1.6rem;
    }

    /* Inactive tab names */
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__name {
      font-size: 1.1rem;
    }

    /* Description: cut font and cap to 3 lines */
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tab.is-active .wtp-ht__desc {
      font-size: 0.85rem;
      line-height: 1.5;
      max-height: 70px;
      max-width: none;
      margin-top: 0.5rem;
    }

    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__tab-list {
      min-height: 150px; /* Prevents the bottom card from jumping during transitions */
    }

    /* ── Mini product card: order first with overlay ── */
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card {
      order: 1;
      position: relative !important;
      margin-top: -3.5rem !important; /* Connected overlay feel */
      margin-bottom: 0;
      width: 100%;
      max-width: none;
      padding: 1.25rem 1.5rem;
      border-radius: 24px;
      background: #FFFFFF !important;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
      z-index: 10;
    }

    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-title,
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-price {
      color: #1B3A2D !important;
    }

    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-subtitle {
      color: rgba(27, 58, 45, 0.6) !important;
    }

    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-view {
      color: #1B3A2D !important;
      border-color: rgba(27, 58, 45, 0.2) !important;
    }

    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-price {
      font-size: 1.2rem;
    }

    /* Buttons: smaller and full-row wrap if needed */
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-actions {
      margin-top: 0.6rem;
      gap: 0.5rem;
    }

    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-atc,
    .wtp-hero-tabs-wrapper-{{ section.id }} .wtp-ht__card-view {
      font-size: 0.75rem;
      padding: 0.55rem 1rem;
    }
  }
</style>

<section id="wtp-hero-tabs-{{ section.id }}" class="wtp-hero-tabs-wrapper-{{ section.id }}">
  <!-- Stacked background images (one per block) -->
  <div class="wtp-ht__bgs">
    {%- for block in section.blocks -%}
      {%- assign bg_src = block.settings.bg_image -%}
      {%- if bg_src == blank and block.settings.product != blank -%}
        {%- assign bg_src = block.settings.product.featured_image -%}
      {%- endif -%}

      {%- if bg_src != blank -%}
        {%- assign mobile_bg_src = block.settings.bg_image_mobile -%}
        {%- assign desktop_img_url = bg_src | image_url: width: 2000 -%}
        {%- if mobile_bg_src != blank -%}
          {%- assign mobile_img_url = mobile_bg_src | image_url: width: 1200 -%}
        {%- else -%}
          {%- assign mobile_img_url = desktop_img_url -%}
        {%- endif -%}
        <div
          class="wtp-ht__bg{% if forloop.first %} is-active{% endif %}"
          data-tab-bg="{{ forloop.index0 }}"
          data-desktop-src="{{ desktop_img_url }}"
          data-mobile-src="{{ mobile_img_url }}"
        >
          {%- assign bg_pos_x = block.settings.bg_position_x | default: 50 | append: '%' -%}
          {%- assign bg_pos_y = block.settings.bg_position_y | default: 50 | append: '%' -%}
          {%- assign bg_scale = block.settings.bg_scale | default: 100 | divided_by: 100.0 -%}
          {%- assign bg_style = 'object-position: '
            | append: bg_pos_x
            | append: ' '
            | append: bg_pos_y
            | append: '; transform: scale('
            | append: bg_scale
            | append: ');'
          -%}
          {{ bg_src | image_url: width: 2000 | image_tag: class: 'wtp-ht__bg-img', style: bg_style }}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <!-- /.wtp-ht__bgs -->

  <!-- Dark overlay -->
  <div class="wtp-ht__overlay"></div>

  <!-- Layout container (aligned to the right) -->
  <div class="wtp-ht__layout">
    <!-- Right — Tabs + Card -->
    <div class="wtp-ht__content">
      <div class="wtp-ht__tabs-panel">
        <div class="wtp-ht__tabs" id="wtp-tab-container-{{ section.id }}">
        <div class="wtp-ht__tab-list">
          {%- for block in section.blocks -%}
            <div class="wtp-ht__tab{% if forloop.first %} is-active{% endif %}" data-tab-index="{{ forloop.index0 }}">
              <span class="wtp-ht__index">/{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <h3 class="wtp-ht__name">{{ block.settings.tab_name }}</h3>
              <p class="wtp-ht__desc">{{ block.settings.descriptor }}</p>
            </div>
          {%- endfor -%}
        </div>
        </div>
      </div>

      <!-- Mini product card -->
      <div class="wtp-ht__card" id="wtp-card-{{ section.id }}">
        <div class="wtp-ht__card-overlay"></div>
        <div class="wtp-ht__card-content">
          <div class="wtp-ht__card-thumb">
            <img
              id="wtp-card-img-{{ section.id }}"
              alt=""
              width="64"
              height="64"
            >
          </div>
          <div class="wtp-ht__card-body">
            <p class="wtp-ht__card-title" id="wtp-card-title-{{ section.id }}"></p>
            <p class="wtp-ht__card-subtitle" id="wtp-card-sub-{{ section.id }}"></p>
            <p class="wtp-ht__card-price" id="wtp-card-price-{{ section.id }}"></p>
            <div class="wtp-ht__card-actions">
              {%- for block in section.blocks -%}
                {%- assign bprod = block.settings.product -%}
                {%- if bprod != blank -%}
                  {%- liquid
                    assign bv = bprod.selected_or_first_available_variant
                    if block.settings.variant_title != blank
                      for bvar in bprod.variants
                        assign bvar_title_down = bvar.title | downcase
                        assign btarget_down = block.settings.variant_title | downcase
                        if bvar_title_down == btarget_down
                          assign bv = bvar
                          break
                        endif
                      endfor
                    endif
                  -%}
                  <product-form
                    class="wtp-ht__tab-form{% unless forloop.first %} is-hidden{% endunless %}"
                    data-tab-index="{{ forloop.index0 }}"
                    data-section-id="{{ section.id }}"
                  >
                    {%- form 'product', bprod, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                      <input type="hidden" name="id" value="{{ bv.id }}">
                      <button
                        type="submit"
                        name="add"
                        class="wtp-ht__card-atc"
                        {% unless bv.available %}disabled{% endunless %}
                      >
                        <span>{%- if bv.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}</span>
                        {%- render 'loading-spinner' -%}
                      </button>
                    {%- endform -%}
                  </product-form>
                {%- endif -%}
              {%- endfor -%}
              <a href="#" class="wtp-ht__card-view" id="wtp-card-view-{{ section.id }}">View More</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Data bridge — Liquid → JS -->
<script type="application/json" id="wtp-tabs-data-{{ section.id }}">
  [
    {%- for block in section.blocks -%}
      {%- assign prod = block.settings.product -%}
      {%- assign v = prod.selected_or_first_available_variant -%}
      {%- if block.settings.variant_title != blank -%}
        {%- for var in prod.variants -%}
          {%- assign var_title_down = var.title | downcase -%}
          {%- assign target_down = block.settings.variant_title | downcase -%}
          {%- if var_title_down == target_down -%}
            {%- assign v = var -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {
        "tabName": {{ block.settings.tab_name | json }},
        "descriptor": {{ block.settings.descriptor | json }},
        "cardTitle": {{ prod.title | default: '' | json }},
        "cardSubtitle": {{ block.settings.card_subtitle | default: '' | json }},
        "cardImage": "{% if v.featured_image %}{{ v.featured_image | image_url: width: 300 }}{% elsif prod.featured_image %}{{ prod.featured_image | image_url: width: 300 }}{% endif %}",
        "bgImage": "{% if block.settings.bg_image %}{{ block.settings.bg_image | image_url: width: 2000 }}{% endif %}",
        "bgImageMobile": "{% if block.settings.bg_image_mobile %}{{ block.settings.bg_image_mobile | image_url: width: 1200 }}{% elsif block.settings.bg_image %}{{ block.settings.bg_image | image_url: width: 1200 }}{% endif %}",
        "price": {{ v.price | default: 0 | money | json }},
        "variantId": {{ v.id | default: 0 | json }},
        "available": {{ v.available | json }},
        "productUrl": {{ v.url | default: prod.url | default: '#' | json }},
        "mobileContentBg": {{ block.settings.mobile_content_bg | default: '' | json }},
        "mobileContentText": {{ block.settings.mobile_content_text | default: '' | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>

<script>
  (function () {
    var SECTION_ID = {{ section.id | json }};

    document.addEventListener('DOMContentLoaded', function () {
      /* ── Data ── */
      var dataEl = document.getElementById('wtp-tabs-data-' + SECTION_ID);
      if (!dataEl) return;
      var products = [];
      try { products = JSON.parse(dataEl.textContent); } catch (e) { return; }
      if (!products.length) return;

      /* ── DOM refs ── */
      var sectionEl = document.getElementById('wtp-hero-tabs-' + SECTION_ID);
      var contentPanel = sectionEl.querySelector('.wtp-ht__tabs-panel') || sectionEl.querySelector('.wtp-ht__content');
      var container = document.getElementById('wtp-tab-container-' + SECTION_ID);
      var tabs      = sectionEl.querySelectorAll('.wtp-ht__tab');
      var bgs       = sectionEl.querySelectorAll('.wtp-ht__bg');

      /* ── Mobile bg src swap ── */
      var mobileBreak = window.matchMedia('(max-width: 768px)');

      function syncBgSrcs() {
        var isMobile = mobileBreak.matches;
        bgs.forEach(function (bg) {
          var img = bg.querySelector('.wtp-ht__bg-img');
          if (!img) return;

          /* Stash the original srcset once so we can restore it on desktop */
          if (!bg.hasAttribute('data-srcset-cache') && img.srcset) {
            bg.setAttribute('data-srcset-cache', img.srcset);
          }

          if (isMobile) {
            var mobileSrc = bg.getAttribute('data-mobile-src') || bg.getAttribute('data-desktop-src');
            if (mobileSrc) {
              /* Must clear srcset first — browsers prefer srcset over src */
              img.removeAttribute('srcset');
              img.src = mobileSrc;
            }
          } else {
            var desktopSrc = bg.getAttribute('data-desktop-src');
            if (desktopSrc) {
              img.src = desktopSrc;
              /* Restore srcset for responsive desktop delivery */
              var cachedSrcset = bg.getAttribute('data-srcset-cache');
              if (cachedSrcset) img.srcset = cachedSrcset;
            }
          }
        });
      }

      syncBgSrcs();
      if (mobileBreak.addEventListener) {
        mobileBreak.addEventListener('change', syncBgSrcs);
      } else {
        mobileBreak.addListener(syncBgSrcs); /* Safari <14 fallback */
      }
      var card      = document.getElementById('wtp-card-' + SECTION_ID);
      var cardImg   = document.getElementById('wtp-card-img-' + SECTION_ID);
      var cardTitle = document.getElementById('wtp-card-title-' + SECTION_ID);
      var cardSub   = document.getElementById('wtp-card-sub-' + SECTION_ID);
      var cardPrice = document.getElementById('wtp-card-price-' + SECTION_ID);
      var cardView  = document.getElementById('wtp-card-view-' + SECTION_ID);

      /* Show the product-form for the active tab, hide all others */
      function showTabForm(index) {
        card.querySelectorAll('.wtp-ht__tab-form').forEach(function (form) {
          form.classList.toggle('is-hidden', parseInt(form.getAttribute('data-tab-index'), 10) !== index);
        });
      }

      var activeIndex = 0;

      /* ── Activate tab ── */
      function activate(index) {
        if (index < 0 || index >= products.length) index = 0;
        activeIndex = index;
        var p = products[index];

        /* Mobile color updates */
        if (p.mobileContentBg) {
          contentPanel.style.setProperty('--mobile-content-bg', p.mobileContentBg);
        } else {
          contentPanel.style.removeProperty('--mobile-content-bg');
        }
        if (p.mobileContentText) {
          contentPanel.style.setProperty('--mobile-content-text', p.mobileContentText);
        } else {
          contentPanel.style.removeProperty('--mobile-content-text');
        }

        /* Tabs */
        tabs.forEach(function (tab, i) {
          if (i === index) {
            // If it's already active (e.g., clicking the same tab), force reflow safely
            if (tab.classList.contains('is-active')) {
              tab.classList.remove('is-active');
              void tab.offsetWidth;
              tab.classList.add('is-active');
            } else {
              tab.classList.add('is-active');
            }
          } else {
            tab.classList.remove('is-active');
          }
        });

        /* Background images */
        bgs.forEach(function (bg) {
          bg.classList.toggle('is-active', parseInt(bg.getAttribute('data-tab-bg'), 10) === index);
        });

        /* Card — overlay animation, swap content, slide overlay out */
        card.classList.add('is-animating');

        setTimeout(function () {
          /* Thumbnail */
          if (p.cardImage) {
            cardImg.src = p.cardImage;
            cardImg.alt = p.cardTitle || '';
          }

          /* Text fields */
          cardTitle.textContent = p.cardTitle || '';
          cardSub.textContent   = p.cardSubtitle || '';
          cardPrice.textContent = p.price || '';

          /* Show the form for this tab */
          showTabForm(index);

          cardView.href = p.productUrl || '#';

          /* Remove overlay */
          card.classList.remove('is-animating');
        }, 400);
      }

      /* ── Click handling ── */
      tabs.forEach(function (tab, i) {
        tab.addEventListener('click', function () {
          activate(i);
        });

        tab.addEventListener('animationend', function (e) {
          if (e.animationName === 'wtpTabProgress') {
            activate((activeIndex + 1) % products.length);
          }
        });
      });

      /* ── Card Hover Pause ── */
      card.addEventListener('mouseenter', function () { container.classList.add('is-paused'); });
      card.addEventListener('mouseleave', function () { container.classList.remove('is-paused'); });
      
      /* ── Visibility Pause — Pause animation when section is out of view ── */
      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              container.classList.remove('is-offscreen');
            } else {
              container.classList.add('is-offscreen');
            }
          });
        }, { threshold: 0.05 });
        observer.observe(sectionEl);
      }

      /* ── Add to Cart — Handled by <product-form> ── */

      /* ── Init — activate first tab immediately (no fade delay) ── */
      var p0 = products[0];
      if (p0.cardImage) {
        cardImg.src = p0.cardImage;
        cardImg.alt = p0.cardTitle || '';
      }
      cardTitle.textContent = p0.cardTitle || '';
      cardSub.textContent   = p0.cardSubtitle || '';
      cardPrice.textContent = p0.price || '';
      /* First form already visible (no is-hidden on forloop.first) */
      cardView.href = p0.productUrl || '#';

      bgs.forEach(function (bg) { bg.classList.toggle('is-active', parseInt(bg.getAttribute('data-tab-bg'), 10) === 0); });

      // Add is-active safely to start progress bar
      if (tabs[0]) {
        void tabs[0].offsetWidth;
        tabs[0].classList.add('is-active');
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Hero Product Tabs",
  "tag": "section",
  "class": "wtp-hero-product-tabs",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1B3A2D"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section Padding (px)",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "featured_product",
      "name": "Featured Product",
      "limit": 3,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "variant_title",
          "label": "Specific Variant Title",
          "info": "Optional. Enter the exact variant name (e.g., '1KG' or '250g'). Leaves blank to use the default variant."
        },
        {
          "type": "text",
          "id": "tab_name",
          "label": "Tab Heading (e.g. Community)"
        },
        {
          "type": "textarea",
          "id": "descriptor",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "card_subtitle",
          "label": "Card Subtitle (e.g. Whole Bean · 250g)"
        },
        {
          "type": "image_picker",
          "id": "bg_image",
          "label": "Background Image"
        },
        {
          "type": "range",
          "id": "bg_position_x",
          "label": "Background Focal Point (Horizontal)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "bg_position_y",
          "label": "Background Focal Point (Vertical)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "bg_scale",
          "label": "Background Image Zoom",
          "min": 50,
          "max": 200,
          "step": 2,
          "default": 100,
          "unit": "%"
        },
        {
          "type": "header",
          "content": "Mobile Background"
        },
        {
          "type": "image_picker",
          "id": "bg_image_mobile",
          "label": "Background Image (Mobile)",
          "info": "Square image recommended. Falls back to the desktop image if left blank."
        },
        {
          "type": "header",
          "content": "Mobile Colors"
        },
        {
          "type": "color",
          "id": "mobile_content_bg",
          "label": "Mobile Content Background"
        },
        {
          "type": "color",
          "id": "mobile_content_text",
          "label": "Mobile Content Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Product Tabs"
    }
  ]
}
{% endschema %}
