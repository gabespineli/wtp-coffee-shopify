{% comment %}
  WTP Coffee Custom Footer — Re-architected
  Reference: Socials top-left, outline newsletter input w/ arrow, nav columns right,
             policy center + payment icons bottom-right.
{% endcomment %}

{%- liquid
  assign footer_bg = section.settings.bg_color
-%}

<style>
  /* ════════════════════════════════════════
     WTP Footer — Variables & Shell
  ════════════════════════════════════════ */
  .wtp-footer {
    --footer-bg:      rgba({{ footer_bg.red }}, {{ footer_bg.green }}, {{ footer_bg.blue }}, 1);
    --footer-text:    #FFFFFF;
    --footer-text-muted: rgba(255, 255, 255, 0.6);
    --footer-accent:  #C8A96E;
    --footer-divider: rgba(255, 255, 255, 0.2);
    --footer-heading-font: var(--font-heading-family);
    --footer-body-font:    var(--font-body-family);

    background-color: var(--footer-bg);
    color: var(--footer-text);
    font-family: var(--footer-body-font);
    border-radius: 24px 24px 0 0;
    overflow: hidden;
    position: relative;
    box-sizing: border-box;
  }

  .wtp-footer *,
  .wtp-footer *::before,
  .wtp-footer *::after {
    box-sizing: border-box;
  }

  /* ════════════════════════════════════════
     MAIN BODY — Left + Nav Right
  ════════════════════════════════════════ */
  .wtp-footer__main {
    display: flex;
    align-items: flex-start;
    padding: 4.5rem 5%;
    gap: 4rem;
  }

  /* ── Left Column ── */
  .wtp-footer__left {
    flex: 0 0 340px;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* ── Social Icons (circular pill row) ── */
  .wtp-footer__socials {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .wtp-footer__social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: var(--footer-text);
    transition: background 0.2s ease;
    text-decoration: none;
    flex-shrink: 0;
  }

  .wtp-footer__social-btn:hover {
    background: rgba(255, 255, 255, 0.28);
  }

  .wtp-footer__social-btn svg {
    width: 18px;
    height: 18px;
    fill: #fff;
    display: block;
  }

  /* ── Newsletter Headline ── */
  .wtp-footer__nl-headline {
    font-family: var(--footer-body-font);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--footer-text);
    margin: 0;
    max-width: 28ch;
  }

  /* ── Newsletter Form — Outline Style ── */
  .wtp-footer__newsletter {
    width: 100%;
  }

  .wtp-footer__newsletter-form {
    width: 100%;
  }

  .wtp-footer__nl-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .wtp-footer__newsletter-input {
    width: 100%;
    background: transparent;
    border: 2px solid rgba(255, 255, 255, 0.6);
    border-radius: 50px;
    padding: 1.2rem 3.5rem 1.2rem 1.5rem;
    font-family: var(--footer-body-font);
    font-size: 1.15rem;
    color: var(--footer-text);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .wtp-footer__newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.45);
  }

  .wtp-footer__newsletter-input:focus {
    border-color: rgba(255, 255, 255, 0.85);
  }

  .wtp-footer__newsletter-btn {
    position: absolute;
    right: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--footer-text);
    display: flex;
    align-items: center;
    transition: transform 0.2s ease;
  }

  .wtp-footer__newsletter-btn:hover {
    transform: translateY(-50%) translateX(2px);
  }

  .wtp-footer__newsletter-btn svg {
    width: 22px;
    height: 22px;
    stroke: #fff;
}

  .wtp-footer__newsletter-success {
    font-size: 0.9rem;
    color: var(--footer-accent);
    margin-top: 0.6rem;
    font-weight: 600;
  }

  .wtp-footer__newsletter-error {
    font-size: 0.85rem;
    color: #fca5a5;
    margin-top: 0.5rem;
  }

  /* ── Brand Sign-off ── */
  .wtp-footer__brand-signoff {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .wtp-footer__brand-signoff-logo img {
    width: 44px;
    height: 44px;
    object-fit: contain;
    display: block;
    opacity: 0.85;
  }

  .wtp-footer__brand-signoff-text {
    font-family: var(--footer-body-font);
    font-size: 1rem;
    line-height: 1.4;
    color: var(--footer-text-muted);
  }

  .wtp-footer__brand-signoff-text strong {
    font-family: var(--footer-heading-font);
    font-size: 1.05rem;
    font-style: italic;
    color: var(--footer-text);
  }

  .wtp-footer__brand-signoff-text sup {
    font-size: 0.6em;
    vertical-align: super;
    line-height: 0;
  }

  /* ════════════════════════════════════════
     RIGHT — Nav Columns
  ════════════════════════════════════════ */
  .wtp-footer__nav-groups {
    flex: 1 1 auto;
    display: flex;
    justify-content: flex-end;
    gap: 3rem;
  }

  .wtp-footer__nav-group {
    display: flex;
    flex-direction: column;
    min-width: 120px;
  }

  .wtp-footer__heading {
    font-family: var(--footer-body-font);
    font-size: 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--footer-text);
    margin: 0 0 1.75rem;
  }

  .wtp-footer__menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .wtp-footer__link {
    font-size: 1.35rem;
    line-height: 1.6;
    color: var(--footer-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .wtp-footer__link:hover {
    color: var(--footer-text);
  }

  /* ── Contact Column ── */
  .wtp-footer__contact-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.75rem;
  }

  .wtp-footer__contact-group:last-child {
    margin-bottom: 0;
  }

  .wtp-footer__contact-label {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--footer-text-muted);
    margin-bottom: 0.1rem;
  }

  /* ════════════════════════════════════════
     BOTTOM BAR
  ════════════════════════════════════════ */
  .wtp-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 5%;
    border-top: 1px solid var(--footer-divider);
    gap: 2rem;
  }

  /* Copyright */
  .wtp-footer__copyright {
    font-size: 0.82rem;
    color: var(--footer-text-muted);
    margin: 0;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Policy Links — centered */
  .wtp-footer__policy {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .wtp-footer__policy-link {
    font-size: 0.82rem;
    color: var(--footer-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .wtp-footer__policy-link:hover {
    color: var(--footer-text);
  }

  .wtp-footer__policy-sep {
    font-size: 0.75rem;
    color: var(--footer-divider);
  }

  /* Payment Icons */
  .wtp-footer__payments {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: flex-end;
    flex-shrink: 0;
  }

  .wtp-footer__payments-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }

  .payment-icon {
    display: flex;
    align-items: center;
  }

  .payment-icon svg,
  .payment-icon img {
    height: 22px;
    width: auto;
    border-radius: 3px;
  }

  /* ════════════════════════════════════════
     MOBILE ( ≤ 768px )
  ════════════════════════════════════════ */
  @media (max-width: 768px) {
    .wtp-footer__main {
      flex-direction: column;
      padding: 3rem 1.5rem 2rem;
      gap: 3rem;
    }

    .wtp-footer__left {
      flex: 1 1 100%;
      width: 100%;
    }

    .wtp-footer__nl-headline {
      font-size: 1.1rem;
      max-width: 100%;
    }

    .wtp-footer__nav-groups {
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 2rem 3rem;
      width: 100%;
    }

    .wtp-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.5rem;
    }

    .wtp-footer__policy {
      justify-content: flex-start;
    }

    .wtp-footer__payments {
      justify-content: flex-start;
    }
  }
</style>

<footer class="wtp-footer">
  {%- comment -%} ── MAIN ── {%- endcomment -%}
  <div class="wtp-footer__main">
    {%- comment -%} LEFT COLUMN {%- endcomment -%}
    <div class="wtp-footer__left">
      {%- comment -%} Social icons — circular buttons {%- endcomment -%}
      <div class="wtp-footer__socials">
        {%- if section.settings.instagram_url != blank -%}
          <a
            href="{{ section.settings.instagram_url }}"
            class="wtp-footer__social-btn"
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
          >
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5a4.25 4.25 0 0 0 4.25-4.25v-8.5A4.25 4.25 0 0 0 16.25 3.5h-8.5zM12 7a5 5 0 1 1 0 10A5 5 0 0 1 12 7zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zm5.25-2.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5z"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.facebook_url != blank -%}
          <a
            href="{{ section.settings.facebook_url }}"
            class="wtp-footer__social-btn"
            target="_blank"
            rel="noopener"
            aria-label="Facebook"
          >
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M22 12.06c0-5.52-4.48-10-10-10S2 6.54 2 12.06c0 4.99 3.66 9.12 8.44 9.88v-6.99h-2.54V12.06h2.54V9.8c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.89h-2.34v6.99C18.34 21.18 22 17.05 22 12.06z"/>
            </svg>
          </a>
        {%- endif -%}
      </div>

      {%- comment -%} Newsletter Headline {%- endcomment -%}
      {%- if section.settings.newsletter_headline != blank -%}
        <h3 class="wtp-footer__nl-headline">{{ section.settings.newsletter_headline | escape }}</h3>
      {%- endif -%}

      {%- comment -%} Newsletter Form — Outline Input + Arrow Button {%- endcomment -%}
      <div class="wtp-footer__newsletter">
        {%- form 'customer', id: 'footer-newsletter-form', class: 'wtp-footer__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <p class="wtp-footer__newsletter-success">Thanks for subscribing!</p>
          {%- else -%}
            <div class="wtp-footer__nl-input-wrap">
              <input
                type="email"
                name="contact[email]"
                class="wtp-footer__newsletter-input"
                placeholder="{{ section.settings.newsletter_placeholder | escape }}"
                required
                aria-label="Email address"
              >
              <button type="submit" class="wtp-footer__newsletter-btn" aria-label="Subscribe">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </button>
            </div>
            {%- if form.errors -%}
              <p class="wtp-footer__newsletter-error">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>

      {%- comment -%} Brand Sign-off {%- endcomment -%}
      <div class="wtp-footer__brand-signoff">
        {%- if section.settings.logo != blank -%}
          <div class="wtp-footer__brand-signoff-logo">
            {{ section.settings.logo | image_url: width: 80 | image_tag: alt: 'WTP Coffee Logo' }}
          </div>
        {%- endif -%}
        <p class="wtp-footer__brand-signoff-text">
          Where Coffee Creates Community,<br>
          by <strong>WTP Coffee<sup>&reg;</sup></strong>
        </p>
      </div>
    </div>

    {%- comment -%} RIGHT — Nav Columns {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <nav class="wtp-footer__nav-groups" aria-label="Footer Navigation">
        {%- for block in section.blocks -%}
          <div class="wtp-footer__nav-group" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="wtp-footer__heading">{{ block.settings.heading }}</h2>
            {%- endif -%}

            {%- case block.type -%}
              {%- when 'nav_column' -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="wtp-footer__menu">
                    {%- for link in linklists[block.settings.menu].links -%}
                      <li>
                        <a href="{{ link.url }}" class="wtp-footer__link">{{ link.title }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'contact_column' -%}
                <div class="wtp-footer__contact-details">
                  {%- comment -%} Sales & Roastery {%- endcomment -%}
                  <div class="wtp-footer__contact-group">
                    <span class="wtp-footer__contact-label">Sales & Roastery</span>
                    {%- if block.settings.email_1 != blank -%}
                      <a href="mailto:{{ block.settings.email_1 }}" class="wtp-footer__link">
                        {{- block.settings.email_1 -}}
                      </a>
                    {%- endif -%}
                    {%- if block.settings.phone_1 != blank -%}
                      <a href="tel:{{ block.settings.phone_1 | replace: ' ', '' }}" class="wtp-footer__link">
                        {{- block.settings.phone_1 -}}
                      </a>
                    {%- endif -%}
                  </div>

                  {%- comment -%} Events {%- endcomment -%}
                  <div class="wtp-footer__contact-group">
                    <span class="wtp-footer__contact-label">Events</span>
                    {%- if block.settings.email_2 != blank -%}
                      <a href="mailto:{{ block.settings.email_2 }}" class="wtp-footer__link">
                        {{- block.settings.email_2 -}}
                      </a>
                    {%- endif -%}
                    {%- if block.settings.phone_2 != blank -%}
                      <a href="tel:{{ block.settings.phone_2 | replace: ' ', '' }}" class="wtp-footer__link">
                        {{- block.settings.phone_2 -}}
                      </a>
                    {%- endif -%}
                  </div>
                </div>
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>

  {%- comment -%} ── BOTTOM BAR ── {%- endcomment -%}
  <div class="wtp-footer__bottom">
    {%- comment -%} Copyright — Left {%- endcomment -%}
    <p class="wtp-footer__copyright">
      &copy; {{ section.settings.copyright_year }}
      {{ section.settings.copyright_brand }}. All rights reserved.
    </p>

    {%- comment -%} Policy Links — Center {%- endcomment -%}
    {%- if section.settings.policy_menu != blank -%}
      {%- assign policy_links = linklists[section.settings.policy_menu].links -%}
      {%- if policy_links.size > 0 -%}
        <nav class="wtp-footer__policy" aria-label="Policy Links">
          {%- for link in policy_links -%}
            <a href="{{ link.url }}" class="wtp-footer__policy-link">{{ link.title }}</a>
            {%- unless forloop.last -%}
              <span class="wtp-footer__policy-sep" aria-hidden="true">|</span>
            {%- endunless -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} Payment Icons — Right {%- endcomment -%}
    {%- if section.settings.show_payment_icons -%}
      <div class="wtp-footer__payments">
        <ul class="wtp-footer__payments-list" aria-label="Accepted payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li class="payment-icon">
              {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "WTP Footer",
  "settings": [
    {
      "type": "header",
      "content": "Visual"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Footer Background Color",
      "default": "#1B3A2D"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "textarea",
      "id": "newsletter_headline",
      "label": "Newsletter Headline",
      "default": "Let's stay in the loop—we'll keep you updated on any new drops."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Newsletter Input Placeholder",
      "default": "youremail@gmail.com"
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
      "type": "text",
      "id": "copyright_brand",
      "label": "Brand Name for Copyright",
      "default": "WTP Coffee"
    },
    {
      "type": "text",
      "id": "copyright_year",
      "label": "Copyright Year",
      "default": "2026"
    },
    {
      "type": "link_list",
      "id": "policy_menu",
      "label": "Policy Menu (e.g. Privacy, Terms of Service)"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "nav_column",
      "name": "Navigation Column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Navigation Menu"
        }
      ]
    },
    {
      "type": "contact_column",
      "name": "Contact Column",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Heading",
          "default": "Contact Us"
        },
        {
          "type": "header",
          "content": "Sales & Roastery"
        },
        {
          "type": "text",
          "id": "email_1",
          "label": "Sales Email",
          "default": "sales@wtpcoffee.com"
        },
        {
          "type": "text",
          "id": "phone_1",
          "label": "Sales Phone",
          "default": "(+63)976 362 5973"
        },
        {
          "type": "header",
          "content": "Events"
        },
        {
          "type": "text",
          "id": "email_2",
          "label": "Events Email",
          "default": "kirsten@wtpcoffee.com"
        },
        {
          "type": "text",
          "id": "phone_2",
          "label": "Events Phone",
          "default": "(+63)962 336 0361"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WTP Footer"
    }
  ]
}
{% endschema %}
