{% comment %}
  WTP Product Marquee Section
  Two-column layout: Left text block, Right draggable marquee track.
  Cards rendered via `product-card` snippet (same as Featured Arrivals).
  Supports: mouse drag, touch drag, auto-scroll, infinite loop.
{% endcomment %}

<style>
  #wtp-product-marquee-{{ section.id }} {
    background: var(--color-background, #F5F0E8);
    padding: 8rem 0 8rem 5%;
    overflow: hidden;
  }

  .pm-layout {
    display: flex;
    gap: 4rem;
    align-items: center;
  }

  /* ── LEFT ── */
  .pm-left {
    flex: 0 0 360px;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-right: 2rem;
    z-index: 2;
  }

  .pm-eyebrow {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0;
  }

  .pm-headline {
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 5vw, 4rem);
    font-weight: 700;
    font-style: italic;
    color: #1B3A2D;
    margin: 0;
    line-height: 1.1;
  }

  .pm-description {
    font-size: 1.2rem;
    line-height: 1.85;
    color: rgba(27,58,45,0.6);
    margin: 0;
  }

  .pm-cta {
    display: inline-block;
    padding: 1rem 2.2rem;
    background: #1B3A2D;
    color: #fff;
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.2s ease;
    margin-top: 0.5rem;
    align-self: flex-start;
  }

  .pm-cta:hover { opacity: 0.85; }

  /* ── RIGHT: Draggable Marquee ── */
  .pm-right {
    flex: 1 1 auto;
    overflow: hidden;
    /* Fade edges for a cinematic bleed */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
  }

  .pm-track-wrapper {
    overflow-x: scroll;
    overflow-y: hidden;
    width: 100%;
    cursor: grab;
    /* Hide scrollbar cross-browser */
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }

  .pm-track-wrapper::-webkit-scrollbar {
    display: none;
  }

  .pm-track-wrapper.is-dragging {
    cursor: grabbing;
  }

  /* Prevent TEXT selection while dragging — but keep pointer events on children so click-threshold logic works */
  .pm-track-wrapper.is-dragging {
    user-select: none;
    -webkit-user-select: none;
  }
  .pm-track-wrapper.is-dragging * {
    user-select: none;
    -webkit-user-select: none;
  }

  .pm-track {
    display: flex;
    gap: 2.5rem;
    width: max-content;
    align-items: flex-start;
    padding: 0.5rem 0 1rem; /* Breathing room so card shadows aren't clipped */
  }

  /* Subtle drag hint indicator */
  .pm-drag-hint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(27,58,45,0.35);
    transition: opacity 0.4s ease;
  }

  .pm-drag-hint svg {
    flex-shrink: 0;
  }

  /* Hide hint once user has interacted */
  .pm-drag-hint.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  /* Fixed-width wrapper so product-card fills the marquee item */
  .pm-marquee-item {
    flex-shrink: 0;
    width: 280px;
    transition: transform 0.2s ease;
  }

  /* ── PROGRESS BAR ── */
  .pm-progress-container {
    margin-top: 2rem;
    width: 100%;
    max-width: 400px;
    height: 3px;
    background: rgba(27, 58, 45, 0.18);
    position: relative;
    border-radius: 3px;
    overflow: hidden;
  }

  .pm-progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: #C8A96E;
    width: 0%;
    border-radius: 3px;
    transition: width 0.12s linear;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    #wtp-product-marquee-{{ section.id }} {
      padding: 5rem 0 4rem;
    }

    .pm-layout {
      flex-direction: column;
      gap: 3rem;
    }

    .pm-left {
      flex: 1 1 100%;
      width: 100%;
      padding: 0 1.25rem;
      text-align: center;
      align-items: center;
    }

    .pm-cta {
      align-self: center;
    }

    .pm-drag-hint {
      justify-content: center;
    }

    .pm-right {
      width: 100%;
      /* Full bleed on mobile */
      -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
      mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    }

    .pm-marquee-item { width: 220px; }
  }
</style>

<section id="wtp-product-marquee-{{ section.id }}" aria-label="{{ section.settings.headline | escape }}">
  <div class="pm-layout">
    <!-- LEFT -->
    <div class="pm-left">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pm-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="pm-headline">{{ section.settings.headline | escape }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="pm-description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="pm-cta">
          {{- section.settings.cta_label | escape -}}
        </a>
      {%- endif -%}

      <!-- Drag hint -->
      <p class="pm-drag-hint" id="pm-drag-hint-{{ section.id }}" aria-hidden="true">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14M9 8l-4 4 4 4M19 8l-4 4 4 4"/>
        </svg>
        Drag to explore
      </p>

      <!-- Progress Track -->
      <div class="pm-progress-container">
        <div class="pm-progress-bar" id="pm-progress-{{ section.id }}"></div>
      </div>
    </div>

    <!-- RIGHT: Draggable Marquee -->
    <div class="pm-right">
      {%- assign pm_collection = collections[section.settings.products_collection] -%}
      {%- assign pm_products = pm_collection.products -%}

      {%- if pm_products.size > 0 -%}
        <div class="pm-track-wrapper" id="pm-wrapper-{{ section.id }}">
          <div class="pm-track" id="pm-track-{{ section.id }}">
            {%- for product in pm_products -%}
              <div class="pm-marquee-item">
                {%- render 'product-card', product: product -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

      {%- else -%}
        <div class="pm-track-wrapper" id="pm-wrapper-{{ section.id }}">
          <div class="pm-track" id="pm-track-{{ section.id }}">
            {%- for i in (1..6) -%}
              <div class="pm-marquee-item">
                <div style="background:#EAE7E0; aspect-ratio:4/5; border-radius:8px; display:flex; align-items:center; justify-content:center; opacity:0.4;">
                  {{ 'product-1' | placeholder_svg_tag: 'width:60px; height:60px;' }}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .pm-track {
    will-change: transform;
    transition: transform 0.1s linear;
  }

  .pm-track.is-rewinding {
    transition: transform 1.2s cubic-bezier(0.65, 0, 0.35, 1);
  }
</style>

<script>
  (function () {
    function initMarquee(sectionId) {
      var wrapper  = document.getElementById('pm-wrapper-' + sectionId);
      var track    = document.getElementById('pm-track-' + sectionId);
      var progress = document.getElementById('pm-progress-' + sectionId);
      var hint     = document.getElementById('pm-drag-hint-' + sectionId);
      if (!wrapper || !track) return;

      /* ── State ── */
      var isDragging   = false;
      var isPaused     = false;
      var moveX        = 0;  /* target translateX */
      var lastX        = 0;
      var dragDistance = 0;
      var maxTranslate = 0;
      var direction    = 1;  /* 1 for forward, -1 for backward? no, we use state machine */
      var mode         = 'FORWARD'; /* FORWARD, PAUSE, REWIND */
      var pauseTimer   = null;

      function updateMaxTranslate() {
        var wBox = wrapper.offsetWidth;
        var tBox = track.scrollWidth;
        maxTranslate = Math.max(0, tBox - wBox);
      }

      function updateProgressBar() {
        if (!progress || maxTranslate <= 0) return;
        var perc = (moveX / maxTranslate) * 100;
        progress.style.width = Math.min(100, Math.max(0, perc)) + '%';
      }

      function hideHint() {
        if (hint) hint.classList.add('is-hidden');
      }

      /* ── Main Loop ── */
      var speed = (100 / ({{ section.settings.speed | default: 30 }} || 30)); /* px per frame approx? no, let's use constant increment */
      
      function loop() {
        if (isDragging || isPaused) {
          requestAnimationFrame(loop);
          return;
        }

        if (mode === 'FORWARD') {
          track.classList.remove('is-rewinding');
          moveX += 0.8; /* Slow crawl */
          if (moveX >= maxTranslate) {
            moveX = maxTranslate;
            mode = 'PAUSE';
            pauseTimer = setTimeout(function() {
              mode = 'REWIND';
              track.classList.add('is-rewinding');
            }, 3000);
          }
        } 
        else if (mode === 'REWIND') {
          moveX = 0; /* Cubic-bezier css handle the smoothing */
          track.style.transform = 'translateX(0)';
          updateProgressBar();
          
          /* Wait for transition to finish before going forward again */
          setTimeout(function() {
            if (mode === 'REWIND') mode = 'FORWARD';
          }, 1500); 
        }

        if (mode !== 'REWIND') {
          track.style.transform = 'translateX(' + (-moveX) + 'px)';
          updateProgressBar();
        }

        requestAnimationFrame(loop);
      }

      /* ── Drag Handling ── */
      function startDrag(x) {
        isDragging = true;
        lastX = x;
        dragDistance = 0;
        wrapper.classList.add('is-dragging');
        track.classList.remove('is-rewinding');
        if (pauseTimer) clearTimeout(pauseTimer);
        hideHint();
      }

      function moveDrag(x) {
        if (!isDragging) return;
        var delta = x - lastX;
        lastX = x;
        dragDistance += Math.abs(delta);
        moveX -= delta;
        
        /* Clamp drag */
        if (moveX < 0) moveX = 0;
        if (moveX > maxTranslate) moveX = maxTranslate;

        track.style.transform = 'translateX(' + (-moveX) + 'px)';
        updateProgressBar();
      }

      function endDrag() {
        if (!isDragging) return;
        isDragging = false;
        wrapper.classList.remove('is-dragging');
        /* Resume loop from current moveX */
        mode = 'FORWARD';
        /* Reset dragDistance AFTER a short delay so the click event
           that fires on mouseup still sees the correct distance,
           but the NEXT click starts fresh */
        setTimeout(function() { dragDistance = 0; }, 50);
      }

      /* Mouse */
      wrapper.addEventListener('mousedown', function(e) { startDrag(e.clientX); e.preventDefault(); });
      window.addEventListener('mousemove', function(e) { moveDrag(e.clientX); });
      window.addEventListener('mouseup', function() { endDrag(); });

      /* Touch */
      wrapper.addEventListener('touchstart', function(e) { startDrag(e.touches[0].clientX); }, {passive:true});
      wrapper.addEventListener('touchmove', function(e) { moveDrag(e.touches[0].clientX); }, {passive:true});
      wrapper.addEventListener('touchend', function() { endDrag(); }, {passive:true});

      /* Click / Nav link bug fix */
      wrapper.addEventListener('click', function(e) {
        if (dragDistance > 10) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);

      /* Hover pause */
      wrapper.addEventListener('mouseenter', function() { isPaused = true; });
      wrapper.addEventListener('mouseleave', function() { isPaused = false; });

      /* Init */
      updateMaxTranslate();
      window.addEventListener('resize', updateMaxTranslate);
      requestAnimationFrame(loop);
    }

    /* Run after DOM is ready */
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        initMarquee({{ section.id | json }});
      });
    } else {
      initMarquee({{ section.id | json }});
    }

    /* Theme Editor re-init */
    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId == {{ section.id | json }}) {
        initMarquee({{ section.id | json }});
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Product Marquee",
  "settings": [
    {
      "type": "collection",
      "id": "products_collection",
      "label": "Products Collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Collection"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Crafted for the Ritual"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every piece designed to elevate your daily pour. Ceramics and merch made for the community."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Auto-scroll Speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 30,
      "unit": "s",
      "info": "Duration in seconds for one full loop. Lower = faster."
    }
  ],
  "presets": [
    {
      "name": "Product Marquee"
    }
  ]
}
{% endschema %}
