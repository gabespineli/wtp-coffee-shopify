{% comment %}
  WTP Product Marquee Section
  Two-column layout: Left text block, Right CSS-only marquee tracks.
{% endcomment %}

<style>
  @keyframes marquee-left {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes marquee-right {
    0%   { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  #wtp-product-marquee-{{ section.id }} {
    background: var(--color-background, #F5F0E8);
    padding: 7rem 0 7rem 5%;
    overflow: hidden;
  }

  .pm-layout {
    display: flex;
    gap: 4rem;
    align-items: center;
  }

  /* ── LEFT ── */
  .pm-left {
    flex: 0 0 260px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-right: 1rem;
    z-index: 2;
  }

  .pm-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0;
  }

  .pm-headline {
    font-family: var(--font-heading-family);
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 700;
    color: #1B3A2D;
    margin: 0;
    line-height: 1.15;
  }

  .pm-description {
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(27,58,45,0.6);
    margin: 0;
  }

  .pm-cta {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1B3A2D;
    text-decoration: underline;
    text-underline-offset: 4px;
    display: inline-block;
  }

  /* ── RIGHT ── */
  .pm-right {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow: hidden;
  }

  .pm-track-wrapper {
    overflow: hidden;
    width: 100%;
  }

  .pm-track {
    display: flex;
    gap: 1rem;
    width: max-content;
  }

  .pm-track--left {
    animation: marquee-left 30s linear infinite;
  }

  .pm-track--right {
    animation: marquee-right 30s linear infinite;
  }

  .pm-track-wrapper:hover .pm-track {
    animation-play-state: paused;
  }

  .pm-card {
    flex-shrink: 0;
    width: 220px;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .pm-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.1);
  }

  .pm-card__img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }

  .pm-card__placeholder {
    width: 100%;
    height: 200px;
    background: #e8e4dc;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pm-card__info {
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .pm-card__title {
    font-size: 0.9rem;
    font-weight: 600;
    color: #1B3A2D;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pm-card__price {
    font-size: 0.85rem;
    color: #C8A96E;
    font-weight: 700;
    margin: 0;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    #wtp-product-marquee-{{ section.id }} {
      padding: 4rem 1.25rem;
    }

    .pm-layout {
      flex-direction: column;
      gap: 3rem;
    }

    .pm-left {
      flex: 1 1 100%;
      width: 100%;
      text-align: center;
      padding-right: 0;
    }

    .pm-track--left,
    .pm-track--right {
      animation-duration: 20s;
    }
  }
</style>

<section id="wtp-product-marquee-{{ section.id }}" aria-label="{{ section.settings.headline | escape }}">
  <div class="pm-layout">

    <!-- LEFT -->
    <div class="pm-left">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pm-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="pm-headline">{{ section.settings.headline | escape }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="pm-description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="pm-cta">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
    </div>

    <!-- RIGHT: Marquee -->
    <div class="pm-right">
      {%- assign collection = collections[section.settings.products_collection] -%}
      {%- assign products = collection.products -%}

      {%- if products.size > 0 -%}
        <!-- Row 1: scrolls left -->
        <div class="pm-track-wrapper">
          <div class="pm-track pm-track--left">
            {%- for product in products -%}
              <a href="{{ product.url }}" class="pm-card">
                {%- if product.featured_image != blank -%}
                  {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'pm-card__img', alt: product.title }}
                {%- else -%}
                  <div class="pm-card__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
                {%- endif -%}
                <div class="pm-card__info">
                  <p class="pm-card__title">{{ product.title | escape }}</p>
                  <p class="pm-card__price">{{ product.price | money }}</p>
                </div>
              </a>
            {%- endfor -%}
            {%- comment -%} Duplicate for seamless loop {%- endcomment -%}
            {%- for product in products -%}
              <a href="{{ product.url }}" class="pm-card" aria-hidden="true">
                {%- if product.featured_image != blank -%}
                  {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'pm-card__img', alt: product.title }}
                {%- else -%}
                  <div class="pm-card__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
                {%- endif -%}
                <div class="pm-card__info">
                  <p class="pm-card__title">{{ product.title | escape }}</p>
                  <p class="pm-card__price">{{ product.price | money }}</p>
                </div>
              </a>
            {%- endfor -%}
          </div>
        </div>

        <!-- Row 2: scrolls right (reverse) -->
        <div class="pm-track-wrapper">
          <div class="pm-track pm-track--right">
            {%- for product in products reversed -%}
              <a href="{{ product.url }}" class="pm-card">
                {%- if product.featured_image != blank -%}
                  {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'pm-card__img', alt: product.title }}
                {%- else -%}
                  <div class="pm-card__placeholder">{{ 'product-2' | placeholder_svg_tag }}</div>
                {%- endif -%}
                <div class="pm-card__info">
                  <p class="pm-card__title">{{ product.title | escape }}</p>
                  <p class="pm-card__price">{{ product.price | money }}</p>
                </div>
              </a>
            {%- endfor -%}
            {%- for product in products reversed -%}
              <a href="{{ product.url }}" class="pm-card" aria-hidden="true">
                {%- if product.featured_image != blank -%}
                  {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'pm-card__img', alt: product.title }}
                {%- else -%}
                  <div class="pm-card__placeholder">{{ 'product-2' | placeholder_svg_tag }}</div>
                {%- endif -%}
                <div class="pm-card__info">
                  <p class="pm-card__title">{{ product.title | escape }}</p>
                  <p class="pm-card__price">{{ product.price | money }}</p>
                </div>
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- else -%}
        {%- comment -%} Placeholder cards if collection is empty {%- endcomment -%}
        <div class="pm-track-wrapper">
          <div class="pm-track pm-track--left">
            {%- for i in (1..6) -%}
              <div class="pm-card">
                <div class="pm-card__placeholder">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
                <div class="pm-card__info">
                  <p class="pm-card__title">Product Title</p>
                  <p class="pm-card__price">$99.00</p>
                </div>
              </div>
            {%- endfor -%}
            {%- for i in (1..6) -%}
              <div class="pm-card" aria-hidden="true">
                <div class="pm-card__placeholder">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
                <div class="pm-card__info">
                  <p class="pm-card__title">Product Title</p>
                  <p class="pm-card__price">$99.00</p>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product Marquee",
  "settings": [
    {
      "type": "collection",
      "id": "products_collection",
      "label": "Products Collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Collection"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Crafted for the Ritual"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every piece designed to elevate your daily pour. Ceramics and merch made for the community."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    }
  ],
  "presets": [
    {
      "name": "Product Marquee"
    }
  ]
}
{% endschema %}
