{% comment %}
  WTP Product Marquee Section
  Two-column layout: Left text block, Right draggable marquee track.
  Cards rendered via `product-card` snippet (same as Featured Arrivals).
  Supports: mouse drag, touch drag, auto-scroll, infinite loop.
{% endcomment %}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<style>
  #wtp-product-marquee-{{ section.id }} {
    background: var(--color-background, #F5F0E8);
    padding: 8rem 0 8rem 5%;
    overflow: hidden;
  }

  .pm-layout {
    display: flex;
    gap: 4rem;
    align-items: center;
  }

  /* ── LEFT ── */
  .pm-left {
    flex: 0 0 calc(45% - 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-right: 2rem;
    z-index: 2;
  }

  .pm-eyebrow {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0;
  }

  .pm-headline {
    font-family: var(--font-heading-family);
    font-size: clamp(3.2rem, 7vw, 5.5rem);
    font-weight: 700;
    font-style: italic;
    color: #1B3A2D;
    margin: 0;
    line-height: 1.1;
  }

  .pm-description {
    font-size: 1.25rem;
    line-height: 1.85;
    color: rgba(27,58,45,0.6);
    margin: 0;
  }

  .pm-cta {
    display: inline-block;
    padding: 1rem 2.2rem;
    background: #1B3A2D;
    color: #fff;
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.2s ease;
    margin-top: 0.5rem;
    align-self: flex-start;
  }

  .pm-cta:hover { opacity: 0.85; }

  /* ── RIGHT: Draggable Marquee ── */
  .pm-right {
    flex: 0 0 calc(55% - 2rem);
    overflow: hidden;
    /* Fade edges for a cinematic bleed */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
  }

  .pm-track-wrapper {
    overflow: hidden;
    overflow-y: hidden;
    width: 100%;
    cursor: grab;
    padding: 0 1.5rem; /* Protect leftmost / rightmost cards from mask fade */
    box-sizing: border-box;
    /* Hide scrollbar cross-browser */
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }

  .pm-track-wrapper::-webkit-scrollbar {
    display: none;
  }

  .pm-track-wrapper.is-dragging {
    cursor: grabbing;
  }

  /* Prevent TEXT selection while dragging — but keep pointer events on children so click-threshold logic works */
  .pm-track-wrapper.is-dragging {
    user-select: none;
    -webkit-user-select: none;
  }
  .pm-track-wrapper.is-dragging * {
    user-select: none;
    -webkit-user-select: none;
  }

  .pm-track {
    display: flex;
    gap: 2.5rem;
    width: max-content;
    align-items: flex-start;
    padding: 0.5rem 0 1rem; /* Breathing room so card shadows aren't clipped */
  }

  /* Subtle drag hint indicator */
  .pm-drag-hint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(27,58,45,0.35);
    transition: opacity 0.4s ease;
  }

  .pm-drag-hint svg {
    flex-shrink: 0;
  }

  /* Hide hint once user has interacted */
  .pm-drag-hint.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  /* Fixed-width wrapper so product-card fills the marquee item */
  .pm-marquee-item {
    flex-shrink: 0;
    width: 280px;
    transition: transform 0.2s ease;
  }


  /* ── Mobile ── */
  @media (max-width: 768px) {
    #wtp-product-marquee-{{ section.id }} {
      padding: 5rem 0 4rem;
    }

    .pm-layout {
      flex-direction: column;
      gap: 3rem;
    }

    .pm-left {
      flex: 1 1 100%;
      width: 100%;
      padding: 0 1.25rem;
      text-align: center;
      align-items: center;
    }

    .pm-cta {
      align-self: center;
    }

    .pm-drag-hint {
      justify-content: center;
    }

    .pm-right {
      width: 100%;
      /* Full bleed on mobile */
      -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
      mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    }

    .pm-marquee-item { width: 220px; }
  }
</style>

<section id="wtp-product-marquee-{{ section.id }}" aria-label="{{ section.settings.headline | escape }}">
  <div class="pm-layout">
    <!-- LEFT -->
    <div class="pm-left">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pm-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="pm-headline">{{ section.settings.headline | escape }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="pm-description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="pm-cta">
          {{- section.settings.cta_label | escape -}}
        </a>
      {%- endif -%}

      <!-- Drag hint -->
      <p class="pm-drag-hint" id="pm-drag-hint-{{ section.id }}" aria-hidden="true">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14M9 8l-4 4 4 4M19 8l-4 4 4 4"/>
        </svg>
        Drag to explore
      </p>

    </div>

    <!-- RIGHT: Draggable Marquee -->
    <div class="pm-right">
      {%- assign pm_collection = collections[section.settings.products_collection] -%}
      {%- assign pm_products = pm_collection.products -%}

      {%- if pm_products.size > 0 -%}
        <div class="pm-track-wrapper" id="pm-wrapper-{{ section.id }}">
          <div class="pm-track" id="pm-track-{{ section.id }}">
            {%- for product in pm_products -%}
              <div class="pm-marquee-item">
                {%- render 'product-card', product: product -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

      {%- else -%}
        <div class="pm-track-wrapper" id="pm-wrapper-{{ section.id }}">
          <div class="pm-track" id="pm-track-{{ section.id }}">
            {%- for i in (1..6) -%}
              <div class="pm-marquee-item">
                <div style="background:#EAE7E0; aspect-ratio:4/5; border-radius:8px; display:flex; align-items:center; justify-content:center; opacity:0.4;">
                  {{ 'product-1' | placeholder_svg_tag: 'width:60px; height:60px;' }}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .pm-track {
    will-change: transform;
    transition: none;
  }

  .pm-track-wrapper:not(.is-dragging) .pm-track {
    transition: transform 0.1s linear;
  }

  .pm-track-wrapper .pm-track.is-rewinding {
    transition: transform 1.2s cubic-bezier(0.65, 0, 0.35, 1) !important;
  }
</style>

<script>
  (function () {
    function initMarquee(sectionId) {
      var wrapper  = document.getElementById('pm-wrapper-' + sectionId);
      var track    = document.getElementById('pm-track-' + sectionId);
      var hint     = document.getElementById('pm-drag-hint-' + sectionId);
      if (!wrapper || !track) return;

      /* ── State ── */
      var isDragging   = false;
      var isPaused     = false;
      var moveX        = 0;  /* current scroll position */
      var lastX        = 0;
      var dragDistance = 0;
      var maxTranslate = 0;
      var mode         = 'FORWARD'; /* FORWARD, PAUSE, REWIND */
      var pauseTimer   = null;

      function updateMaxTranslate() {
        var wBox = wrapper.clientWidth;
        var tBox = track.scrollWidth;
        maxTranslate = Math.max(0, tBox - wBox);
        /* Ensure moveX is still in bounds after resize */
        if (moveX > maxTranslate) {
          moveX = maxTranslate;
          updateTransform();
        }
      }

      function hideHint() {
        if (hint) hint.classList.add('is-hidden');
      }

      function updateTransform() {
        track.style.transform = 'translateX(' + (-moveX) + 'px)';
      }

      /* ── Main Loop ── */
      function loop() {
        if (isDragging || isPaused) {
          requestAnimationFrame(loop);
          return;
        }

        if (mode === 'FORWARD') {
          if (maxTranslate <= 0) {
            requestAnimationFrame(loop);
            return;
          }

          moveX += 0.4; /* Cinematic crawl */
          if (moveX >= maxTranslate) {
            moveX = maxTranslate;
            mode = 'PAUSE';
            pauseTimer = setTimeout(function() {
              if (!isDragging) {
                mode = 'REWIND';
                track.classList.add('is-rewinding');
                moveX = 0;
                updateTransform();
                
                /* Wait for rewind transition before resuming */
                setTimeout(function() {
                  if (mode === 'REWIND') {
                    mode = 'FORWARD';
                    track.classList.remove('is-rewinding');
                  }
                }, 1500);
              }
            }, 3000);
          }
          updateTransform();
        } 
        /* REWIND and PAUSE don't need per-frame updates as they use CSS transitions or are static */

        requestAnimationFrame(loop);
      }

      /* ── Drag Handling ── */
      function startDrag(x) {
        isDragging = true;
        lastX = x;
        dragDistance = 0;
        wrapper.classList.add('is-dragging');
        track.classList.remove('is-rewinding');
        /* If we were in REWIND, snap to current and switch to FORWARD */
        if (mode === 'REWIND') {
          mode = 'FORWARD';
        }
        if (pauseTimer) clearTimeout(pauseTimer);
        hideHint();
      }

      function moveDrag(x) {
        if (!isDragging) return;
        var delta = x - lastX;
        lastX = x;
        dragDistance += Math.abs(delta);
        moveX -= delta;
        
        /* Strict Boundary Clamping */
        if (moveX < 0) moveX = 0;
        if (moveX > maxTranslate) moveX = maxTranslate;

        updateTransform();
      }

      function endDrag() {
        if (!isDragging) return;
        isDragging = false;
        wrapper.classList.remove('is-dragging');
        /* Resume crawl from where we dropped it */
        if (mode !== 'REWIND') mode = 'FORWARD';
        
        setTimeout(function() { dragDistance = 0; }, 50);
      }

      /* Mouse Events */
      wrapper.addEventListener('mousedown', function(e) { 
        startDrag(e.clientX); 
        e.preventDefault(); 
      });
      window.addEventListener('mousemove', function(e) { moveDrag(e.clientX); });
      window.addEventListener('mouseup', function() { endDrag(); });

      /* Touch Events */
      wrapper.addEventListener('touchstart', function(e) { 
        startDrag(e.touches[0].clientX); 
      }, {passive: false}); // Set to false so we can preventDefault if needed
      
      wrapper.addEventListener('touchmove', function(e) { 
        if (isDragging) {
          moveDrag(e.touches[0].clientX);
          /* Only prevent default if we're actually dragging horizontally to allow vertical page scroll */
          if (dragDistance > 5) e.preventDefault();
        }
      }, {passive: false});
      
      wrapper.addEventListener('touchend', function() { endDrag(); });

      /* Link / Click prevention during drag */
      wrapper.addEventListener('click', function(e) {
        if (dragDistance > 10) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);

      /* Hover pause */
      wrapper.addEventListener('mouseenter', function() { isPaused = true; });
      wrapper.addEventListener('mouseleave', function() { isPaused = false; });

      /* Initialize */
      requestAnimationFrame(function() {
        updateMaxTranslate();
        requestAnimationFrame(loop);
      });
      
      /* Re-calculate on resize and after full page load (images) */
      window.addEventListener('resize', updateMaxTranslate);
      window.addEventListener('load', updateMaxTranslate);
    }

    /* Run after DOM is ready */
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        initMarquee({{ section.id | json }});
      });
    } else {
      initMarquee({{ section.id | json }});
    }

    /* Theme Editor re-init */
    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId == {{ section.id | json }}) {
        initMarquee({{ section.id | json }});
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Product Marquee",
  "settings": [
    {
      "type": "collection",
      "id": "products_collection",
      "label": "Products Collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Collection"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Crafted for the Ritual"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every piece designed to elevate your daily pour. Ceramics and merch made for the community."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Auto-scroll Speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 30,
      "unit": "s",
      "info": "Duration in seconds for one full loop. Lower = faster."
    }
  ],
  "presets": [
    {
      "name": "Product Marquee"
    }
  ]
}
{% endschema %}
