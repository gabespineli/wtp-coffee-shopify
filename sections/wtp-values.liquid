{%- style -%}
  #wtp-values-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: 6rem 5%;
    overflow: hidden;
  }

  .val-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ── Header ── */
  .val-header {
    text-align: center;
    margin-bottom: 4.5rem;
  }

  .val-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin: 0 0 0.8rem;
  }

  .val-heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 4vw, 3.8rem);
    font-weight: 700;
    line-height: 1.1;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  /* ── Grid ── */
  .val-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem 4rem;
  }

  /* ── Individual Item ── */
  .val-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .val-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: {{ section.settings.icon_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.75rem;
  }

  .val-icon-wrap img,
  .val-icon-wrap svg {
    width: 32px;
    height: 32px;
    object-fit: contain;
    color: {{ section.settings.accent_color }};
    fill: none;
  }

  .val-title {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    margin: 0 0 1rem;
  }

  .val-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    opacity: 0.7;
    margin: 0;
  }

  /* ── Responsive ── */
  @media screen and (max-width: 990px) {
    .val-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem 2rem;
    }
  }

  @media screen and (max-width: 600px) {
    #wtp-values-{{ section.id }} {
      padding: 5rem 5%;
    }
    .val-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .val-header {
      margin-bottom: 3.5rem;
    }
  }
{%- endstyle -%}

<section id="wtp-values-{{ section.id }}" aria-label="{{ section.settings.heading | escape }}">
  <div class="val-container">
    
    <header class="val-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="val-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="val-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="val-grid">
        {%- for block in section.blocks -%}
          <div class="val-item" {{ block.shopify_attributes }}>
            <div class="val-icon-wrap">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 128 | image_tag: loading: 'lazy' }}
              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                </svg>
              {%- endif -%}
            </div>
            {%- if block.settings.title != blank -%}
              <h3 class="val-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="val-desc">{{ block.settings.description | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "WTP Values",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FRAMEWORK / VALUES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Way We Work"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#F5F0E8"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon Circle Background",
      "default": "#EFE6D8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1B3A2D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#C8A96E"
    }
  ],
  "blocks": [
    {
      "type": "value_card",
      "name": "Value Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon/Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "INTEGRITY"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "We commit to radical transparency in our sourcing and roasting."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WTP Values",
      "blocks": [
        {
          "type": "value_card",
          "settings": {
            "title": "INTEGRITY",
            "description": "We commit to radical transparency in our sourcing, roasting, and brewing processes."
          }
        },
        {
          "type": "value_card",
          "settings": {
            "title": "RELATIONSHIP",
            "description": "Deep connections with partner farmers ensure a vibrant, thriving ecosystem."
          }
        },
        {
          "type": "value_card",
          "settings": {
            "title": "CRAFT",
            "description": "We treat every bean as an opportunity to experiment and elevate the final cup."
          }
        }
      ]
    }
  ]
}
{% endschema %}
