{%- style -%}
  /* ════════════════════════════════════════
     SECTION
  ════════════════════════════════════════ */
  #wtp-values-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: 8rem 5%;
    overflow: hidden;
  }

  .val-container {
    max-width: 1380px;
    margin: 0 auto;
  }

  /* ── Header ── */
  .val-header {
    text-align: left;
    margin-bottom: 5rem;
  }

  .val-heading {
    font-family: var(--font-heading-family);
    font-size: clamp(3.6rem, 8vw, 7rem);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .val-heading-word-1 {
    color: {{ section.settings.word_1_color }};
  }

  .val-heading-word-2 {
    color: {{ section.settings.word_2_color }};
  }

  /* ── Grid with vertical dividers ── */
  .val-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .val-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 3.5rem;
    gap: 2.5rem;
  }

  .val-column:not(:last-child) {
    border-right: 1px solid rgba(255, 255, 255, 0.2);
  }

  .val-column:first-child {
    padding-left: 0;
  }

  .val-column:last-child {
    padding-right: 0;
  }

  /* ── Equal-height grid rows ── */
  .val-grid {
    align-items: stretch;
  }

  /* ── Illustration Card (portrait) ── */
  .val-illus-card {
    width: 100%;
    flex: 1;
    min-height: 0;
    aspect-ratio: 3 / 4;
    background: #F5F0E8;
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    box-sizing: border-box;
  }

  .val-illus-card img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .val-illus-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .val-illus-placeholder svg {
    width: 60%;
    height: auto;
    opacity: 0.2;
  }

  /* ── Text below illustration ── */
  .val-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    width: 100%;
  }

  .val-title {
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .val-desc {
    font-size: 1.05rem;
    line-height: 1.8;
    color: {{ section.settings.text_color }};
    opacity: 0.65;
    margin: 0;
    max-width: 300px;
  }

  /* ── Responsive ── */
  @media screen and (max-width: 750px) {
    #wtp-values-{{ section.id }} {
      padding: 5rem 5%;
    }

    .val-header {
      margin-bottom: 3.5rem;
    }

    .val-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .val-column {
      padding: 0;
      gap: 2rem;
    }

    .val-column:not(:last-child) {
      border-right: none;
      padding-bottom: 4rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    }

    .val-illus-card {
      aspect-ratio: 4 / 3;
      max-width: 360px;
      margin: 0 auto;
    }
  }
{%- endstyle -%}

<section id="wtp-values-{{ section.id }}" aria-label="{{ section.settings.heading | escape }}">
  <div class="val-container">

    <header class="val-header">
      <h2 class="val-heading">
        <span class="val-heading-word-1">{{ section.settings.word_1 | default: 'Core' | escape }}</span>
        <span class="val-heading-word-2"> {{ section.settings.word_2 | default: 'Values' | escape }}</span>
      </h2>
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="val-grid">
        {%- for block in section.blocks -%}
          <div class="val-column" {{ block.shopify_attributes }}>

            <div class="val-illus-card">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}
              {%- else -%}
                <div class="val-illus-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
              {%- endif -%}
            </div>

            <div class="val-text">
              {%- if block.settings.title != blank -%}
                <h3 class="val-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="val-desc">{{ block.settings.description | escape }}</p>
              {%- endif -%}
            </div>

          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "WTP Values",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "word_1",
      "label": "First Word",
      "default": "Core"
    },
    {
      "type": "color",
      "id": "word_1_color",
      "label": "First Word Color",
      "default": "#C8A96E"
    },
    {
      "type": "text",
      "id": "word_2",
      "label": "Second Word",
      "default": "Values"
    },
    {
      "type": "color",
      "id": "word_2_color",
      "label": "Second Word Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1B3A2D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "value_column",
      "name": "Value Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Line Art / Illustration"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Integrity"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "We commit to radical transparency in our sourcing, roasting, and brewing processes."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WTP Values",
      "blocks": [
        {
          "type": "value_column",
          "settings": {
            "title": "Integrity",
            "description": "We commit to radical transparency in our sourcing, roasting, and brewing processes."
          }
        },
        {
          "type": "value_column",
          "settings": {
            "title": "Relationship",
            "description": "Deep connections with partner farmers ensure a vibrant, thriving ecosystem."
          }
        },
        {
          "type": "value_column",
          "settings": {
            "title": "Craft",
            "description": "We treat every bean as an opportunity to experiment and elevate the final cup."
          }
        }
      ]
    }
  ]
}
{% endschema %}
