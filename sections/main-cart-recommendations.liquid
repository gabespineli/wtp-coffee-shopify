{% comment %}
  WTP Coffee — Cart Recommendations
  Renders product suggestions based on Cart contents.
  - Suggests from a collection (default: all), filtering out items in cart.
{% endcomment %}

{%- liquid
  assign limit = section.settings.product_count
  assign show_section = false

  if cart != empty
    assign show_section = true
  endif

  if request.design_mode
    assign show_section = true
  endif
-%}

{%- if show_section -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- style -%}
    .wtp-cart-recs-wrap {
      background: #f5f0e8;
      padding: 0 5% 6rem;
    }

    .wtp-cart-recs-inner {
      max-width: 950px;
      margin: 0 auto;
      border-top: 1px solid rgba(27, 58, 45, 0.1);
      padding-top: 3rem;
    }

    .wtp-cart-recs__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2.5rem;
    }

    .wtp-cart-recs__heading {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      color: rgba(27, 58, 45, 0.5);
      margin: 0;
    }

    .wtp-cart-recs__arrows {
      display: flex;
      gap: 0.5rem;
    }

    .wtp-arrow {
      background: transparent;
      border: 1px solid rgba(27, 58, 45, 0.2);
      border-radius: 50%;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: rgba(27, 58, 45, 0.5);
      transition: all 0.2s ease;
      padding: 0;
    }
    .wtp-arrow:hover:not([disabled]) {
      border-color: rgba(27, 58, 45, 1);
      color: rgba(27, 58, 45, 1);
    }
    .wtp-arrow svg {
      width: 14px;
      height: 14px;
      fill: currentColor;
    }
    .wtp-arrow[disabled] {
      opacity: 0.2;
      cursor: not-allowed;
    }

    .wtp-cart-recs__grid {
      display: flex;
      gap: 1.5rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      scroll-behavior: smooth;
    }
    .wtp-cart-recs__grid::-webkit-scrollbar {
      display: none;
    }

    .wtp-cart-recs__item {
      scroll-snap-align: start;
      flex: 0 0 calc(25% - 1.125rem);
    }

    @media screen and (max-width: 900px) {
      .wtp-cart-recs__item {
        flex: 0 0 calc(33.333% - 1rem);
      }
    }

    @media screen and (max-width: 600px) {
      .wtp-cart-recs-wrap {
        padding-left: 1.25rem;
        padding-right: 1.25rem;
        padding-bottom: 4rem;
      }
      .wtp-cart-recs__grid {
        margin: 0 -1.25rem;
        padding: 0 1.25rem 0 2rem;
        scroll-padding-left: 2rem;
      }
      .wtp-cart-recs__item {
         flex: 0 0 calc(50% - 0.75rem);
      }
      .wtp-cart-recs__header {
        margin-bottom: 1.5rem;
      }
      .wtp-cart-recs__arrows {
        display: none;
      }
    }
  {%- endstyle -%}

  <div class="wtp-cart-recs-wrap">
    <div class="wtp-cart-recs-inner">
      <div class="wtp-cart-recs__header">
        <h2 class="wtp-cart-recs__heading">{{ section.settings.heading }}</h2>
        <div class="wtp-cart-recs__arrows">
          <button class="wtp-arrow wtp-arrow--prev" id="CartRecsPrev-{{ section.id }}" aria-label="Previous">
            <svg viewBox="0 0 14 14" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 11l-4-4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="wtp-arrow wtp-arrow--next" id="CartRecsNext-{{ section.id }}" aria-label="Next">
            <svg viewBox="0 0 14 14" xmlns="http://www.w3.org/2000/svg"><path d="M5.5 11l4-4-4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>

      <div class="wtp-cart-recs__grid" id="CartRecsGrid-{{ section.id }}" role="list">
        {%- liquid
          assign source_collection = section.settings.collection | default: collections.all
          assign cart_product_ids = cart.items | map: 'product_id'
          assign shown_count = 0
        -%}
        {%- for product in source_collection.products limit: 50 -%}
          {%- unless cart_product_ids contains product.id -%}
            {%- if shown_count < limit -%}
              <div class="wtp-cart-recs__item" role="listitem">
                {%- render 'product-card', product: product -%}
              </div>
              {%- assign shown_count = shown_count | plus: 1 -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const grid = document.getElementById('CartRecsGrid-{{ section.id }}');
      const prevBtn = document.getElementById('CartRecsPrev-{{ section.id }}');
      const nextBtn = document.getElementById('CartRecsNext-{{ section.id }}');

      if (!grid || !prevBtn || !nextBtn) return;

      const updateButtons = () => {
        prevBtn.disabled = grid.scrollLeft <= 1;
        nextBtn.disabled = grid.scrollLeft >= grid.scrollWidth - grid.clientWidth - 1;
      };

      grid.addEventListener('scroll', updateButtons, { passive: true });
      window.addEventListener('resize', updateButtons);
      
      // Initialize
      setTimeout(updateButtons, 100);

      prevBtn.addEventListener('click', () => {
        const itemWidth = grid.querySelector('.wtp-cart-recs__item').offsetWidth;
        const gap = parseInt(window.getComputedStyle(grid).gap) || 0;
        grid.scrollBy({ left: -(itemWidth + gap), behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        const itemWidth = grid.querySelector('.wtp-cart-recs__item').offsetWidth;
        const gap = parseInt(window.getComputedStyle(grid).gap) || 0;
        grid.scrollBy({ left: itemWidth + gap, behavior: 'smooth' });
      });
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Cart Recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "You may also like"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Recommendations Collection",
      "info": "Products from this collection will be suggested. Defaults to all products."
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "Number of Products",
      "min": 2,
      "max": 8,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Cart Recommendations"
    }
  ]
}
{% endschema %}
