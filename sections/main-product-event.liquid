{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ── Event Masterclass Specialized Grid ── */
  .event-layout-wrapper {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  @media screen and (min-width: 900px) {
    .event-layout-wrapper {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      align-items: start;
    }
  }

  /* ── Left Column: Storytelling ── */
  .event-story {
    width: 100%;
  }

  .event-story-bannerimg {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 3rem;
  }
  
  .event-story-bannerimg img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .event-large-title {
    font-family: var(--font-heading-family);
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 1.1;
    color: #1B3A2D;
    margin: 0 0 1rem;
  }

  .event-description {
    font-family: var(--font-body-family);
    font-size: 1.15rem;
    line-height: 1.8;
    color: #1B3A2D;
    margin-bottom: 4rem;
    max-width: 800px;
  }

  /* ── Features Grid (2x2) ── */
  .event-features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  @media screen and (min-width: 750px) {
    .event-features-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .event-feature-block {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .event-feature-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #F5F0E8;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #C8A96E;
  }

  .event-feature-icon svg {
    width: 24px;
    height: 24px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
  }

  .event-feature-text h4 {
    font-family: var(--font-heading-family);
    font-size: 1.3rem;
    color: #1B3A2D;
    margin: 0 0 0.5rem;
  }

  .event-feature-text p {
    font-size: 1rem;
    color: rgba(27, 58, 45, 0.8);
    margin: 0;
    line-height: 1.6;
  }

  /* ── Right Column: The Transaction (Sticky) ── */
  .event-transaction-col {
    position: sticky;
    top: 4rem; /* Offset from header */
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .tuition-card {
    background: #F5F0E8;
    border-radius: 12px;
    padding: 3rem;
    box-shadow: 0 10px 40px rgba(0,0,0,0.03);
  }

  .tuition-header {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.85rem;
    font-weight: 700;
    color: #C8A96E;
    margin: 0 0 0.5rem;
  }

  .tuition-price {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 3vw, 3.2rem);
    line-height: 1.1;
    color: #1B3A2D;
    margin: 0 0 2.5rem;
  }

  /* Native Form Restyling specifically for Event section */
  .tuition-card .product-form__input {
    margin-bottom: 2.5rem;
  }
  
  .tuition-card .form__label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: #1B3A2D;
    margin-bottom: 1rem;
    display: block;
  }

  .tuition-card .product-form__submit {
    margin-top: 1rem;
    margin-bottom: 0;
  }

  /* ── Strict Testimonial Render ── */
  .event-testimonial {
    background: #FFFFFF;
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    border: 1px solid rgba(27,58,45,0.05);
  }

  .event-testi-quote {
    font-family: var(--font-heading-family);
    font-size: 1.2rem;
    font-style: italic;
    color: #1B3A2D;
    line-height: 1.5;
    margin: 0 0 1.5rem;
  }

  .event-testi-author-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .event-testi-img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }

  .event-testi-author {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0;
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <div class="event-layout-wrapper">
    
    <!-- LEFT COLUMN -->
    <div class="event-story">
      {%- if product.featured_image != blank -%}
      <div class="event-story-bannerimg">
        {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', sizes: '(min-width: 900px) 60vw, 100vw' }}
      </div>
      {%- endif -%}

      <h1 class="event-large-title">{{ product.title | escape }}</h1>
      
      <div class="event-description rte">
        {{ product.description }}
      </div>

      <!-- Generate Features Grid from schema blocks -->
      {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
      {%- if feature_blocks.size > 0 -%}
        <div class="event-features-grid">
          {%- for block in feature_blocks -%}
            <div class="event-feature-block" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != 'none' -%}
                <div class="event-feature-icon">
                  {% render 'icon-accordion', icon: block.settings.icon %}
                </div>
              {%- endif -%}
              <div class="event-feature-text">
                {%- if block.settings.title != blank -%}
                  <h4>{{ block.settings.title | escape }}</h4>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p>{{ block.settings.description | escape }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- RIGHT COLUMN (Sticky Transaction) -->
    <div class="event-transaction-col">
      
      <div class="tuition-card">
        <p class="tuition-header">Tuition</p>
        <p class="tuition-price" id="price-{{ section.id }}">
          {{ product.price | money }}
        </p>

        <!-- Product Form -->
        <div class="product-form-wrapper">
          {%- assign product_form_id = 'product-form-' | append: section.id -%}
          
          <product-info id="ProductInfo-{{ section.id }}" data-section="{{ section.id }}" data-url="{{ product.url }}">
            
            {%- unless product.has_only_default_variant -%}
              <variant-radios class="no-js-hidden" data-section="{{ section.id }}" data-url="{{ product.url }}">
                {%- for option in product.options_with_values -%}
                  <fieldset class="js product-form__input product-form__input--pill">
                    <legend class="form__label">{{ option.name }}</legend>
                    {% render 'product-variant-options', product: product, option: option %}
                  </fieldset>
                {%- endfor -%}
                <script type="application/json">
                  {{ product.variants | json }}
                </script>
              </variant-radios>
            {%- endunless -%}

            <product-form class="product-form">
              <div class="product-form__error-message-wrapper" role="alert" hidden>
                <svg aria-hidden="true" focusable="false" class="icon icon-error" viewBox="0 0 13 13">
                  <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
                  <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
                  <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
                  <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
                </svg>
                <span class="product-form__error-message"></span>
              </div>

              {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" disabled class="product-variant-id">
                
                <!-- Explicitly omitting quantity naturally for events, or forcing hidden quantity 1 -->
                <input type="hidden" name="quantity" value="1">

                <div class="product-form__buttons">
                  <button
                    type="submit"
                    name="add"
                    class="product-form__submit button button--full-width button--primary"
                    {% if product.selected_or_first_available_variant.available == false %}
                      disabled
                    {% endif %}
                  >
                    <span>
                      {%- if product.selected_or_first_available_variant.available -%}
                        SECURE YOUR SPOT
                      {%- else -%}
                        SOLD OUT
                      {%- endif -%}
                    </span>
                    <div class="loading-overlay__spinner hidden">
                      <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                        <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                      </svg>
                    </div>
                  </button>
                </div>
              {%- endform -%}
            </product-form>
          </product-info>
        </div>
      </div>

      <!-- Testimonial Block (STRICT CONDITIONAL RENDER) -->
      {%- assign testimonial_block = section.blocks | where: 'type', 'testimonial' | first -%}
      {%- if testimonial_block != blank -%}
        {%- if testimonial_block.settings.quote != blank -%}
          <div class="event-testimonial" {{ testimonial_block.shopify_attributes }}>
            <p class="event-testi-quote">"{{ testimonial_block.settings.quote | escape }}"</p>
            <div class="event-testi-author-wrap">
              {%- if testimonial_block.settings.image != blank -%}
                {{ testimonial_block.settings.image | image_url: width: 80 | image_tag: class: 'event-testi-img', loading: 'lazy' }}
              {%- endif -%}
              {%- if testimonial_block.settings.author != blank -%}
                <p class="event-testi-author">{{ testimonial_block.settings.author | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}

    </div>
  </div>
</div>

<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Event Product",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature / Curriculum",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "apple", "label": "Apple" },
            { "value": "banana", "label": "Banana" },
            { "value": "bottle", "label": "Bottle" },
            { "value": "box", "label": "Box" },
            { "value": "carrot", "label": "Carrot" },
            { "value": "chat_bubble", "label": "Chat bubble" },
            { "value": "check_mark", "label": "Check mark" },
            { "value": "clipboard", "label": "Clipboard" },
            { "value": "dairy", "label": "Dairy" },
            { "value": "dairy_free", "label": "Dairy free" },
            { "value": "dryer", "label": "Dryer" },
            { "value": "eye", "label": "Eye" },
            { "value": "fire", "label": "Fire" },
            { "value": "gluten_free", "label": "Gluten free" },
            { "value": "heart", "label": "Heart" },
            { "value": "iron", "label": "Iron" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "leather", "label": "Leather" },
            { "value": "lightning_bolt", "label": "Lightning bolt" },
            { "value": "lipstick", "label": "Lipstick" },
            { "value": "lock", "label": "Lock" },
            { "value": "map_pin", "label": "Map pin" },
            { "value": "nut_free", "label": "Nut free" },
            { "value": "pants", "label": "Pants" },
            { "value": "paw_print", "label": "Paw print" },
            { "value": "pepper", "label": "Pepper" },
            { "value": "perfume", "label": "Perfume" },
            { "value": "plane", "label": "Plane" },
            { "value": "plant", "label": "Plant" },
            { "value": "price_tag", "label": "Price tag" },
            { "value": "question_mark", "label": "Question mark" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "return", "label": "Return" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "serving_dish", "label": "Serving dish" },
            { "value": "shirt", "label": "Shirt" },
            { "value": "shoe", "label": "Shoe" },
            { "value": "silhouette", "label": "Silhouette" },
            { "value": "snowflake", "label": "Snowflake" },
            { "value": "star", "label": "Star" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "truck", "label": "Truck" },
            { "value": "washing", "label": "Washing" }
          ],
          "default": "check_mark",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Curriculum Item"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Learn the theory behind the extraction."
        }
      ]
    },
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "info": "This must be filled to display the testimonial box."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Author avatar"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Event Product",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
