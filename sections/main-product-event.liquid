

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ── Event Masterclass Specialized Grid ── */
  .event-layout-wrapper {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  @media screen and (min-width: 900px) {
    .event-layout-wrapper {
      display: grid;
      grid-template-columns: 0.4fr 0.61fr;
      gap: 5rem;
      align-items: start;
    }
  }

  /* ── Left Column: Storytelling ── */
  .event-story-bannerimg {
    width: 100%;
    aspect-ratio: 9 / 16;
    max-height: 85vh;
    border-radius: 12px;
    overflow: hidden;
  }
  
  .event-story-bannerimg img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: top;
  }

  .event-large-title {
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 700;
    line-height: 1.1;
    color: #1B3A2D;
    margin: 0 0 1.5rem;
  }

  .event-description {
    font-family: var(--font-body-family);
    font-size: 1.15rem;
    line-height: 1.8;
    color: #1B3A2D;
  }

  /* ── Image Card Grid (2x2) ── */
  .event-image-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  @media screen and (min-width: 750px) {
    .event-image-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .event-image-card {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .event-image-card__img {
    width: 100%;
    max-width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 12px;
    display: block;
  }

  .event-image-card__text {
    padding: 1.2rem 0.25rem 0;
  }

  .event-image-card__title {
    font-family: var(--font-heading-family);
    font-size: 1.25rem;
    line-height: 1.2;
    color: #1B3A2D;
    margin: 0 0 0.4rem;
  }

  .event-image-card__desc {
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(27, 58, 45, 0.75);
    margin: 0;
  }

  /* ── Right Column: The Transaction (Sticky) ── */
  .event-transaction-col {
    position: sticky;
    top: 4rem; /* Offset from header */
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .tuition-card {
    background: #F5F0E8;
    border-radius: 12px;
    padding: 3rem;
    box-shadow: 0 10px 40px rgba(0,0,0,0.03);
  }

  .tuition-header {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: rgba(200, 169, 110, 0.1);
    color: #C8A96E;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 1.5rem;
  }

  .tuition-price {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 3vw, 3.2rem);
    line-height: 1.1;
    color: #1B3A2D;
    margin: 0 0 2.5rem;
  }

  /* Native Form Restyling specifically for Event section */
  .tuition-card .product-form__input {
    margin-bottom: 2.5rem;
  }
  
  .tuition-card .form__label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: #1B3A2D;
    margin-bottom: 1rem;
    display: block;
  }

  .tuition-card .product-form__submit {
    margin-top: 1rem;
    margin-bottom: 0;
  }

  /* ── Event Meta (Date + Location) ── */
  .event-meta-block {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(27, 58, 45, 0.1);
  }

  .event-meta-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.15rem;
    color: rgba(27, 58, 45, 0.7);
    margin: 0;
  }

  .event-meta-item svg {
    width: 18px;
    height: 18px;
    stroke: #C8A96E;
    fill: none;
    stroke-width: 2;
    flex-shrink: 0;
  }



  /* ── Strict Testimonial Render ── */
  .event-testimonial {
    background: #FFFFFF;
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    border: 1px solid rgba(27,58,45,0.05);
  }

  .event-testi-quote {
    font-family: var(--font-heading-family);
    font-size: 1.2rem;
    font-style: italic;
    color: #1B3A2D;
    line-height: 1.5;
    margin: 0 0 1.5rem;
  }

  .event-testi-author-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .event-testi-img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }

  .event-testi-author {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0;
  }

  /* ── Mobile Optimization & Reordering ── */
  @media screen and (max-width: 899px) {
    .event-layout-wrapper {
      gap: 3rem;
    }

    .event-story, 
    .event-transaction-col {
      display: contents;
    }

    .event-story-bannerimg { 
      order: 1; 
      margin-bottom: 0; 
    }

    .tuition-card { 
      order: 2; 
      padding: 2.5rem 1.5rem;
    }

    .event-description { 
      order: 3;
      margin: 3rem 0 2rem; 
      text-align: left;
      font-size: 1.1rem;
    }

    .event-image-grid { 
      order: 4; 
    }

    .event-testimonial { 
      order: 5; 
    }
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <div class="event-layout-wrapper">
    
    <!-- LEFT COLUMN: Primary Visual -->
    <div class="event-story">
      {%- if article.image != blank -%}
        <div class="event-story-bannerimg">
          {{ article.image | image_url: width: 1200 | image_tag: loading: 'eager', sizes: '(min-width: 900px) 40vw, 100vw' }}
        </div>
      {%- endif -%}
    </div>

    <!-- RIGHT COLUMN (Sticky Transaction) -->
    <div class="event-transaction-col">
      
      <div class="tuition-card">
        {%- liquid
          assign event_tag = article.tags.first
          assign event_date_raw = article.metafields.custom.event_date
          assign event_location = article.metafields.custom.event_location
          if event_tag != blank
            assign tuition_eyebrow = event_tag
          else
            assign tuition_eyebrow = 'Event'
          endif
        -%}
        <p class="tuition-header">{{ tuition_eyebrow | escape | upcase }}</p>
        <h1 class="event-large-title">{{ article.title | escape }}</h1>

        {%- if event_date_raw != blank or event_location != blank -%}
          <div class="event-meta-block">
            {%- if event_date_raw != blank -%}
              <p class="event-meta-item">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                {{ event_date_raw | date: '%B %-d, %Y at %-I:%M %p' }}
              </p>
            {%- endif -%}
            {%- if event_location != blank -%}
              <p class="event-meta-item">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6-5.686-6-10a6 6 0 1 1 12 0c0 4.314-6 10-6 10z"/><circle cx="12" cy="11" r="2"/></svg>
                {{ event_location | escape }}
              </p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- assign rsvp_url = article.metafields.custom.event_rsvp_url -%}
        <div style="margin-top: 2rem;">
          {%- if rsvp_url != blank -%}
            <a href="{{ rsvp_url }}" target="_blank" rel="noopener noreferrer" style="display: block; width: 100%; text-align: center; padding: 1.25rem; background: var(--ch-accent, #C8A96E); color: #fff; text-decoration: none; font-weight: 700; border-radius: 50px; text-transform: uppercase; letter-spacing: 0.1em;">
              Secure Your Spot
            </a>
          {%- else -%}
            <span style="display: block; width: 100%; text-align: center; padding: 1.25rem; background: #e0e0e0; color: #7a7a7a; font-weight: 700; border-radius: 50px; text-transform: uppercase; letter-spacing: 0.1em;">
              Registration Coming Soon
            </span>
          {%- endif -%}
        </div>
      </div>

      <div class="event-description rte">
        {{ article.content }}
      </div>

      <!-- Image Card Grid from schema blocks -->
      {%- assign image_card_blocks = section.blocks | where: 'type', 'image_card' -%}
      {%- if image_card_blocks.size > 0 -%}
        <div class="event-image-grid">
          {%- for block in image_card_blocks -%}
            {%- case block.type -%}
              {%- when 'image_card' -%}
                <div class="event-image-card" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 600
                      | image_tag:
                        class: 'event-image-card__img',
                        loading: 'lazy',
                        widths: '300, 450, 600',
                        sizes: '(min-width: 750px) 30vw, 90vw',
                        alt: block.settings.title | default: product.title
                    }}
                  {%- endif -%}
                  {%- if block.settings.title != blank or block.settings.description != blank -%}
                    <div class="event-image-card__text">
                      {%- if block.settings.title != blank -%}
                        <h4 class="event-image-card__title">{{ block.settings.title | escape }}</h4>
                      {%- endif -%}
                      {%- if block.settings.description != blank -%}
                        <p class="event-image-card__desc">{{ block.settings.description | escape }}</p>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <!-- Testimonial Block (STRICT CONDITIONAL RENDER) -->
      {%- assign testimonial_block = section.blocks | where: 'type', 'testimonial' | first -%}
      {%- if testimonial_block != blank -%}
        {%- if testimonial_block.settings.quote != blank -%}
          <div class="event-testimonial" {{ testimonial_block.shopify_attributes }}>
            <p class="event-testi-quote">"{{ testimonial_block.settings.quote | escape }}"</p>
            <div class="event-testi-author-wrap">
              {%- if testimonial_block.settings.image != blank -%}
                {{ testimonial_block.settings.image | image_url: width: 80 | image_tag: class: 'event-testi-img', loading: 'lazy' }}
              {%- endif -%}
              {%- if testimonial_block.settings.author != blank -%}
                <p class="event-testi-author">{{ testimonial_block.settings.author | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}

    </div>
  </div>
</div>



{% schema %}
{
  "name": "Event Article",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image_card",
      "name": "Image Card",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading (Optional)"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description (Optional)"
        }
      ]
    },
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "info": "This must be filled to display the testimonial box."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Author avatar"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Event Article",
      "blocks": [
        { "type": "image_card" },
        { "type": "image_card" }
      ]
    }
  ]
}
{% endschema %}
