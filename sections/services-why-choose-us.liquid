{%- style -%}
  /* ═══════════════════════════════════════
     WTP — Why Choose Us
  ═══════════════════════════════════════ */
  #wtp-why-choose-{{ section.id }} {
    background: #F5F0E8;
    padding: 8rem 5%;
    overflow: hidden;
  }

  /* ── Section Header ── */
  .wcu-header {
    max-width: 1100px;
    margin: 0 auto 6rem;
  }

  .wcu-eyebrow {
    font-family: 'Poppins', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0 0 1.25rem;
  }

  .wcu-title {
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    font-weight: 700;
    line-height: 1.08;
    color: #1B3A2D;
    margin: 0;
  }

  /* ── Alternating Rows ── */
  .wcu-rows {
    display: flex;
    flex-direction: column;
    gap: 7rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .wcu-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
  }

  /* Even-indexed rows flip the column order */
  .wcu-row--flipped .wcu-text-col {
    order: 2;
  }

  .wcu-row--flipped .wcu-img-col {
    order: 1;
  }

  /* ── Text Column ── */
  .wcu-text-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .wcu-row-headline {
    font-family: var(--font-heading-family);
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 700;
    line-height: 1.1;
    color: #1B3A2D;
    margin: 0;
  }

  .wcu-accent-line {
    width: 48px;
    height: 3px;
    background: #C8A96E;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .wcu-row-desc {
    font-family: 'Poppins', sans-serif;
    font-size: 1.05rem;
    line-height: 1.8;
    color: rgba(27, 58, 45, 0.75);
    margin: 0;
    max-width: 480px;
  }

  /* ── Image Column ── */
  .wcu-img-col {
    width: 100%;
  }

  .wcu-img-wrap {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    overflow: hidden;
    background: rgba(27, 58, 45, 0.06);
  }

  .wcu-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .wcu-img-wrap:hover img {
    transform: scale(1.04);
  }

  .wcu-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(27, 58, 45, 0.2);
  }

  .wcu-img-placeholder svg {
    width: 64px;
    height: 64px;
  }

  /* ═══════════════════════════════════════
     Fade-up Scroll Animation
  ═══════════════════════════════════════ */
  @keyframes wcuFadeUp {
    from {
      opacity: 0;
      transform: translateY(36px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .wcu-row {
    opacity: 0;
    transform: translateY(36px);
    transition: none;
  }

  .wcu-row.is-visible {
    animation: wcuFadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  /* Stagger delays for text vs image sub-elements once row is visible */
  .wcu-row.is-visible .wcu-text-col {
    animation: wcuFadeUp 0.7s 0.1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .wcu-row.is-visible .wcu-img-col {
    animation: wcuFadeUp 0.7s 0.25s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* ═══════════════════════════════════════
     Responsive — Mobile
  ═══════════════════════════════════════ */
  @media screen and (max-width: 900px) {
    .wcu-row {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    /* Image always on top on mobile */
    .wcu-img-col {
      order: -1 !important;
    }

    .wcu-text-col {
      order: 2 !important;
    }

    .wcu-rows {
      gap: 5rem;
    }

    .wcu-header {
      margin-bottom: 4rem;
    }
  }

  @media screen and (max-width: 600px) {
    #wtp-why-choose-{{ section.id }} {
      padding: 5rem 1.25rem;
    }

    .wcu-img-wrap {
      aspect-ratio: 3 / 2;
    }
  }
{%- endstyle -%}

<section id="wtp-why-choose-{{ section.id }}" aria-label="{{ section.settings.title | escape }}">

  {%- comment -%} ── Section Header ── {%- endcomment -%}
  <div class="wcu-header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="wcu-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="wcu-title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
  </div>

  {%- comment -%} ── Editorial Rows ── {%- endcomment -%}
  <div class="wcu-rows">
    {%- for block in section.blocks -%}
      {%- assign is_flipped = forloop.index0 | modulo: 2 -%}
      <div
        class="wcu-row{% if is_flipped == 1 %} wcu-row--flipped{% endif %}"
        data-wcu-row
        {{ block.shopify_attributes }}
      >

        {%- comment -%} Text Column {%- endcomment -%}
        <div class="wcu-text-col">
          {%- if block.settings.headline != blank -%}
            <h3 class="wcu-row-headline">{{ block.settings.headline | escape }}</h3>
          {%- endif -%}
          <div class="wcu-accent-line" aria-hidden="true"></div>
          {%- if block.settings.description != blank -%}
            <p class="wcu-row-desc">{{ block.settings.description | escape }}</p>
          {%- endif -%}
        </div>

        {%- comment -%} Image Column {%- endcomment -%}
        <div class="wcu-img-col">
          <div class="wcu-img-wrap">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 900px) 45vw, 90vw',
                  alt: block.settings.image.alt | default: block.settings.headline
              }}
            {%- else -%}
              <div class="wcu-img-placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              </div>
            {%- endif -%}
          </div>
        </div>

      </div>
    {%- endfor -%}
  </div>

</section>

<script>
  (function () {
    var rows = document.querySelectorAll('[data-wcu-row]');
    if (!rows.length) return;

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      rows.forEach(function (row) {
        observer.observe(row);
      });
    } else {
      /* Fallback: show all immediately */
      rows.forEach(function (row) {
        row.classList.add('is-visible');
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Why Choose Us",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WE THE PEOPLE ROASTERY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Why Choose Us?"
    }
  ],
  "blocks": [
    {
      "type": "editorial_row",
      "name": "Editorial Row",
      "settings": [
        {
          "type": "text",
          "id": "headline",
          "label": "Row Headline",
          "default": "Crafted With Intention"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Row Description",
          "default": "Every cup we serve begins long before the brew. We source, roast, and serve with a commitment to transparency and quality that you can taste in every sip."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Row Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us",
      "blocks": [
        {
          "type": "editorial_row",
          "settings": {
            "headline": "Crafted With Intention",
            "description": "Every cup we serve begins long before the brew. We source, roast, and serve with a commitment to transparency and quality that you can taste in every sip."
          }
        },
        {
          "type": "editorial_row",
          "settings": {
            "headline": "A Space Made for People",
            "description": "Our cafés are designed as third spaces — places between home and work where community is built, ideas are sparked, and good coffee brings people together."
          }
        },
        {
          "type": "editorial_row",
          "settings": {
            "headline": "Rooted in the Philippines",
            "description": "From our locally sourced ingredients to our Filipino-inspired approach to hospitality, WTP is proudly made here — for the people who call this home."
          }
        }
      ]
    }
  ]
}
{% endschema %}
