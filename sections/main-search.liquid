{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign active_type = 'all'
  if search.types.size == 1
    assign active_type = search.types | first
  endif
-%}

{%- style -%}
  /* ── WTP Search Page ── */
  .wtp-search-page {
    background-color: {{ section.settings.header_bg_color }};
  }

  /* ── Search Header ── */
  .wtp-search-header {
    background-color: {{ section.settings.header_bg_color }};
    color: {{ section.settings.header_text_color }};
    padding: 7rem 5% 5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .wtp-search-eyebrow {
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: {{ section.settings.header_accent_color }};
    margin: 0 0 1.2rem;
    opacity: 0.9;
  }

  .wtp-search-title {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 3rem;
    color: {{ section.settings.header_text_color }};
  }

  /* ── Underline Search Form ── */
  .wtp-search-form-wrap {
    width: 100%;
    max-width: 680px;
    margin: 0 auto 3.5rem;
  }

  .wtp-search-form {
    position: relative;
    display: flex;
    align-items: center;
    border-bottom: 2px solid {{ section.settings.header_text_color }};
    padding-bottom: 0.6rem;
  }

  .wtp-search-form .wtp-search-input {
    flex: 1;
    background: transparent !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    font-family: var(--font-body-family);
    font-size: 1.15rem;
    color: {{ section.settings.header_text_color }};
    padding: 0.3rem 0;
    -webkit-appearance: none;
  }

  .wtp-search-form .wtp-search-input::-webkit-search-decoration,
  .wtp-search-form .wtp-search-input::-webkit-search-cancel-button,
  .wtp-search-form .wtp-search-input::-webkit-search-results-button,
  .wtp-search-form .wtp-search-input::-webkit-search-results-decoration {
    display: none;
  }

  .wtp-search-form .wtp-search-input::placeholder {
    color: {{ section.settings.header_text_color }};
    opacity: 0.5;
  }

  .wtp-search-form .wtp-search-btn,
  .wtp-search-form .wtp-reset-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0 0.5rem;
    color: {{ section.settings.header_text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.75;
    transition: opacity 0.2s ease;
  }

  .wtp-search-form .wtp-search-btn:hover,
  .wtp-search-form .wtp-reset-btn:hover {
    opacity: 1;
  }

  .wtp-search-form .wtp-search-btn svg,
  .wtp-search-form .wtp-reset-btn svg {
    width: 1.8rem;
    height: 1.8rem;
    stroke: currentColor;
    fill: none;
  }

  /* ── Results Count ── */
  .wtp-results-header {
    margin-bottom: 2rem;
  }

  .wtp-results-count {
    font-family: var(--font-body-family);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: #1B3A2D;
    opacity: 0.5;
  }

  /* ── Results Info ── */
  .wtp-search-info {
    font-size: 0.95rem;
    color: {{ section.settings.header_text_color }};
    opacity: 0.7;
    margin-bottom: 0;
  }

  /* ── WTP Pill Tab Nav ── */
  .wtp-search-nav-wrap {
    margin-top: 3rem;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .wtp-search-nav-wrap::-webkit-scrollbar { display: none; }

  .wtp-search-nav {
    display: flex;
    justify-content: center;
    gap: 1rem;
    padding: 0.5rem 5%;
    width: max-content;
    margin: 0 auto;
  }

  .wtp-search-pill {
    padding: 0.75rem 1.8rem;
    border: 1.5px solid {{ section.settings.header_text_color }};
    border-radius: 50px;
    font-family: var(--font-body-family);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: {{ section.settings.header_text_color }};
    transition: all 0.25s ease;
    white-space: nowrap;
    opacity: 0.7;
  }

  .wtp-search-pill:hover,
  .wtp-search-pill.is-active {
    background-color: {{ section.settings.header_text_color }};
    color: {{ section.settings.header_bg_color }};
    opacity: 1;
  }

  /* ── Results Section ── */
  .wtp-search-results {
    background-color: #FDFAF6;
    padding: 5rem 0;
  }

  .wtp-search-results .page-width {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 5%;
  }

  .wtp-results-header {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .wtp-results-count {
    font-family: var(--font-body-family);
    font-size: 0.9rem;
    color: #1B3A2D;
    opacity: 0.6;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* ── Empty State ── */
  .wtp-search-empty {
    text-align: center;
    padding: 8rem 5%;
    background-color: #FDFAF6;
  }

  .wtp-search-empty-title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    color: #1B3A2D;
    margin: 0 0 1rem;
  }

  .wtp-search-empty-sub {
    font-size: 1.1rem;
    color: #1B3A2D;
    opacity: 0.6;
    line-height: 1.7;
    margin: 0 auto;
    max-width: 500px;
  }

  /* ── Override Dawn native search styles on the template search form ── */
  .wtp-search-form-wrap .field {
    border: none !important;
    box-shadow: none !important;
    background: transparent !important;
    padding: 0 !important;
  }

  .wtp-search-form-wrap .field::before,
  .wtp-search-form-wrap .field::after {
    display: none !important;
  }

  .wtp-search-form-wrap .search__input,
  .wtp-search-form-wrap .field__input {
    border: none !important;
    box-shadow: none !important;
    outline: none !important;
    background: transparent !important;
  }

  .wtp-search-form-wrap .field__label {
    display: none !important;
  }

  /* ── Grid Card Refinements ── */
  .wtp-search-results .grid__item .card__media,
  .wtp-search-results .grid__item .media img,
  .wtp-search-results .grid__item .media {
    border-radius: 24px !important;
    overflow: hidden !important;
  }

  /* Ensure square aspect ratio across all types */
  .wtp-search-results .grid__item .card--media .card__inner,
  .wtp-search-results .grid__item .card--text,
  .wtp-search-results .grid__item .ratio {
    aspect-ratio: 1/1 !important;
    --ratio-percent: 100% !important;
  }

  .wtp-search-results .grid__item .card__heading,
  .wtp-search-results .grid__item .card__heading a {
    font-family: var(--font-heading-family) !important;
    color: #1B3A2D !important;
    text-decoration: none !important;
    transition: color 0.3s ease;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.2;
    margin-top: 1.2rem;
  }

  .wtp-search-results .grid__item:hover .card__heading,
  .wtp-search-results .grid__item:hover .card__heading a {
    color: #C8A96E !important;
    text-decoration: none !important;
  }

  /* Coordinated "Page" Card Design (Dark Green + Gold) */
  .wtp-search-results .article-card-wrapper .card--page-item {
    background-color: #1B3A2D !important; /* Forest Green */
    border-radius: 24px !important;
    padding: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    transition: transform 0.3s ease;
  }

  .wtp-search-results .article-card-wrapper .card--page-item:hover {
    transform: translateY(-5px);
  }

  .wtp-search-results .article-card-wrapper .card--page-item .card__heading,
  .wtp-search-results .article-card-wrapper .card--page-item .card__heading a {
    color: #C8A96E !important; /* Gold */
    font-family: var(--font-heading-family) !important;
    font-size: 1.6rem;
    margin: 0;
  }

  .wtp-search-results .article-card-wrapper .card--page-item .badge {
    background: rgba(200, 169, 110, 0.15) !important;
    color: #C8A96E !important;
    border: 1px solid rgba(200, 169, 110, 0.3);
    font-size: 0.7rem;
    padding: 0.4rem 1rem;
    margin-top: 1.5rem;
    font-weight: 600;
  }

  /* Article Card Refinements */
  .wtp-search-results .article-card-wrapper .article-card__info {
    font-size: 0.75rem;
    opacity: 0.6;
    margin: 0.8rem 0;
    color: #1B3A2D;
    font-weight: 600;
  }

  .wtp-search-results .article-card-wrapper .article-card__excerpt {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #1B3A2D;
    opacity: 0.8;
    margin-bottom: 1.5rem;
  }

  .wtp-search-results .wtp-read-more {
    color: #C8A96E !important;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    letter-spacing: 0.1em;
  }

  .wtp-search-results .price,
  .wtp-search-results .price--on-sale .price-item--last {
    color: #1B3A2D !important;
    font-family: var(--font-body-family);
    opacity: 0.8;
    font-weight: 600;
    margin-top: 0.5rem;
  }

  @media screen and (max-width: 749px) {
    .wtp-search-header {
      padding: 6rem 5% 4rem;
    }
    .wtp-search-title {
      font-size: clamp(2rem, 6vw, 3rem);
    }
    .wtp-results-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% paginate search.results by 24 %}

<div class="wtp-search-page">

  {%- comment -%} ── WTP Search Header ── {%- endcomment -%}
  <div class="wtp-search-header">
    <p class="wtp-search-eyebrow">Discover</p>

    {%- if search.performed -%}
      <h1 class="wtp-search-title">
        {%- if search.results_count > 0 -%}
          Results for "{{ search.terms | escape }}"
        {%- else -%}
          No results for "{{ search.terms | escape }}"
        {%- endif -%}
      </h1>
    {%- else -%}
      <h1 class="wtp-search-title">Search</h1>
    {%- endif -%}

    {%- comment -%} ── Clean Underline Search Form ── {%- endcomment -%}
    <div class="wtp-search-form-wrap">
      {%- if settings.predictive_search_enabled -%}
        <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
      {%- endif -%}
      <main-search>
        <form action="{{ routes.search_url }}" method="get" role="search" class="wtp-search-form">
          <input
            class="wtp-search-input"
            id="Search-In-Template"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.search' | t }}"
            {%- if settings.predictive_search_enabled -%}
              role="combobox"
              aria-expanded="false"
              aria-owns="predictive-search-results"
              aria-controls="predictive-search-results"
              aria-haspopup="listbox"
              aria-autocomplete="list"
              autocorrect="off"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
            {%- endif -%}
          >
          <input name="options[prefix]" type="hidden" value="last">
          {%- if active_type != 'all' -%}
            <input type="hidden" name="type" value="{{ active_type }}">
          {%- endif -%}

          {%- if settings.predictive_search_enabled -%}
            <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
              {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
            </div>
            <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
          {%- endif -%}

          <button
            type="reset"
            class="wtp-reset-btn{% if search.terms == blank %} hidden{% endif %}"
            aria-label="{{ 'general.search.reset' | t }}"
          >
            <span class="svg-wrapper">{{- 'icon-reset.svg' | inline_asset_content -}}</span>
          </button>
          <button type="submit" class="wtp-search-btn" aria-label="{{ 'general.search.search' | t }}">
            <span class="svg-wrapper">{{- 'icon-search.svg' | inline_asset_content -}}</span>
          </button>
        </form>
      </main-search>
      {%- if settings.predictive_search_enabled -%}
        </predictive-search>
      {%- endif -%}
    </div>

    {%- if search.performed and search.results_count > 0 -%}
      <p class="wtp-search-info">
        {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}
      </p>
    {%- endif -%}

    {%- comment -%} ── WTP Pill Tab Filters ── {%- endcomment -%}
    {%- if search.performed -%}
      <div class="wtp-search-nav-wrap">
        <nav class="wtp-search-nav" aria-label="Filter search results by type">
          <a
            href="?q={{ search.terms | escape }}&options%5Bprefix%5D=last"
            class="wtp-search-pill{% if active_type == 'all' or active_type == '' %} is-active{% endif %}"
          >All</a>
          <a
            href="?q={{ search.terms | escape }}&options%5Bprefix%5D=last&type=product"
            class="wtp-search-pill{% if active_type == 'product' %} is-active{% endif %}"
          >Products</a>
          <a
            href="?q={{ search.terms | escape }}&options%5Bprefix%5D=last&type=article"
            class="wtp-search-pill{% if active_type == 'article' %} is-active{% endif %}"
          >Blog Posts</a>
          <a
            href="?q={{ search.terms | escape }}&options%5Bprefix%5D=last&type=page"
            class="wtp-search-pill{% if active_type == 'page' %} is-active{% endif %}"
          >Pages</a>
        </nav>
      </div>
    {%- endif -%}
  </div>{%- comment -%}end wtp-search-header{%- endcomment -%}

  {%- comment -%} ── Results or Empty State ── {%- endcomment -%}
  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      <div class="wtp-search-results section-{{ section.id }}-padding">
        <div class="page-width">

          <div class="wtp-results-header">
            <span class="wtp-results-count">
              {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}
            </span>
          </div>

          <div class="product-grid-container" id="ProductGridContainer">
            <div
              class="template-search__results collection page-width"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>
              <ul
                class="grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
                role="list"
              >
                {%- assign skip_card_product_styles = false -%}
                {%- for item in search.results -%}
                  {% assign lazy_load = false %}
                  {%- if forloop.index > 2 -%}
                    {%- assign lazy_load = true -%}
                  {%- endif -%}

                  <li
                    class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}data-cascade{% endif %}
                  >
                    {%- case item.object_type -%}
                      {%- when 'product' -%}
                        {% render 'card-product',
                          card_product: item,
                          media_aspect_ratio: 'square',
                          image_shape: section.settings.image_shape,
                          show_secondary_image: section.settings.show_secondary_image,
                          show_vendor: section.settings.show_vendor,
                          show_rating: section.settings.show_rating,
                          lazy_load: lazy_load,
                          skip_styles: skip_card_product_styles
                        %}
                        {%- assign skip_card_product_styles = true -%}
                      {%- when 'article' -%}
                        {% render 'article-card',
                          article: item,
                          show_image: true,
                          show_date: section.settings.article_show_date,
                          show_author: section.settings.article_show_author,
                          show_badge: true,
                          media_aspect_ratio: 1,
                          lazy_load: lazy_load
                        %}
                      {%- when 'page' -%}
                        <div class="article-card-wrapper card-wrapper">
                          <div
                            class="card card--page-item ratio"
                            style="--ratio-percent: 100%;"
                          >
                            <div class="card__content">
                              <div class="card__information">
                                <h3 class="card__heading">
                                  <a href="{{ item.url }}" class="full-unstyled-link">
                                    {{ item.title | escape }}
                                  </a>
                                </h3>
                              </div>
                              <div class="card__badge {{ settings.badge_position }}">
                                <span class="badge">
                                  {{- 'templates.search.page' | t -}}
                                </span>
                              </div>
                            </div>
                          </div>
                        </div>
                    {%- endcase -%}
                  </li>
                {%- endfor -%}
              </ul>

              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate %}
              {%- endif -%}
            </div>
          </div>

        </div>
      </div>
    {%- else -%}
      {%- comment -%} ── Empty / No Results ── {%- endcomment -%}
      <div class="wtp-search-empty">
        <h2 class="wtp-search-empty-title">Nothing found</h2>
        <p class="wtp-search-empty-sub">
          We couldn't find any results for "{{ search.terms | escape }}". Try checking your spelling or using different keywords.
        </p>
      </div>
    {%- endif -%}
  {%- else -%}
    {%- comment -%} ── Pre-search state ── {%- endcomment -%}
    <div class="wtp-search-empty">
      <p class="wtp-search-empty-sub">Type above to begin searching the WTP Coffee store.</p>
    </div>
  {%- endif -%}

</div>

{% endpaginate %}

{% if section.settings.image_shape == 'arch' %}
  {{ 'mask-arch.svg' | inline_asset_content }}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-search.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Search Header Design"
    },
    {
      "type": "color",
      "id": "header_bg_color",
      "label": "Header Background",
      "default": "#1B3A2D"
    },
    {
      "type": "color",
      "id": "header_text_color",
      "label": "Header Text Color",
      "default": "#F5F0E8"
    },
    {
      "type": "color",
      "id": "header_accent_color",
      "label": "Eyebrow Accent Color",
      "default": "#C8A96E"
    },
    {
      "type": "header",
      "content": "Product Cards"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-search.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-search.settings.columns_mobile.label",
      "options": [
        { "value": "1", "label": "t:sections.main-search.settings.columns_mobile.options__1.label" },
        { "value": "2", "label": "t:sections.main-search.settings.columns_mobile.options__2.label" }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.main-search.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "t:sections.main-search.settings.image_ratio.options__1.label" },
        { "value": "portrait", "label": "t:sections.main-search.settings.image_ratio.options__2.label" },
        { "value": "square", "label": "t:sections.main-search.settings.image_ratio.options__3.label" }
      ],
      "default": "adapt",
      "label": "t:sections.main-search.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        { "value": "default", "label": "t:sections.all.image_shape.options__1.label" },
        { "value": "arch", "label": "t:sections.all.image_shape.options__2.label" },
        { "value": "blob", "label": "t:sections.all.image_shape.options__3.label" },
        { "value": "chevronleft", "label": "t:sections.all.image_shape.options__4.label" },
        { "value": "chevronright", "label": "t:sections.all.image_shape.options__5.label" },
        { "value": "diamond", "label": "t:sections.all.image_shape.options__6.label" },
        { "value": "parallelogram", "label": "t:sections.all.image_shape.options__7.label" },
        { "value": "round", "label": "t:sections.all.image_shape.options__8.label" }
      ],
      "default": "default",
      "label": "t:sections.all.image_shape.label"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.main-search.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
