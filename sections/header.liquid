<style>
  /* ─── Dawn baseline ──────────────────────────────────────────────── */
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer { display: none; }
    }
  {%- endif -%}

  .menu-drawer-container { display: flex; }
  .list-menu { list-style: none; padding: 0; margin: 0; }
  .list-menu--inline { display: inline-flex; flex-wrap: wrap; }
  summary.list-menu__item { padding-right: 2.7rem; }
  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }
  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }
  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  /* ═══════════════════════════════════════════════════════════════════
     SCROLL-MORPHING ISLAND HEADER
     ═══════════════════════════════════════════════════════════════════

     STATE 1 — At top:
       Full-width, flat white, flush to top edge.
       Logo far-left · icons far-right (natural page-width grid).

     STATE 2 — Scrolled (JS adds .wtp-scrolled):
       Shrinks to max-width island, snaps 1.5rem from top,
       glassmorphism, rounded pill, items drawn closer together.

     All transitions are CSS — JS only toggles one class.
  ════════════════════════════════════════════════════════════════════ */

  /* ── Section wrapper: always fixed, pointer-events off outside pill */
  .section-header {
    position: fixed !important;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    pointer-events: none;
    /* animate vertical offset when snapping to island */
    transition: top 0.55s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Transparent pass-through wrapper */
  .header-wrapper {
    background: transparent !important;
    border-bottom: none !important;
    box-shadow: none !important;
    pointer-events: none;
    /* Wrapper handles the centering so the island can scale from its middle smoothly */
    display: flex;
    justify-content: center;
  }

  /* ── THE HEADER PILL ── */
  .header {
    /* Layout */
    width: 100%;
    max-width: 100%;
    margin: 0 !important;
    pointer-events: all;

    /* GPU hint for composited transitions */
    will-change: max-width, border-radius, background, backdrop-filter, box-shadow;

    /* STATE 1: flat white, flush, wide padding */
    background: rgba(255, 255, 255, 1) !important;
    border-radius: 0 !important;
    border: none !important;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.07) !important;
    backdrop-filter: blur(0px) saturate(100%);
    -webkit-backdrop-filter: blur(0px) saturate(100%);

    /* Smooth transitions for every morphing property — all one declaration */
    transition:
      max-width     0.6s cubic-bezier(0.25, 1, 0.5, 1),
      width         0.6s cubic-bezier(0.25, 1, 0.5, 1),
      margin        0.6s cubic-bezier(0.25, 1, 0.5, 1),
      border-radius 0.6s cubic-bezier(0.25, 1, 0.5, 1),
      padding       0.5s cubic-bezier(0.25, 1, 0.5, 1),
      background    0.5s ease,
      box-shadow    0.5s ease,
      backdrop-filter 0.5s ease !important;
  }

  /* ─── Centering & Layout Fix ─── */
  @media screen and (min-width: 990px) {
    .header {
      display: grid !important;
      grid-template-areas: 'logo navigation icons' !important;
      grid-template-columns: 1fr auto 1fr !important;
      align-items: center;
    }

    .header__heading,
    header > .header__heading-link,
    .header__heading-logo-wrapper,
    header-drawer {
      grid-area: logo;
      justify-self: start;
    }

    .header__inline-menu {
      grid-area: navigation;
      justify-self: center;
      display: flex;
      justify-content: center;
      width: 100%;
    }

    .header__icons,
    details-modal.header__search {
      grid-area: icons;
      justify-self: end;
    }
  }

  /* ── STATE 2: Scrolled → compact glassmorphic island ── */
  .section-header.wtp-scrolled {
    top: 1.5rem;
  }

  .section-header.wtp-scrolled .header {
    width: calc(100% - 3rem); /* breathing room on narrow viewports */
    border-radius: 50px !important;

  }

  /* ── Compact Logo in Island State ── */
  .section-header .header__heading-logo {
    /* Base width fallback */
    width: {{ settings.logo_width | default: 100 }}px;
    transition: width 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: width;
  }



  /* ── HOVER PILL (sliding nav indicator) ── */
  .header__inline-menu {
    position: relative;
  }

  .wtp-hover-pill {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    height: 32px;
    border-radius: 50px;
    pointer-events: none;
    opacity: 0;
    transition:
      opacity 0.2s ease,
      left    0.32s cubic-bezier(0.15, 1, 0.85, 1),
      width   0.32s cubic-bezier(0.15, 1, 0.85, 1);
  }

  /* Only show hover pill in island state */
  .section-header:not(.wtp-scrolled) .wtp-hover-pill {
    display: none;
  }

  /* ── MOBILE ── */
  @media screen and (max-width: 989px) {
    .section-header.wtp-scrolled {
      top: 0.75rem;
    }

    .section-header.wtp-scrolled .header {
      max-width: calc(100vw - 1.25rem);
      border-radius: 28px !important;
    }
  }

  /* ── UNDERLINE REFINEMENT ── */
  .header__menu-item,
  .header__menu-item:hover,
  .header__menu-item:focus,
  .header__menu-item:active,
  .list-menu__item--active,
  .header__active-menu-item,
  .header__menu-item span {
    text-decoration: none !important;
    position: relative;
    font-size: 1.6rem;
    font-weight: 500;
  }

  .header__menu-item span {
    position: relative;
    padding-bottom: 2px;
  }

  /* The smoother underline */
  .header__menu-item span::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    width: 0;
    height: 1.5px;
    background: currentColor;
    transition: width 0.4s cubic-bezier(0.25, 1, 0.5, 1), left 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    opacity: 0.8;
  }

  .header__menu-item:hover span::after {
    width: 100%;
    left: 0;
  }

  /* Ensure active state doesn't show the underline unless hovered */
  .header__active-menu-item::after { display: none !important; }
  .list-menu__item--active::after { display: none !important; }

  /* ── MAIN CONTENT OFFSET ── */
  /* Push pages down by half the navigation's height to prevent full overlay, as requested */
  main#MainContent {
    padding-top: calc(var(--header-height, 90px));
  }

  /* ── MOBILE MENU OPEN: FLUSH STATE (Top of Page) ── */
  .section-header.wtp-menu-open {
    top: 0 !important;
    --drawer-shadow-opacity: 0 !important;
    --popup-shadow-opacity: 0 !important;
    --inputs-shadow-opacity: 0 !important;
    --buttons-shadow-opacity: 0 !important;
  }

  .section-header.wtp-menu-open:not(.wtp-scrolled) .header {
    background: rgb(var(--color-background)) !important;
    border-radius: 0 !important;
    max-width: 100% !important;
    width: 100% !important;
    padding-top: 1.25rem !important;
    padding-bottom: 1.25rem !important;
    box-shadow: none !important;
    border: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  .section-header.wtp-menu-open:not(.wtp-scrolled) .header__menu-item,
  .section-header.wtp-menu-open:not(.wtp-scrolled) .header__menu-item span,
  .section-header.wtp-menu-open:not(.wtp-scrolled) .header__heading-link,
  .section-header.wtp-menu-open:not(.wtp-scrolled) .header__icon,
  .section-header.wtp-menu-open:not(.wtp-scrolled) .header__icon svg {
    color: #ffffff !important;
  }

  /* Force white text/icons inside the menu drawer in flush state */
  .section-header.wtp-menu-open:not(.wtp-scrolled) .menu-drawer,
  .section-header.wtp-menu-open:not(.wtp-scrolled) .menu-drawer a,
  .section-header.wtp-menu-open:not(.wtp-scrolled) .menu-drawer span,
  .section-header.wtp-menu-open:not(.wtp-scrolled) .menu-drawer .header__menu-item,
  .section-header.wtp-menu-open:not(.wtp-scrolled) .menu-drawer account-icon > .svg-wrapper,
  .section-header.wtp-menu-open:not(.wtp-scrolled) .menu-drawer svg,
  .section-header.wtp-menu-open:not(.wtp-scrolled) .menu-drawer .localization-selector {
    color: #ffffff !important;
    fill: #ffffff !important;
  }

  .section-header.wtp-menu-open:not(.wtp-scrolled) .header__icon .svg-wrapper svg path,
  .section-header.wtp-menu-open:not(.wtp-scrolled) .menu-drawer svg path {
    fill: currentColor !important;
  }
</style>

{%- style -%}
  /* Default (top) header padding — wide & spacious */
  .header {
    padding: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px 3rem {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px 3rem;
  }

  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Island state: tighter padding to compress items closer together */
  .section-header.wtp-scrolled .header {
    max-width: calc(100% - 3rem) !important;
    padding: 0.4rem 1.4rem !important;
    background: rgba({{ section.settings.island_bg_color.red }}, {{ section.settings.island_bg_color.green }}, {{ section.settings.island_bg_color.blue }}, {{ section.settings.island_opacity | divided_by: 100.0 }}) !important;
    backdrop-filter: blur({{ section.settings.island_blur }}px) saturate(200%);
    -webkit-backdrop-filter: blur({{ section.settings.island_blur }}px) saturate(200%);
    border: 1px solid rgba({{ section.settings.island_bg_color.red }}, {{ section.settings.island_bg_color.green }}, {{ section.settings.island_bg_color.blue }}, 0.35) !important;
    box-shadow:
      0 2px 16px rgba({{ section.settings.island_bg_color.red }}, {{ section.settings.island_bg_color.green }}, {{ section.settings.island_bg_color.blue }}, 0.25),
      0 6px 32px rgba({{ section.settings.island_bg_color.red }}, {{ section.settings.island_bg_color.green }}, {{ section.settings.island_bg_color.blue }}, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.20) !important;
  }

  /* Remove shadow and borders from island header & wrapper when menu is open */
  .section-header.wtp-menu-open .header-wrapper,
  .section-header.wtp-scrolled.wtp-menu-open .header {
    box-shadow: none !important;
    border: none !important;
  }

  /* Dynamic logo sizing */
  .section-header.wtp-scrolled .header__heading-logo {
    width: calc({{ settings.logo_width | default: 100 }}px * {{ section.settings.island_logo_scale | divided_by: 100.0 }}) !important;
  }

  /* Dynamic Island Text & Icon Colors */
  .section-header.wtp-scrolled .header__menu-item,
  .section-header.wtp-scrolled .header__menu-item span,
  .section-header.wtp-scrolled .header__active-menu-item,
  .section-header.wtp-scrolled .header__heading-link,
  .section-header.wtp-scrolled .header__icon,
  .section-header.wtp-scrolled .header__icon svg {
    color: {{ section.settings.island_text_color }} !important;
  }

  .section-header.wtp-scrolled .header__icon .svg-wrapper svg path {
    fill: currentColor;
  }

  /* ── MOBILE MENU OPEN: PILL STATE (Scrolled) ── */
  /* Target the drawer itself to become a floating glass pill */
  .section-header.wtp-scrolled.wtp-menu-open .menu-drawer {
    height: auto !important;
    max-height: calc(100vh - 120px) !important;
    margin-top: 0.5rem;
    border-radius: 28px !important;
    background: rgba({{ section.settings.island_bg_color.red }}, {{ section.settings.island_bg_color.green }}, {{ section.settings.island_bg_color.blue }}, {{ section.settings.island_opacity | divided_by: 100.0 }}) !important;
    backdrop-filter: blur({{ section.settings.island_blur }}px) saturate(200%);
    -webkit-backdrop-filter: blur({{ section.settings.island_blur }}px) saturate(200%);
    border: 1px solid rgba({{ section.settings.island_bg_color.red }}, {{ section.settings.island_bg_color.green }}, {{ section.settings.island_bg_color.blue }}, 0.35) !important;
    box-shadow: none !important;
    filter: none !important;
    -webkit-filter: none !important;
  }

  /* Force all text variants inside the floating drawer pill to match */
  .section-header.wtp-scrolled.wtp-menu-open .menu-drawer,
  .section-header.wtp-scrolled.wtp-menu-open .menu-drawer a,
  .section-header.wtp-scrolled.wtp-menu-open .menu-drawer span,
  .section-header.wtp-scrolled.wtp-menu-open .menu-drawer .header__menu-item,
  .section-header.wtp-scrolled.wtp-menu-open .menu-drawer account-icon > .svg-wrapper,
  .section-header.wtp-scrolled.wtp-menu-open .menu-drawer svg {
    color: {{ section.settings.island_text_color }} !important;
    fill: {{ section.settings.island_text_color }} !important;
  }

  .section-header.wtp-scrolled.wtp-menu-open .menu-drawer svg path {
    fill: currentColor !important;
  }

  /* Hide Dawn's native semi-transparent overlay entirely */
  header-drawer > details > summary::before,
  header-drawer > details[open] > summary::before,
  menu-drawer > details > summary::before,
  menu-drawer > details[open] > summary::before {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
  }

  /* ── PAGE CONTENT BLUR (workaround for backdrop-filter stacking context trap) ── */
  /*
   * backdrop-filter on the pill header creates a stacking context that traps
   * any fixed overlay child. Instead, we blur the actual page content directly.
   * The header itself is always on top and unaffected.
   */
  body.wtp-blur-content #MainContent,
  body.wtp-blur-content .shopify-section:not(.section-header) {
    filter: blur(8px);
    -webkit-filter: blur(8px);
    transform: scale(1.03); /* prevent blurry edge shadows on viewport */
    transition: filter 0.35s ease, transform 0.35s ease;
    pointer-events: none;
    user-select: none;
    overflow-x: hidden;
  }

  /* Smooth transition back when menu closes */
  #MainContent,
  .shopify-section:not(.section-header) {
    transition: filter 0.35s ease, transform 0.35s ease;
  }

  /* ── SEARCH MODAL STYLING (Glassmorphic Alignment) ── */
  .section-header .search-modal,
  .section-header .search-modal__content,
  .section-header details[open] > .search-modal,
  .section-header details[open] > .search-modal .search-modal__content {
    background: transparent !important;
    box-shadow: none !important;
    border: none !important;
  }

  /* Kill search modal's native dark background overlay pseudo-elements */
  .section-header .search-modal .modal-overlay,
  .section-header .search-modal .modal-overlay::after,
  .section-header .search-modal .modal-overlay::before,
  .section-header details[open] .search-modal .modal-overlay,
  .section-header details[open] .search-modal .modal-overlay::after,
  .section-header details[open] .search-modal .modal-overlay::before {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
  }

  /* Clean search state: hide navigation and icons when search is active */
  .section-header:has(details-modal details[open]) .header__inline-menu,
  .section-header:has(details-modal details[open]) header-drawer,
  .section-header:has(details-modal details[open]) .header__heading,
  .section-header:has(details-modal details[open]) .header__heading-link,
  .section-header:has(details-modal details[open]) .header__heading-logo-wrapper,
  .section-header:has(details-modal details[open]) .header__icon--account,
  .section-header:has(details-modal details[open]) .header__icon--cart,
  .section-header:has(details-modal details[open]) .localization-form,
  .section-header details-modal details[open] > summary {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  @media screen and (max-width: 989px) {
    .section-header .search-modal .search__button {
      display: none !important;
    }
    
    /* Ensure heading is hidden on mobile when search is open regardless of :has support */
    .section-header:has(details-modal details[open]) .header__heading,
    .section-header:has(details-modal details[open]) .header__heading-link {
      display: none !important;
    }
  }

  /* ── Ghost box fix: strip native field pseudo-elements & focus rings ── */
  .section-header .search-modal .field::before,
  .section-header .search-modal .field::after {
    display: none !important;
    border: none !important;
    box-shadow: none !important;
  }
  .section-header .search-modal .search__input:focus,
  .section-header .search-modal .field__input:focus,
  .section-header .search-modal .search__input:focus-visible,
  .section-header .search-modal .field__input:focus-visible {
    outline: none !important;
    box-shadow: none !important;
  }

  /* ── 1. SEARCH INPUT & MODAL (Scrolled Pill State) ── */
  .section-header.wtp-scrolled .search-modal .search__input,
  .section-header.wtp-scrolled details[open] .search-modal .search__input,
  .section-header.wtp-scrolled details[open] .search-modal .field__input {
    background: rgba(255, 255, 255, 0.08) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    border-radius: 50px !important;
    color: {{ section.settings.island_text_color }} !important;
    box-shadow: none !important;
    -webkit-appearance: none !important;
  }

  .section-header.wtp-scrolled .search-modal .search__input::placeholder,
  .section-header.wtp-scrolled details[open] .search-modal .search__input::placeholder,
  .section-header.wtp-scrolled .search-modal .field__label,
  .section-header.wtp-scrolled details[open] .search-modal .field__label {
    color: rgba({{ section.settings.island_text_color.red }}, {{ section.settings.island_text_color.green }}, {{ section.settings.island_text_color.blue }}, 0.7) !important;
  }

  .section-header.wtp-scrolled .search-modal .search__button,
  .section-header.wtp-scrolled .search-modal .search__button svg,
  .section-header.wtp-scrolled .search-modal .reset__button,
  .section-header.wtp-scrolled .search-modal .reset__button svg,
  .section-header.wtp-scrolled .search-modal .modal__close-button,
  .section-header.wtp-scrolled .search-modal .modal__close-button svg {
    color: {{ section.settings.island_text_color }} !important;
  }

  /* ── 2. PREDICTIVE SEARCH (Scrolled Pill State) ── */
  .section-header.wtp-scrolled .predictive-search {
    background: rgba({{ section.settings.island_bg_color.red }}, {{ section.settings.island_bg_color.green }}, {{ section.settings.island_bg_color.blue }}, 0.85) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    border-radius: 20px !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2) !important;
    margin-top: 1rem !important;
  }

  .section-header.wtp-scrolled .predictive-search .predictive-search__heading,
  .section-header.wtp-scrolled .predictive-search .predictive-search__item-heading,
  .section-header.wtp-scrolled .predictive-search .predictive-search__item-vendor,
  .section-header.wtp-scrolled .predictive-search .predictive-search__item .price,
  .section-header.wtp-scrolled .predictive-search .predictive-search__item-query-result *:not(mark),
  .section-header.wtp-scrolled .predictive-search .predictive-search__item--term {
    color: {{ section.settings.island_text_color }} !important;
  }

  .section-header.wtp-scrolled .predictive-search .predictive-search__item-query-result mark {
    color: rgba({{ section.settings.island_text_color.red }}, {{ section.settings.island_text_color.green }}, {{ section.settings.island_text_color.blue }}, 0.75) !important;
    background: transparent !important;
  }

  .section-header.wtp-scrolled .predictive-search .predictive-search__list-item:hover > *,
  .section-header.wtp-scrolled .predictive-search .predictive-search__item:hover,
  .section-header.wtp-scrolled .predictive-search .predictive-search__list-item[aria-selected="true"] > *,
  .section-header.wtp-scrolled .predictive-search .predictive-search__item[aria-selected="true"] {
    background-color: rgba(255, 255, 255, 0.1) !important;
  }

  .section-header.wtp-scrolled .predictive-search__results-groups-wrapper,
  .section-header.wtp-scrolled .predictive-search__heading {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
  }

  .section-header.wtp-scrolled .predictive-search .spinner {
    color: {{ section.settings.island_text_color }} !important;
  }

  /* ── 3. SEARCH INPUT & MODAL (Flush State) ── */
  .section-header:not(.wtp-scrolled) .search-modal .search__input,
  .section-header:not(.wtp-scrolled) details[open] .search-modal .search__input,
  .section-header:not(.wtp-scrolled) details[open] .search-modal .field__input {
    background: rgba(0, 0, 0, 0.04) !important;
    border: 1px solid rgba(0, 0, 0, 0.1) !important;
    border-radius: 50px !important;
    color: rgb(var(--color-foreground)) !important;
    box-shadow: none !important;
    -webkit-appearance: none !important;
  }

  .section-header:not(.wtp-scrolled) .search-modal .search__input::placeholder,
  .section-header:not(.wtp-scrolled) details[open] .search-modal .search__input::placeholder,
  .section-header:not(.wtp-scrolled) .search-modal .field__label,
  .section-header:not(.wtp-scrolled) details[open] .search-modal .field__label {
    color: rgba(var(--color-foreground), 0.7) !important;
  }

  .section-header:not(.wtp-scrolled) .search-modal .search__button,
  .section-header:not(.wtp-scrolled) .search-modal .search__button svg,
  .section-header:not(.wtp-scrolled) .search-modal .reset__button,
  .section-header:not(.wtp-scrolled) .search-modal .reset__button svg,
  .section-header:not(.wtp-scrolled) .search-modal .modal__close-button,
  .section-header:not(.wtp-scrolled) .search-modal .modal__close-button svg {
    color: rgb(var(--color-foreground)) !important;
  }

  /* ── 4. PREDICTIVE SEARCH (Flush State) ── */
  .section-header:not(.wtp-scrolled) .predictive-search {
    background: rgba(255, 255, 255, 0.95) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    border: 1px solid rgba(0, 0, 0, 0.1) !important;
    border-radius: 20px !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1) !important;
    margin-top: 1rem !important;
  }

  .section-header:not(.wtp-scrolled) .predictive-search .predictive-search__heading,
  .section-header:not(.wtp-scrolled) .predictive-search .predictive-search__item-heading,
  .section-header:not(.wtp-scrolled) .predictive-search .predictive-search__item-vendor,
  .section-header:not(.wtp-scrolled) .predictive-search .predictive-search__item .price,
  .section-header:not(.wtp-scrolled) .predictive-search .predictive-search__item-query-result *:not(mark),
  .section-header:not(.wtp-scrolled) .predictive-search .predictive-search__item--term {
    color: rgb(var(--color-foreground)) !important;
  }

  .section-header:not(.wtp-scrolled) .predictive-search .predictive-search__item-query-result mark {
    color: rgba(var(--color-foreground), 0.75) !important;
    background: transparent !important;
  }

  .section-header:not(.wtp-scrolled) .predictive-search .predictive-search__list-item:hover > *,
  .section-header:not(.wtp-scrolled) .predictive-search .predictive-search__item:hover,
  .section-header:not(.wtp-scrolled) .predictive-search .predictive-search__list-item[aria-selected="true"] > *,
  .section-header:not(.wtp-scrolled) .predictive-search .predictive-search__item[aria-selected="true"] {
    background-color: rgba(0, 0, 0, 0.05) !important;
  }

  .section-header:not(.wtp-scrolled) .predictive-search__results-groups-wrapper,
  .section-header:not(.wtp-scrolled) .predictive-search__heading {
    border-bottom: 1px solid rgba(0, 0, 0, 0.1) !important;
  }

  .section-header:not(.wtp-scrolled) .predictive-search .spinner {
    color: rgb(var(--color-foreground)) !important;
  }

  /* Dynamic hover pill */
  .wtp-hover-pill {
    background: rgba({{ section.settings.hover_pill_color.red }}, {{ section.settings.hover_pill_color.green }}, {{ section.settings.hover_pill_color.blue }}, {{ section.settings.hover_pill_opacity | divided_by: 100.0 }});
  }

  /* ── CART BUBBLE POP ANIMATION ── */
  @keyframes cart-pop {
    0% { transform: scale(0.5); opacity: 0; }
    50% { transform: scale(1.25); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
  }

  .cart-count-bubble.is-popping {
    animation: cart-pop 0.5s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  .cart-count-bubble {
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }

  /* Flush state: Dark Green background, Light Cream text */
  .section-header:not(.wtp-scrolled) .cart-count-bubble {
    background-color: #1B3A2D !important;
    color: #F5F0E8 !important;
  }

  /* Pill state: Light Cream background, Dark Green text */
  .section-header.wtp-scrolled .cart-count-bubble {
    background-color: #F5F0E8 !important;
    color: #1B3A2D !important;
  }
{%- endstyle -%}

