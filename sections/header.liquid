{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.headerIsAlwaysSticky =
        this.getAttribute('data-sticky-type') === 'always' ||
        this.getAttribute('data-sticky-type') === 'reduce-logo-size';
      this.headerBounds = {};

      this.setHeaderHeight();

      window.matchMedia('(max-width: 990px)').addEventListener('change', this.setHeaderHeight.bind(this));

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add('shopify-section-header-sticky');
      }

      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => (this.preventReveal = true);

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
    }

    setHeaderHeight() {
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });
      observer.observe(this.header);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (this.preventHide) return;
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);
          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);
          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
      this.closeMenuDisclosure();
      this.closeSearchModal();
    }

    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }

    closeMenuDisclosure() {
      this.disclosures = this.disclosures || this.header.querySelectorAll('header-menu');
      this.disclosures.forEach((disclosure) => disclosure.close());
    }

    closeSearchModal() {
      this.searchModal = this.searchModal || this.header.querySelector('details-modal');
      this.searchModal.close(false);
    }
  }

  customElements.define('sticky-header', StickyHeader);
{% endjavascript %}

<!--
  ═══════════════════════════════════════════════════════════════════
       SCROLL-MORPH ENGINE
       Toggles .wtp-scrolled on .section-header to drive the CSS morph.
       Also injects the hover-pill for the island nav links.
  ════════════════════════════════════════════════════════════════════
-->
<script>
  (function () {
    'use strict';

    /* ─── 1. Scroll-morph toggle with hysteresis ───────────────────── */
    /*
     * Two thresholds prevent oscillation / jitter near the snap point:
     *   ACTIVATE  — scrolled far enough down → snap into island
     *   DEACTIVATE — scrolled back close to top → revert to flat bar
     * Because DEACTIVATE < ACTIVATE, the header "latches" until the
     * user has clearly returned to the top, giving a smooth revert.
     */
    var ACTIVATE = 80; /* px — snap into island */
    var DEACTIVATE = 16; /* px — revert to flat bar */
    var section = document.querySelector('.section-header');
    var isIsland = false;

    function onScroll() {
      if (!section) return;
      var y = window.scrollY;
      if (!isIsland && y > ACTIVATE) {
        isIsland = true;
        section.classList.add('wtp-scrolled');
      } else if (isIsland && y < DEACTIVATE) {
        isIsland = false;
        section.classList.remove('wtp-scrolled');
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll(); /* evaluate on load (e.g. hard-refresh mid-page) */

    /* ─── 2. Hover-pill for desktop nav links ──────────────────────── */
    function initHoverPill() {
      var nav = document.querySelector('.header__inline-menu');
      if (!nav) return;
      if (nav.querySelector('.wtp-hover-pill')) return; /* already set up */

      var pill = document.createElement('div');
      pill.className = 'wtp-hover-pill';
      pill.setAttribute('aria-hidden', 'true');
      nav.insertBefore(pill, nav.firstChild);

      var targets = nav.querySelectorAll('a.header__menu-item, summary.header__menu-item');

      targets.forEach(function (el) {
        el.addEventListener('mouseenter', function () {
          var navRect = nav.getBoundingClientRect();
          var elRect = el.getBoundingClientRect();
          var padX = 10;
          pill.style.left = elRect.left - navRect.left - padX + 'px';
          pill.style.width = elRect.width + padX * 2 + 'px';
          pill.style.opacity = '1';
        });
      });

      nav.addEventListener('mouseleave', function () {
        pill.style.opacity = '0';
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHoverPill);
    } else {
      initHoverPill();
    }

    /* Re-init after Shopify theme editor live-reloads the section */
    document.addEventListener('shopify:section:load', function (e) {
      if (e.target && e.target.querySelector('.header__inline-menu')) {
        initHoverPill();
      }
    });
    /* ─── 3. Mobile Menu Background Sync & Blur Overlay ──────────────────────── */
    function initMobileMenuSync() {
      var headerSection = document.querySelector('.section-header');
      var headerInternal = document.querySelector('.header-wrapper');
      var details = document.querySelector('header-drawer details');
      var summary = document.querySelector('header-drawer summary');

      if (!headerSection || !headerInternal || !details) return;

      var baseSchemeMatches = headerInternal.className.match(/color-\S+/);
      var baseScheme = baseSchemeMatches ? baseSchemeMatches[0] : '';
      var menuScheme = 'color-{{ section.settings.menu_color_scheme }}';

      var observer = new MutationObserver(function () {
        if (details.hasAttribute('open')) {
          if (baseScheme) headerInternal.classList.remove(baseScheme);
          headerInternal.classList.add(menuScheme);
          headerSection.classList.add('wtp-menu-open');
          /* Blur the page content directly — bypasses all stacking context traps */
          document.body.classList.add('wtp-blur-content');
        } else {
          headerInternal.classList.add(baseScheme);
          headerInternal.classList.remove(menuScheme);
          headerSection.classList.remove('wtp-menu-open');
          document.body.classList.remove('wtp-blur-content');
        }
      });
      observer.observe(details, { attributes: true, attributeFilter: ['open'] });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMobileMenuSync);
    } else {
      initMobileMenuSync();
    }

    /* ─── 4. Dynamic Cart Bubble Update & Animation ──────────────────────── */
    function initCartAnimation() {
      const cartBubble = document.getElementById('cart-icon-bubble');
      if (!cartBubble) return;

      const observer = new MutationObserver(function() {
        const bubble = cartBubble.querySelector('.cart-count-bubble');
        if (bubble) {
          bubble.classList.remove('is-popping');
          void bubble.offsetWidth; // Force reflow
          bubble.classList.add('is-popping');
        }
      });

      observer.observe(cartBubble, { childList: true, subtree: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCartAnimation);
    } else {
      initCartAnimation();
    }
  })();
</script>

