<div class="scroll-expansion-hero" id="ScrollExpansionHero-{{ section.id }}">
  <div class="scroll-expansion-hero__sticky-container">
    {%- if section.settings.background_image != blank -%}
      {{
        section.settings.background_image
        | image_url: width: 1200
        | image_tag:
          class: 'scroll-expansion-hero__bg',
          loading: 'eager',
          fetchpriority: 'high',
          preload: true,
          widths: '750, 1100, 1600',
          sizes: '100vw'
      }}
    {%- else -%}
      <div class="scroll-expansion-hero__bg scroll-expansion-hero__bg--placeholder">
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}

    <div class="scroll-expansion-hero__foreground">
      {%- if section.settings.foreground_video != blank -%}
        <div class="scroll-expansion-hero__video-wrapper">
          <div class="wtp-video-loader" style="background: #5c6e4c;">
            {%- if section.settings.loading_logo_image != blank -%}
              {{
                section.settings.loading_logo_image
                | image_url: width: 400
                | image_tag: class: 'wtp-video-loader__logo', loading: 'eager'
              }}
            {%- endif -%}
          </div>
          {{
            section.settings.foreground_video
            | video_tag:
              class: 'scroll-expansion-hero__media scroll-expansion-hero__media--video',
              autoplay: true,
              loop: true,
              muted: true,
              controls: false
          }}
        </div>
      {%- elsif section.settings.foreground_image != blank -%}
        {{
          section.settings.foreground_image
          | image_url: width: 2000
          | image_tag: class: 'scroll-expansion-hero__media', loading: 'lazy'
        }}
      {%- else -%}
        <div class="scroll-expansion-hero__media scroll-expansion-hero__media--placeholder">
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

    <div
      class="scroll-expansion-hero__title-container"
      style="--title-color: {{ section.settings.title_color }}; --subtitle-color: {{ section.settings.subtitle_color }};"
    >
      <div class="scroll-expansion-hero__title-row">
        {%- if section.settings.title_left != blank -%}
          <span class="scroll-expansion-hero__title-left">{{ section.settings.title_left }}</span>
        {%- endif -%}
        {%- if section.settings.title_right != blank -%}
          <span class="scroll-expansion-hero__title-right">{{ section.settings.title_right }}</span>
        {%- endif -%}
      </div>
      <div class="scroll-expansion-hero__subtitle-row">
        {%- if section.settings.subtitle != blank -%}
          <span class="scroll-expansion-hero__subtitle">
            {{- section.settings.subtitle -}}
          </span>
        {%- endif -%}
      </div>

      {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
        <div class="scroll-expansion-hero__buttons">
          {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
            <a
              href="{{ section.settings.button_link }}"
              class="scroll-expansion-hero__cta scroll-expansion-hero__cta--primary"
            >
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank and section.settings.button_link_2 != blank -%}
            <a
              href="{{ section.settings.button_link_2 }}"
              class="scroll-expansion-hero__cta scroll-expansion-hero__cta--secondary"
            >
              {{ section.settings.button_label_2 }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  #ScrollExpansionHero-{{ section.id }} {
    --scroll-progress: 0;
    height: 155vh;
    position: relative;
    width: 100%;
    display: block;
    background-color: #ffffffff;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__sticky-container {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (min-width: 750px) {
    #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__sticky-container {
      padding-bottom: 5rem;
    }
  }

  /* Layer 1: Background */
  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    pointer-events: none;
    opacity: calc(1 - var(--scroll-progress));
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__bg--placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: #333;
  }

  /* Layer 2: Foreground Card */
  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__foreground {
    position: absolute;
    z-index: 10;
    width: calc(300px + (95vw - 300px) * var(--scroll-progress));
    height: calc(400px + (85vh - 400px) * var(--scroll-progress));
    max-width: 100vw;
    border-radius: calc(2rem - 0.5rem * var(--scroll-progress));
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 850px) {
    #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__foreground {
      width: calc(200px + (92vw - 200px) * var(--scroll-progress));
      height: calc(250px + (80vh - 250px) * var(--scroll-progress));
    }
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__media--placeholder {
    background-color: #eee;
    width: 100%;
    height: 100%;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__media--placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Video Loading State */
  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__video-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  #ScrollExpansionHero-{{ section.id }} .wtp-video-loader {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    opacity: 1;
    transition: opacity 0.8s ease;
  }

  #ScrollExpansionHero-{{ section.id }} .wtp-video-loader__logo {
    width: clamp(80px, 20%, 160px);
    height: auto;
    object-fit: contain;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__media--video {
    position: relative;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__foreground.is-loaded .scroll-expansion-hero__media--video {
    opacity: 1;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__foreground.is-loaded .wtp-video-loader {
    opacity: 0;
    pointer-events: none;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__title-container {
    position: absolute;
    z-index: 20;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0;
    width: 100%;
    pointer-events: none;
    color: var(--title-color, #fff);
    min-height: 100vh;
    white-space: nowrap;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__title-container::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.15) 50%, rgba(0,0,0,0.4) 100%);
    opacity: calc(1 - var(--scroll-progress));
    pointer-events: none;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__title-row,
  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__subtitle-row {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__title-row {
    font-size: clamp(3rem, 11vw, 13rem);
    font-weight: 800;
    text-transform: uppercase;
    font-family: var(--font-heading-family);
    line-height: 0.95;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__subtitle-row {
    font-size: clamp(0.85rem, 2.8vw, 2.5rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--subtitle-color, #fff);
    font-family: var(--font-heading-family);
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__title-left {
    margin-right: 0.3em;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__title-left {
    margin-right: 0.3em;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__buttons {
    margin-top: 3.5rem;
    pointer-events: auto;
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 30;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__cta {
    display: inline-block;
    padding: 1.2rem 3rem;
    text-decoration: none;
    border-radius: 50px;
    font-family: var(--font-body-family);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1), background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__cta--primary {
    background-color: #1B3A2D;
    color: var(--color-cream, #F5F0E8);
    border: 2px solid #1B3A2D;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__cta--secondary {
    background-color: transparent;
    color: var(--color-cream, #F5F0E8);
    border: 2px solid rgba(245, 240, 232, 0.4);
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__cta:hover {
    transform: translateY(-4px) scale(1.02);
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__cta--primary:hover {
    background-color: var(--color-cream, #F5F0E8);
    color: #1B3A2D;
    border-color: var(--color-cream, #F5F0E8);
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__cta--secondary:hover {
    background-color: rgba(245, 240, 232, 0.1);
    border-color: var(--color-cream, #F5F0E8);
  }

  @media screen and (max-width: 750px) {
    #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__title-row {
      flex-direction: column;
      font-size: clamp(3.5rem, 20vw, 8rem);
      line-height: 0.85;
      margin-bottom: 0.5rem;
    }

    #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__title-left {
      margin-right: 0;
    }

    #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__subtitle-row {
      font-size: clamp(0.75rem, 4.4vw, 1.2rem);
      letter-spacing: 0.1em;
      width: 100%;
      max-width: 92vw;
      text-align: center;
    }

    #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__buttons {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 0.8rem;
      margin-top: 2.5rem;
      width: auto;
      padding: 0 1rem;
    }

    #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__cta {
      width: auto;
      flex: 1;
      text-align: center;
      padding: 0.8rem 1rem;
      font-size: 0.8rem;
      white-space: nowrap;
    }
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__title-right {
    /* No transform needed as per user request to remove splitting effect */
  }
</style>

<script>
  (function () {
    function initVideoLoader(sectionEl) {
      var foreground = sectionEl.querySelector('.scroll-expansion-hero__foreground');
      var video = sectionEl.querySelector('.scroll-expansion-hero__media--video');
      if (!foreground || !video) return;

      function onReady() {
        setTimeout(function () {
          foreground.classList.add('is-loaded');
        }, 500);
        video.removeEventListener('canplaythrough', onReady);
        video.removeEventListener('loadeddata', onReady);
      }

      /* canplaythrough covers most browsers; loadeddata is a reliable Safari fallback */
      video.addEventListener('canplaythrough', onReady, { once: true });
      video.addEventListener('loadeddata', onReady, { once: true });

      /* If the video is already buffered enough (e.g. cached), fire immediately */
      if (video.readyState >= 3) {
        onReady();
      }
    }

    function initScrollExpansionHero() {
      var sectionEl = document.getElementById('ScrollExpansionHero-{{ section.id }}');
      if (!sectionEl) return;

      /* Prevent double-init */
      if (sectionEl.dataset.scrollInit === 'true') return;
      sectionEl.dataset.scrollInit = 'true';

      var targetProgress = 0;
      var currentProgress = 0;
      var ease = 0.075; // Smoothing factor
      var animationId = null;

      function lerp() {
        var diff = targetProgress - currentProgress;
        if (Math.abs(diff) < 0.0001) {
          currentProgress = targetProgress;
          sectionEl.style.setProperty('--scroll-progress', currentProgress.toFixed(4));
          animationId = null;
          return;
        }

        currentProgress += diff * ease;
        sectionEl.style.setProperty('--scroll-progress', currentProgress.toFixed(4));
        animationId = requestAnimationFrame(lerp);
      }

      function updateProgress() {
        var rect = sectionEl.getBoundingClientRect();
        var wh = window.innerHeight;

        if (rect.top <= 0 && rect.bottom >= wh) {
          var scrollable = rect.height - wh;
          var rawFraction = Math.max(0, Math.min(1, Math.abs(rect.top) / scrollable));
          /* Expansion completes at 45% of scroll; remainder is dwell at full expansion */
          var expansionEnd = 0.45;
          targetProgress = Math.min(1, rawFraction / expansionEnd);
        } else if (rect.top > 0) {
          targetProgress = 0;
        } else {
          targetProgress = 1;
        }

        if (!animationId) {
          animationId = requestAnimationFrame(lerp);
        }
      }

      function onScroll() {
        updateProgress();
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });

      /* Initial calc */
      updateProgress();
      /* Force immediate snap on first load to prevent flash */
      currentProgress = targetProgress;
      sectionEl.style.setProperty('--scroll-progress', currentProgress.toFixed(4));

      /* Cinematic video loading state */
      initVideoLoader(sectionEl);
    }

    /* Run immediately if DOM is already ready, otherwise wait */
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initScrollExpansionHero);
    } else {
      initScrollExpansionHero();
    }

    /* Shopify Theme Editor: re-init when the section is loaded / selected */
    document.addEventListener('shopify:section:load', function (evt) {
      if (evt.detail && evt.detail.sectionId) {
        var target = document.getElementById('ScrollExpansionHero-' + evt.detail.sectionId);
        if (target) {
          target.dataset.scrollInit = '';
          initScrollExpansionHero();
        }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Scroll Expansion Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image",
      "info": "Image that stays in the background and fades out."
    },
    {
      "type": "image_picker",
      "id": "foreground_image",
      "label": "Foreground Image",
      "info": "Image that expands. Replaced by video if provided."
    },
    {
      "type": "video",
      "id": "foreground_video",
      "label": "Foreground Video",
      "info": "Video that expands."
    },
    {
      "type": "image_picker",
      "id": "loading_logo_image",
      "label": "Loading State Logo",
      "info": "Logo displayed on the dark green overlay while the video loads."
    },
    {
      "type": "text",
      "id": "title_left",
      "label": "Title — Left",
      "default": "Cinematic"
    },
    {
      "type": "text",
      "id": "title_right",
      "label": "Title — Right",
      "default": "Scroll"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "WHERE COFFEE CREATES COMMUNITY"
    },
    {
      "type": "header",
      "content": "Text Colors"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Join Our Community"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Secondary Call to Action"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Button Label 2",
      "default": "Explore Products"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Button Link 2"
    }
  ],
  "presets": [
    {
      "name": "Scroll Expansion Hero"
    }
  ]
}
{% endschema %}
