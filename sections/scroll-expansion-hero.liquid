<div class="scroll-expansion-hero" id="ScrollExpansionHero-{{ section.id }}">
  <div class="scroll-expansion-hero__sticky-container">
    {%- if section.settings.background_image != blank -%}
      {{
        section.settings.background_image
        | image_url: width: 3840
        | image_tag: class: 'scroll-expansion-hero__bg', loading: 'lazy'
      }}
    {%- else -%}
      <div class="scroll-expansion-hero__bg scroll-expansion-hero__bg--placeholder">
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}

    <div class="scroll-expansion-hero__foreground">
      {%- if section.settings.foreground_video != blank -%}
        <div class="scroll-expansion-hero__video-wrapper">
          <div class="wtp-video-loader" style="background: #5c6e4c;">
            {%- if section.settings.loading_logo_image != blank -%}
              {{
                section.settings.loading_logo_image
                | image_url: width: 400
                | image_tag: class: 'wtp-video-loader__logo', loading: 'eager'
              }}
            {%- endif -%}
          </div>
          {{
            section.settings.foreground_video
            | video_tag:
              class: 'scroll-expansion-hero__media scroll-expansion-hero__media--video',
              autoplay: true,
              loop: true,
              muted: true,
              controls: false
          }}
        </div>
      {%- elsif section.settings.foreground_image != blank -%}
        {{
          section.settings.foreground_image
          | image_url: width: 2000
          | image_tag: class: 'scroll-expansion-hero__media', loading: 'lazy'
        }}
      {%- else -%}
        <div class="scroll-expansion-hero__media scroll-expansion-hero__media--placeholder">
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

    <div
      class="scroll-expansion-hero__title-container"
      style="--title-color: {{ section.settings.title_color }}; --subtitle-color: {{ section.settings.subtitle_color }};"
    >
      <div class="scroll-expansion-hero__title-row">
        {%- if section.settings.title_left != blank -%}
          <span class="scroll-expansion-hero__title-left">{{ section.settings.title_left }}</span>
        {%- endif -%}
        {%- if section.settings.title_right != blank -%}
          <span class="scroll-expansion-hero__title-right">{{ section.settings.title_right }}</span>
        {%- endif -%}
      </div>
      <div class="scroll-expansion-hero__subtitle-row">
        {%- if section.settings.subtitle_left != blank -%}
          <span class="scroll-expansion-hero__title-left scroll-expansion-hero__subtitle">
            {{- section.settings.subtitle_left -}}
          </span>
        {%- endif -%}
        {%- if section.settings.subtitle_right != blank -%}
          <span class="scroll-expansion-hero__title-right scroll-expansion-hero__subtitle">
            {{- section.settings.subtitle_right -}}
          </span>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  #ScrollExpansionHero-{{ section.id }} {
    --scroll-progress: 0;
    height: 125vh;
    position: relative;
    width: 100%;
    display: block;
    background-color: #ffffffff;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__sticky-container {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Layer 1: Background */
  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    pointer-events: none;
    opacity: calc(1 - var(--scroll-progress));
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__bg--placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: #333;
  }

  /* Layer 2: Foreground Card */
  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__foreground {
    position: absolute;
    z-index: 10;
    width: calc(300px + (95vw - 300px) * var(--scroll-progress));
    height: calc(400px + (85vh - 400px) * var(--scroll-progress));
    max-width: 100vw;
    border-radius: calc(2rem - 0.5rem * var(--scroll-progress));
    overflow: hidden;
    box-shadow: 0 15px 45px -10px rgba(0, 0, 0, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 850px) {
    #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__foreground {
      width: calc(200px + (92vw - 200px) * var(--scroll-progress));
      height: calc(250px + (80vh - 250px) * var(--scroll-progress));
    }
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__media--placeholder {
    background-color: #eee;
    width: 100%;
    height: 100%;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__media--placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Video Loading State */
  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__video-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  #ScrollExpansionHero-{{ section.id }} .wtp-video-loader {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    opacity: 1;
    transition: opacity 0.8s ease;
  }

  #ScrollExpansionHero-{{ section.id }} .wtp-video-loader__logo {
    width: clamp(80px, 20%, 160px);
    height: auto;
    object-fit: contain;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__media--video {
    position: relative;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__foreground.is-loaded .scroll-expansion-hero__media--video {
    opacity: 1;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__foreground.is-loaded .wtp-video-loader {
    opacity: 0;
    pointer-events: none;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__title-container {
    position: absolute;
    z-index: 20;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.05em;
    width: 100%;
    pointer-events: none;
    color: var(--title-color, #fff);
    text-shadow: 0 2px 10px rgba(0,0,0,0.2);
    background: radial-gradient(circle, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.1) 30%, rgba(0,0,0,0) 60%);
    min-height: 100vh;
    white-space: nowrap;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__title-row,
  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__subtitle-row {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__title-row {
    font-size: clamp(3rem, 8vw, 8rem);
    font-weight: 800;
    text-transform: uppercase;
    font-family: var(--font-heading-family);
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__subtitle-row {
    font-size: clamp(1rem, 3vw, 2.5rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--subtitle-color, #fff);
    font-family: var(--font-heading-family);
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__title-left {
    margin-right: 0.25em;
  }

  #ScrollExpansionHero-{{ section.id }} .scroll-expansion-hero__title-right {
    /* No transform needed as per user request to remove splitting effect */
  }
</style>

<script>
  (function () {
    function initVideoLoader(sectionEl) {
      var foreground = sectionEl.querySelector('.scroll-expansion-hero__foreground');
      var video = sectionEl.querySelector('.scroll-expansion-hero__media--video');
      if (!foreground || !video) return;

      function onReady() {
        setTimeout(function () {
          foreground.classList.add('is-loaded');
        }, 500);
        video.removeEventListener('canplaythrough', onReady);
        video.removeEventListener('loadeddata', onReady);
      }

      /* canplaythrough covers most browsers; loadeddata is a reliable Safari fallback */
      video.addEventListener('canplaythrough', onReady, { once: true });
      video.addEventListener('loadeddata', onReady, { once: true });

      /* If the video is already buffered enough (e.g. cached), fire immediately */
      if (video.readyState >= 3) {
        onReady();
      }
    }

    function initScrollExpansionHero() {
      var sectionEl = document.getElementById('ScrollExpansionHero-{{ section.id }}');
      if (!sectionEl) return;

      /* Prevent double-init */
      if (sectionEl.dataset.scrollInit === 'true') return;
      sectionEl.dataset.scrollInit = 'true';

      var targetProgress = 0;
      var currentProgress = 0;
      var ease = 0.075; // Smoothing factor
      var animationId = null;

      function lerp() {
        var diff = targetProgress - currentProgress;
        if (Math.abs(diff) < 0.0001) {
          currentProgress = targetProgress;
          sectionEl.style.setProperty('--scroll-progress', currentProgress.toFixed(4));
          animationId = null;
          return;
        }

        currentProgress += diff * ease;
        sectionEl.style.setProperty('--scroll-progress', currentProgress.toFixed(4));
        animationId = requestAnimationFrame(lerp);
      }

      function updateProgress() {
        var rect = sectionEl.getBoundingClientRect();
        var wh = window.innerHeight;

        if (rect.top <= 0 && rect.bottom >= wh) {
          var scrollable = rect.height - wh;
          targetProgress = Math.max(0, Math.min(1, Math.abs(rect.top) / scrollable));
        } else if (rect.top > 0) {
          targetProgress = 0;
        } else {
          targetProgress = 1;
        }

        if (!animationId) {
          animationId = requestAnimationFrame(lerp);
        }
      }

      function onScroll() {
        updateProgress();
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });

      /* Initial calc */
      updateProgress();
      /* Force immediate snap on first load to prevent flash */
      currentProgress = targetProgress;
      sectionEl.style.setProperty('--scroll-progress', currentProgress.toFixed(4));

      /* Cinematic video loading state */
      initVideoLoader(sectionEl);
    }

    /* Run immediately if DOM is already ready, otherwise wait */
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initScrollExpansionHero);
    } else {
      initScrollExpansionHero();
    }

    /* Shopify Theme Editor: re-init when the section is loaded / selected */
    document.addEventListener('shopify:section:load', function (evt) {
      if (evt.detail && evt.detail.sectionId) {
        var target = document.getElementById('ScrollExpansionHero-' + evt.detail.sectionId);
        if (target) {
          target.dataset.scrollInit = '';
          initScrollExpansionHero();
        }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Scroll Expansion Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image",
      "info": "Image that stays in the background and fades out."
    },
    {
      "type": "image_picker",
      "id": "foreground_image",
      "label": "Foreground Image",
      "info": "Image that expands. Replaced by video if provided."
    },
    {
      "type": "video",
      "id": "foreground_video",
      "label": "Foreground Video",
      "info": "Video that expands."
    },
    {
      "type": "image_picker",
      "id": "loading_logo_image",
      "label": "Loading State Logo",
      "info": "Logo displayed on the dark green overlay while the video loads."
    },
    {
      "type": "text",
      "id": "title_left",
      "label": "Title — Left",
      "default": "Cinematic"
    },
    {
      "type": "text",
      "id": "title_right",
      "label": "Title — Right",
      "default": "Scroll"
    },
    {
      "type": "text",
      "id": "subtitle_left",
      "label": "Subtitle — Left",
      "default": "Experience"
    },
    {
      "type": "text",
      "id": "subtitle_right",
      "label": "Subtitle — Right",
      "default": "The Moment"
    },
    {
      "type": "header",
      "content": "Text Colors"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Scroll Expansion Hero"
    }
  ]
}
{% endschema %}
