{%- style -%}
  #wtp-map-hero-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: 7rem 5%;
  }

  /* ── Header ── */
  .mh-header {
    max-width: 1380px;
    margin: 0 auto 3rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .mh-header-text {
    flex: 1;
  }

  .mh-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin: 0 0 0.75rem;
  }

  .mh-heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: {{ section.settings.text_color }};
    margin: 0 0 1rem;
  }

  .mh-desc {
    font-size: 1.1rem;
    line-height: 1.8;
    color: {{ section.settings.text_color }};
    opacity: 0.7;
    margin: 0;
    max-width: 560px;
  }

  /* ── Location Button ── */
  .mh-location-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 1.8rem;
    border: 1.5px solid {{ section.settings.text_color }};
    border-radius: 50px;
    color: {{ section.settings.text_color }};
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    background: transparent;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  .mh-location-btn:hover {
    background: {{ section.settings.text_color }};
    color: {{ section.settings.bg_color }};
  }

  .mh-location-btn svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* ── Map Container ── */
  .mh-map-outer {
    max-width: 1380px;
    margin: 0 auto;
    position: relative;
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
    /* Aspect ratio hack: 45% of width */
    padding-bottom: 45%;
    height: 0;
  }

  .mh-map-outer iframe,
  .mh-map-outer .mh-map-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .mh-map-placeholder {
    background: #d9d5ce;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: #7a756d;
  }

  .mh-map-placeholder svg {
    width: 48px;
    height: 48px;
    opacity: 0.5;
  }

  .mh-map-placeholder p {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
  }

  /* ── Mobile ── */
  @media screen and (max-width: 750px) {
    #wtp-map-hero-{{ section.id }} {
      padding: 5rem 5%;
    }

    .mh-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .mh-map-outer {
      /* Taller on mobile for better UX */
      padding-bottom: 75%;
    }
  }
{%- endstyle -%}

<section id="wtp-map-hero-{{ section.id }}" aria-label="{{ section.settings.heading | escape }}">

  <div class="mh-header">
    <div class="mh-header-text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="mh-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="mh-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="mh-desc">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <button class="mh-location-btn" type="button" id="mh-location-btn-{{ section.id }}" aria-label="{{ section.settings.button_label | escape }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
          <circle cx="12" cy="9" r="2.5"/>
        </svg>
        {{ section.settings.button_label | escape }}
      </button>
    {%- endif -%}
  </div>

  <div class="mh-map-outer">
    {%- if section.settings.map_embed_code != blank -%}
      {{ section.settings.map_embed_code }}
    {%- else -%}
      <div class="mh-map-placeholder">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
          <line x1="9" y1="3" x2="9" y2="18"/>
          <line x1="15" y1="6" x2="15" y2="21"/>
        </svg>
        <p>Paste your Google Maps embed code in the Theme Editor</p>
      </div>
    {%- endif -%}
  </div>

</section>

<script>
(function() {
  var btn = document.getElementById('mh-location-btn-{{ section.id }}');
  if (!btn || !navigator.geolocation) return;

  btn.addEventListener('click', function() {
    btn.setAttribute('disabled', 'disabled');
    btn.style.opacity = '0.6';

    navigator.geolocation.getCurrentPosition(
      function(pos) {
        var lat = pos.coords.latitude;
        var lng = pos.coords.longitude;
        var url = 'https://www.google.com/maps/search/?api=1&query=' + lat + ',' + lng;
        window.open(url, '_blank', 'noopener');
        btn.removeAttribute('disabled');
        btn.style.opacity = '';
      },
      function() {
        btn.removeAttribute('disabled');
        btn.style.opacity = '';
      }
    );
  });
})();
</script>

{% schema %}
{
  "name": "Map Hero",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F0E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1B3A2D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Eyebrow / Accent Color",
      "default": "#C8A96E"
    },
    {
      "type": "header",
      "content": "Header Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "FIND US"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Archipelago of Brew"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Each WTP Coffee location is a destination in itself. Find your nearest outpost and experience the craft firsthand."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Location Button Label",
      "default": "Use Current Location"
    },
    {
      "type": "header",
      "content": "Map Embed"
    },
    {
      "type": "html",
      "id": "map_embed_code",
      "label": "Google Maps Embed Code",
      "info": "Paste the full iframe embed code from Google Maps (Share > Embed a map)."
    }
  ],
  "presets": [
    {
      "name": "Map Hero"
    }
  ]
}
{% endschema %}
