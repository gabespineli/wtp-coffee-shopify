{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<style>
  .wtp-footer {
    --color-footer-bg: #1B3A2D;
    --color-footer-cream: #F5F0E8;
    --color-footer-muted: rgba(245, 240, 232, 0.6);
    --color-footer-accent: #C8A96E;
    --color-footer-divider: rgba(245, 240, 232, 0.15);

    background: var(--color-footer-bg);
    border-radius: 24px 24px 0 0;
    overflow: hidden;
    color: var(--color-footer-cream);
    font-family: var(--font-body-family), 'Poppins', sans-serif;
  }

  .wtp-footer .page-width {
    padding: 4rem 2rem 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Scalable Grid */
  .wtp-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 4rem;
    margin-bottom: 4rem;
  }

  .wtp-footer__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Headings */
  .wtp-footer__heading {
    font-family: var(--font-heading-family), sans-serif;
    font-variant-caps: small-caps;
    text-transform: uppercase;
    color: var(--color-footer-accent);
    font-size: 1.25rem;
    margin: 0 0 1.5rem;
    letter-spacing: 0.05em;
  }

  /* Brand Block */
  .wtp-footer__logo img {
    max-width: 160px;
    height: auto;
    display: block;
    margin-bottom: 1rem;
  }
  .wtp-footer__tagline {
    font-family: var(--font-body-family), 'Poppins', sans-serif;
    color: var(--color-footer-muted);
    font-size: 0.9rem;
    margin: 0;
    line-height: 1.4;
  }

  /* Locations Block */
  .wtp-footer__locations-wrapper {
    width: 100%;
  }
  .wtp-footer__location {
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    width: 100%;
  }
  .wtp-footer__location:not(:last-child) {
    border-bottom: 1px solid var(--color-footer-divider);
  }
  .wtp-footer__location-name {
    font-weight: 600;
    color: var(--color-footer-cream);
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }
  .wtp-footer__location-address,
  .wtp-footer__location-hours {
    color: var(--color-footer-muted);
    font-size: 0.85rem;
    margin: 0 0 0.25rem;
    line-height: 1.5;
  }

  /* Contact & Newsletter Block */
  .wtp-footer__contact-info {
    margin-bottom: 2.5rem;
    width: 100%;
  }
  .wtp-footer__contact-link {
    display: block;
    color: var(--color-footer-cream);
    text-decoration: none;
    font-size: 1rem;
    margin-bottom: 0.5rem;
    transition: color 0.2s ease;
  }
  .wtp-footer__contact-link:hover {
    color: var(--color-footer-accent);
  }
  
  .wtp-footer__newsletter {
    width: 100%;
  }
  .wtp-footer__newsletter-label {
    font-size: 0.85rem;
    color: var(--color-footer-muted);
    margin-bottom: 0.75rem;
    display: block;
  }
  
  .wtp-footer__newsletter-form {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    width: 100%;
  }
  
  .wtp-footer__newsletter-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 1px solid var(--color-footer-divider);
    color: var(--color-footer-cream);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-family: inherit;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .wtp-footer__newsletter-input::placeholder {
    color: var(--color-footer-muted);
  }
  .wtp-footer__newsletter-input:focus {
    border-color: var(--color-footer-accent);
  }
  
  .wtp-footer__newsletter-btn {
    background: var(--color-footer-accent);
    color: var(--color-footer-bg);
    border: none;
    border-radius: 8px;
    padding: 0.75rem 1.5rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }
  .wtp-footer__newsletter-btn:hover {
    opacity: 0.85;
  }

  .wtp-footer__newsletter-success {
    display: none;
    color: #F5F0E8;
    font-size: 0.95rem;
    margin-top: 0.5rem;
  }

  /* BOTTOM BAR */
  .wtp-footer__bottom {
    border-top: 1px solid var(--color-footer-divider);
    padding-top: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    color: var(--color-footer-muted);
  }
  .wtp-footer__policies {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .wtp-footer__policies a {
    color: var(--color-footer-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .wtp-footer__policies a:hover {
    color: var(--color-footer-cream);
  }

  /* MOBILE RESPONSIVE */
  @media screen and (max-width: 768px) {
    .wtp-footer .page-width {
      padding: 3rem 1.5rem 2rem;
    }
    .wtp-footer__grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
    /* Add dividers between stacked columns on mobile */
    .wtp-footer__col {
      padding-bottom: 3rem;
      margin-bottom: 3rem;
      border-bottom: 1px solid var(--color-footer-divider);
    }
    .wtp-footer__col:last-child {
      border-bottom: none;
      padding-bottom: 0;
      margin-bottom: 0;
    }
    .wtp-footer__newsletter-form {
      flex-direction: column;
      align-items: stretch;
    }
    .wtp-footer__bottom {
      flex-direction: column;
      text-align: center;
      gap: 1.5rem;
    }
    .wtp-footer__policies {
      justify-content: center;
      flex-wrap: wrap;
    }
  }
</style>

<footer class="wtp-footer">
  <div class="page-width">
    
    <div class="wtp-footer__grid">
      {%- for block in section.blocks -%}
        <div class="wtp-footer__col" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            
            {%- when 'brand' -%}
              {%- if block.settings.logo != blank -%}
                <div class="wtp-footer__logo">
                  {{ block.settings.logo | image_url: width: 320 | image_tag: width: 160 }}
                </div>
              {%- endif -%}
              {%- if block.settings.tagline != blank -%}
                <p class="wtp-footer__tagline">{{ block.settings.tagline }}</p>
              {%- endif -%}

            {%- when 'locations' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="wtp-footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              <div class="wtp-footer__locations-wrapper">
                {%- for i in (1..3) -%}
                  {%- assign name_key = 'name_' | append: i -%}
                  {%- assign addr_key = 'address_' | append: i -%}
                  {%- assign hours_key = 'hours_' | append: i -%}
                  
                  {%- if block.settings[name_key] != blank or block.settings[addr_key] != blank or block.settings[hours_key] != blank -%}
                    <div class="wtp-footer__location">
                      {%- if block.settings[name_key] != blank -%}
                        <h3 class="wtp-footer__location-name">{{ block.settings[name_key] }}</h3>
                      {%- endif -%}
                      {%- if block.settings[addr_key] != blank -%}
                        <p class="wtp-footer__location-address">{{ block.settings[addr_key] }}</p>
                      {%- endif -%}
                      {%- if block.settings[hours_key] != blank -%}
                        <p class="wtp-footer__location-hours">{{ block.settings[hours_key] }}</p>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>

            {%- when 'contact_newsletter' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="wtp-footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              
              <div class="wtp-footer__contact-info">
                {%- if block.settings.contact_email != blank -%}
                  <a href="mailto:{{ block.settings.contact_email }}" class="wtp-footer__contact-link">
                    {{ block.settings.contact_email }}
                  </a>
                {%- endif -%}
                {%- if block.settings.instagram_handle != blank -%}
                  {%- assign ig_url = block.settings.instagram_url | default: '#' -%}
                  <a href="{{ ig_url }}" target="_blank" rel="noopener noreferrer" class="wtp-footer__contact-link">
                    @{{ block.settings.instagram_handle | remove: '@' }}
                  </a>
                {%- endif -%}
              </div>

              <div class="wtp-footer__newsletter">
                <span class="wtp-footer__newsletter-label">{{ block.settings.newsletter_label | default: 'Stay in the loop' }}</span>
                {% form 'customer', id: 'wtp-footer-newsletter', class: 'wtp-footer__newsletter-form' %}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <input type="email" 
                         name="contact[email]" 
                         class="wtp-footer__newsletter-input" 
                         placeholder="Your email address" 
                         required>
                  <button type="submit" class="wtp-footer__newsletter-btn">Subscribe</button>
                {% endform %}
                <div class="wtp-footer__newsletter-success" id="wtp-newsletter-success">
                  You're in ✓
                </div>
              </div>

          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <!-- BOTTOM BAR -->
    <div class="wtp-footer__bottom">
      <div class="wtp-footer__copyright">
        &copy; {{ section.settings.copyright_year | escape }} {{ section.settings.copyright_brand | escape }}. All rights reserved.
      </div>
      <ul class="wtp-footer__policies">
        {%- if section.settings.privacy_url != blank -%}
          <li><a href="{{ section.settings.privacy_url }}">Privacy Policy</a></li>
        {%- endif -%}
        {%- if section.settings.terms_url != blank -%}
          <li><a href="{{ section.settings.terms_url }}">Terms of Service</a></li>
        {%- endif -%}
      </ul>
    </div>

  </div>
</footer>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var form = document.getElementById('wtp-footer-newsletter');
    var successMsg = document.getElementById('wtp-newsletter-success');

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        var formData = new FormData(form);
        
        fetch('/contact#wtp-footer-newsletter', {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'text/html'
          }
        })
        .then(function() {
          form.style.display = 'none';
          successMsg.style.display = 'block';
        })
        .catch(function(error) {
          console.error('Newsletter error:', error);
          // Fallback native submission
          form.submit();
        });
      });
    }
  });
</script>

{% schema %}
{
  "name": "WTP Footer",
  "settings": [
    {
      "type": "header",
      "content": "Bottom Bar Settings"
    },
    {
      "type": "text",
      "id": "copyright_brand",
      "label": "Brand Name for Copyright",
      "default": "WTP Coffee"
    },
    {
      "type": "text",
      "id": "copyright_year",
      "label": "Copyright Year",
      "default": "2025"
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "Privacy Policy URL"
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "Terms of Service URL"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand Info",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Footer Logo"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline",
          "default": "Where Coffee Creates Community"
        }
      ]
    },
    {
      "type": "locations",
      "name": "Store Locations",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Heading",
          "default": "Find Us"
        },
        { "type": "header", "content": "Location 1" },
        { "type": "text", "id": "name_1", "label": "Location Name" },
        { "type": "text", "id": "address_1", "label": "Address" },
        { "type": "text", "id": "hours_1", "label": "Operating Hours" },
        { "type": "header", "content": "Location 2" },
        { "type": "text", "id": "name_2", "label": "Location Name" },
        { "type": "text", "id": "address_2", "label": "Address" },
        { "type": "text", "id": "hours_2", "label": "Operating Hours" },
        { "type": "header", "content": "Location 3" },
        { "type": "text", "id": "name_3", "label": "Location Name" },
        { "type": "text", "id": "address_3", "label": "Address" },
        { "type": "text", "id": "hours_3", "label": "Operating Hours" }
      ]
    },
    {
      "type": "contact_newsletter",
      "name": "Contact & Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Heading",
          "default": "Get in Touch"
        },
        {
          "type": "text",
          "id": "contact_email",
          "label": "Contact Email"
        },
        {
          "type": "text",
          "id": "instagram_handle",
          "label": "Instagram Handle (without @)"
        },
        {
          "type": "url",
          "id": "instagram_url",
          "label": "Instagram URL"
        },
        {
          "type": "text",
          "id": "newsletter_label",
          "label": "Newsletter Label",
          "default": "Stay in the loop"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WTP Footer",
      "blocks": [
        { "type": "brand" },
        { "type": "locations" },
        { "type": "contact_newsletter" }
      ]
    }
  ]
}
{% endschema %}
