{% comment %}
  Community Calendar — WTP Coffee
  Left: headline + description + Klaviyo email opt-in form.
  Right: upcoming event rows with date, title, tag, RSVP button.
{% endcomment %}

{%- liquid
  assign bg = section.settings.bg_color
  assign text_col = section.settings.text_color
  assign accent = section.settings.accent_color
  assign card_bg = section.settings.card_bg_color
-%}

<style>
  /* ── Palette ── */
  #wtp-comm-cal-{{ section.id }} {
    --cc-bg:       rgba({{ bg.red }}, {{ bg.green }}, {{ bg.blue }}, 1);
    --cc-text:     rgba({{ text_col.red }}, {{ text_col.green }}, {{ text_col.blue }}, 1);
    --cc-muted:    rgba({{ text_col.red }}, {{ text_col.green }}, {{ text_col.blue }}, 0.55);
    --cc-accent:   rgba({{ accent.red }}, {{ accent.green }}, {{ accent.blue }}, 1);
    --cc-card-bg:  rgba({{ card_bg.red }}, {{ card_bg.green }}, {{ card_bg.blue }}, 1);
    --cc-divider:  rgba({{ text_col.red }}, {{ text_col.green }}, {{ text_col.blue }}, 0.1);
    --cc-input-bg: rgba({{ text_col.red }}, {{ text_col.green }}, {{ text_col.blue }}, 0.06);
  }

  /* ── Shell ── */
  #wtp-comm-cal-{{ section.id }} {
    background-color: var(--cc-bg);
    color: var(--cc-text);
    font-family: var(--font-body-family);
    box-sizing: border-box;
  }

  #wtp-comm-cal-{{ section.id }} *,
  #wtp-comm-cal-{{ section.id }} *::before,
  #wtp-comm-cal-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  /* ── Outer layout ── */
  .cc-layout {
    display: flex;
    gap: 5rem;
    padding: 6rem 5%;
    align-items: flex-start;
  }

  /* ── LEFT PANEL ── */
  .cc-left {
    flex: 0 0 450px;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    position: sticky;
    top: 7rem;
  }

  .cc-headline {
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 6vw, 4.2rem);
    font-style: italic;
    line-height: 1.05;
    margin: 0;
    color: var(--cc-text);
  }

  .cc-description {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--cc-muted);
    margin: 0;
  }

  /* ── Opt-in form ── */
  #wtp-comm-cal-{{ section.id }} .cc-optin {
    background: var(--cc-card-bg);
    border-radius: 20px;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    border: 1px solid var(--cc-divider);
    color: #1B3A2D;
  }

  #wtp-comm-cal-{{ section.id }} .cc-optin__label {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0;
  }

  #wtp-comm-cal-{{ section.id }} .cc-optin__desc {
    font-size: 1.25rem;
    color: #1B3A2D;
    margin: 0;
    line-height: 1.5;
  }

  #wtp-comm-cal-{{ section.id }} .pill-form {
    display: flex;
    align-items: center;
    background: #fff;
    border-radius: 50px;
    padding: 0.5rem 0.5rem 0.5rem 1.5rem;
    gap: 0.5rem;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }

  #wtp-comm-cal-{{ section.id }} .pill-form__icon {
    color: rgba(0, 0, 0, 0.35);
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  #wtp-comm-cal-{{ section.id }} .cc-optin__input {
    flex: 1;
    border: none;
    background: transparent;
    outline: none;
    font-size: 1.15rem;
    color: #1B3A2D;
    padding: 0.6rem 0;
  }

  #wtp-comm-cal-{{ section.id }} .cc-optin__input::placeholder {
    color: rgba(27, 58, 45, 0.5);
  }

  #wtp-comm-cal-{{ section.id }} .cc-optin__input:focus {
    border-color: transparent;
  }

  .cc-optin__btn {
    background: #1B3A2D;
    color: #fff;
    border: none;
    border-radius: 50px;
    padding: 1.15rem 2.75rem;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }

  .cc-optin__btn:hover {
    opacity: 0.85;
  }

  .cc-optin__success {
    font-size: 1.2rem;
    color: var(--cc-accent);
    text-align: center;
    padding: 0.5rem 0;
    font-weight: 700;
  }

  .cc-optin__error {
    color: #8b1a1a;
    font-size: 1rem;
    margin-top: 0.5rem;
    text-align: center;
  }

  /* ── RIGHT PANEL — event rows ── */
  .cc-right {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 0;
  }

  /* ── Event row ── */
  .cc-event {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    align-items: start;
    gap: 0 2rem;
    padding: 3rem 0;
    border-bottom: 1px solid var(--cc-divider);
  }

  .cc-event:first-child {
    border-top: 1px solid var(--cc-divider);
  }

  /* Date block */
  .cc-event__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    padding-top: 0.1rem;
    flex-shrink: 0;
  }

  .cc-event__day {
    font-family: var(--font-heading-family);
    font-size: clamp(5rem, 8vw, 7rem);
    font-weight: 900;
    color: var(--cc-text);
    line-height: .9;
    letter-spacing: -0.02em;
  }

  .cc-event__month {
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cc-accent);
    margin-top: 0.25rem;
  }

  .cc-event__year {
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    letter-spacing: 0.14em;
    color: var(--cc-muted);
    margin-top: 0.15rem;
  }

  /* Middle: title, meta, desc */
  .cc-event__mid {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .cc-event__title-row {
    display: block;
    margin-bottom: 0.15rem;
  }

  .cc-event__title {
    font-family: var(--font-heading-family);
    font-size: clamp(2rem, 3vw, 2.8rem);
    font-weight: 600;
    font-style: italic;
    color: var(--cc-text);
    margin: 0;
    line-height: 1.1;
  }

  .cc-event__meta {
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--cc-muted);
    margin: 0.15rem 0 0;
  }

  .cc-event__desc {
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    color: var(--cc-muted);
    line-height: 1.7;
    margin: 0.75rem 0 0;
    max-width: 80ch;
  }

  .cc-event__spots strong {
    color: var(--cc-text);
  }

  /* Right: tag + RSVP */
  .cc-event__right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.25rem;
    flex-shrink: 0;
    padding-top: 0.15rem;
    min-width: 220px;
  }

  #wtp-comm-cal-{{ section.id }} .cc-event__tag {
    display: inline-block;
    padding: 0.5rem 1.2rem;
    background: #fff;
    color: #1B3A2D;
    border-radius: 50px;
    font-family: var(--font-body-family);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cc-tag--mobile {
    display: none;
  }


  .cc-event__spots {
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    color: var(--cc-muted);
    white-space: nowrap;
    font-weight: 600;
  }

  .cc-event__right-bottom {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
    width: 220px;
  }





  .cc-event__tag-row {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .cc-event__register {
    background: var(--cc-accent);
    color: #fff;
    padding: 1rem 1.8rem;
    border-radius: 50px;
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
    display: block;
    width: 100%;
    transition: opacity 0.2s ease;
  }

  .cc-event__register:hover {
    opacity: 0.9;
  }

  .cc-event__register.is-sold-out {
    background: var(--cc-input-bg);
    color: var(--cc-muted);
    cursor: not-allowed;
    opacity: 0.7;
    pointer-events: none;
  }

  .cc-event__viewdetails {
    background: transparent;
    border: 1px solid var(--cc-divider);
    color: var(--cc-text);
    padding: 0.9rem 1.8rem;
    border-radius: 50px;
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
    display: block;
    width: 100%;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .cc-event__viewdetails:hover {
    background: var(--cc-input-bg);
    border-color: var(--cc-muted);
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .cc-layout {
      flex-direction: column;
      padding: 2.5rem 1.25rem;
      gap: 2.5rem;
    }

    .cc-left {
      position: static;
      flex: 1 1 100%;
      width: 100%;
    }

    .cc-event {
      grid-template-columns: 48px 1fr;
      grid-template-rows: auto auto;
    }

    .cc-event__date {
      grid-row: 1;
    }

    .cc-event__mid {
      grid-row: 1;
    }

    .cc-event__right {
      grid-column: 1 / -1;
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      margin-top: 1.5rem;
    }

    .cc-tag--mobile {
      display: inline-block;
      margin-bottom: 0.75rem;
    }

    .cc-tag--desktop {
      display: none;
    }

    .cc-event__tag-row {
      justify-content: flex-start;
      margin-bottom: 0;
    }

    .cc-event__date {
      width: 60px;
      padding-top: 0;
    }

    .cc-event__day {
      font-size: 2.8rem;
      display: block;
      text-align: center;
      width: 100%;
    }

    .cc-event__month {
      font-size: 0.95rem;
      display: block;
      text-align: center;
      width: 100%;
      margin-top: -0.2rem;
    }

    .cc-event__year {
      font-size: 0.8rem;
      display: block;
      text-align: center;
      width: 100%;
    }

    #wtp-comm-cal-{{ section.id }} .pill-form {
      flex-direction: column;
      background: transparent;
      padding: 0;
      gap: 1rem;
      border-radius: 0;
    }

    #wtp-comm-cal-{{ section.id }} .cc-optin__input {
      background: #fff;
      border-radius: 50px;
      padding: 1rem 1.5rem;
      flex: none;
      width: 100%;
    }

    #wtp-comm-cal-{{ section.id }} .pill-form__icon {
      display: none;
    }

    .cc-optin__btn {
      width: 100%;
      padding: 1.1rem;
    }
  }
</style>

{%- comment -%} Resolve tag class helper {%- endcomment -%}

<section id="wtp-comm-cal-{{ section.id }}" aria-label="{{ section.settings.headline | escape }}">
  <div class="cc-layout">
    {%- comment -%} LEFT — headline + optin {%- endcomment -%}
    <div class="cc-left">
      {%- if section.settings.headline != blank -%}
        <h2 class="cc-headline">{{ section.settings.headline | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="cc-description">{{ section.settings.description | escape }}</p>
      {%- endif -%}

      {%- comment -%} Shopify Form opt-in {%- endcomment -%}
      <div class="cc-optin" id="wtp-cc-optin-{{ section.id }}">
        <p class="cc-optin__label">{{ section.settings.optin_label | escape }}</p>
        <p class="cc-optin__desc">
          {{ section.settings.optin_desc | escape }}
        </p>

        {%- form 'customer', class: 'cc-optin__form-body event-newsletter-form', id: 'wtp-cc-optin-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter, community-events">

          {%- if form.posted_successfully? -%}
            <p class="cc-optin__success">You're in! 🎉 We'll keep you updated.</p>
          {%- else -%}
            <div class="pill-form">
              <span class="pill-form__icon">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="2" y="4" width="20" height="16" rx="2"/>
                  <path d="M2 7l10 7 10-7"/>
                </svg>
              </span>
              <input
                type="email"
                name="contact[email]"
                class="cc-optin__input"
                placeholder="{{ section.settings.optin_placeholder | escape }}"
                required
              >
              <button type="submit" class="cc-optin__btn">
                {{ section.settings.optin_btn_label | escape }}
              </button>
            </div>
            {%- if form.errors -%}
              <p class="cc-optin__error">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    {%- comment -%} RIGHT — upcoming events {%- endcomment -%}
    <div class="cc-right">
      {%- assign today = 'now' | date: '%s' | plus: 0 -%}
      {%- assign raw_events = blogs[section.settings.events_blog].articles -%}

      {%- comment -%}
        Build a sortable string. Always append a comma so entries are reliably
        delimited even when some articles are skipped (no event_date).
        After split we filter out blank entries produced by double/trailing commas.
      {%- endcomment -%}
      {%- capture events_with_dates -%}
        {%- for a in raw_events -%}
          {%- assign a_date = a.metafields.custom.event_date.value -%}
          {%- if a_date != blank -%}
            {{ a_date | date: '%s' }}|{{ a.handle }},
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}

      {%- assign sorted_event_strings = events_with_dates | split: ',' | sort -%}
      {%- assign events_shown = 0 -%}

      {%- for event_string in sorted_event_strings -%}
        {%- assign event_string_trimmed = event_string | strip -%}
        {%- if event_string_trimmed == blank -%}{%- continue -%}{%- endif -%}
        {%- if events_shown >= section.settings.events_limit -%}{%- break -%}{%- endif -%}

        {%- assign handle = event_string_trimmed | split: '|' | last | strip -%}

        {%- assign article = nil -%}
        {%- for a in raw_events -%}
          {%- if a.handle == handle -%}
            {%- assign article = a -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if article == nil -%}{%- continue -%}{%- endif -%}

        {%- assign event_date_raw = article.metafields.custom.event_date.value -%}
        {%- assign event_date = event_date_raw | date: '%s' | plus: 0 -%}

        {%- if event_date >= today -%}
          {%- assign events_shown = events_shown | plus: 1 -%}
          {%- assign raw_tag = article.tags.first -%}
          {%- assign rsvp_url = article.metafields.custom.event_rsvp_url -%}
          {%- assign event_location = article.metafields.custom.event_location -%}

          <div class="cc-event">
            {%- comment -%} Date block {%- endcomment -%}
            <div class="cc-event__date">
              {%- if event_date_raw != blank -%}
                <span class="cc-event__day">{{ event_date_raw | date: '%-d' }}</span>
                <span class="cc-event__month">{{ event_date_raw | date: '%b' | upcase }}</span>
                <span class="cc-event__year">{{ event_date_raw | date: '%Y' }}</span>
              {%- endif -%}
            </div>

            {%- comment -%} Middle: title, location, time, excerpt {%- endcomment -%}
            <div class="cc-event__mid">
              {%- if raw_tag != blank -%}
                <div class="cc-tag--mobile">
                  <span class="cc-event__tag">{{ raw_tag | escape }}</span>
                </div>
              {%- endif -%}

              <div class="cc-event__title-row">
                <h3 class="cc-event__title">{{ article.title | escape }}</h3>
              </div>

              {%- if event_location != blank -%}
                <p class="cc-event__meta">{{ event_location | escape }}</p>
              {%- endif -%}

              {%- if event_date_raw != blank -%}
                <p class="cc-event__meta">{{ event_date_raw | date: '%-I:%M %p' }}</p>
              {%- endif -%}

              {%- if article.content != blank -%}
                <p class="cc-event__desc">{{ article.content | strip_html | truncatewords: 30 }}</p>
              {%- endif -%}
            </div>

            {%- comment -%} Right: tag pill + CTA buttons {%- endcomment -%}
            <div class="cc-event__right">
              <div class="cc-event__tag-row cc-tag--desktop">
                {%- if raw_tag != blank -%}
                  <span class="cc-event__tag">{{ raw_tag | escape }}</span>
                {%- endif -%}
              </div>

              <div class="cc-event__right-bottom">
                {%- if rsvp_url != blank -%}
                  <a href="{{ rsvp_url }}" target="_blank" rel="noopener noreferrer" class="cc-event__register">
                    Register Now
                  </a>
                {%- else -%}
                  <span class="cc-event__register is-sold-out">Coming Soon</span>
                {%- endif -%}
                <a href="{{ article.url }}" class="cc-event__viewdetails">View Details</a>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- if events_shown == 0 -%}
        <p style="color: var(--cc-muted); font-size: 1.1rem; padding: 3rem 0;">No upcoming events. Check back soon.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Community Calendar",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F0E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1B3A2D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#C8A96E"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Opt-in Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Left Panel"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Community Calendar"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Open events for the WTP community. We keep it personal. Every stage offers curated tastings and brews for all."
    },
    {
      "type": "header",
      "content": "Email Opt-in"
    },
    {
      "type": "text",
      "id": "optin_label",
      "label": "Form Label",
      "default": "Never Miss a Pour."
    },
    {
      "type": "textarea",
      "id": "optin_desc",
      "label": "Form Description",
      "default": "Get notified about upcoming cuppings, masterclasses, and community events."
    },
    {
      "type": "text",
      "id": "optin_placeholder",
      "label": "Email Input Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "optin_btn_label",
      "label": "Submit Button Label",
      "default": "Keep Me Notified"
    },
    {
      "type": "range",
      "id": "events_limit",
      "label": "Max Events to Show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "blog",
      "id": "events_blog",
      "label": "Events Blog"
    }
  ],
  "presets": [
    {
      "name": "Community Calendar"
    }
  ]
}
{% endschema %}
