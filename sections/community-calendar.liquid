{% comment %}
  Community Calendar — WTP Coffee
  Left: headline + description + Klaviyo email opt-in form.
  Right: upcoming event rows with date, title, tag, RSVP button.
{% endcomment %}

{%- liquid
  assign bg = section.settings.bg_color
  assign text_col = section.settings.text_color
  assign accent = section.settings.accent_color
  assign card_bg = section.settings.card_bg_color
-%}

<style>
  /* ── Palette ── */
  #wtp-comm-cal-{{ section.id }} {
    --cc-bg:       rgba({{ bg.red }}, {{ bg.green }}, {{ bg.blue }}, 1);
    --cc-text:     rgba({{ text_col.red }}, {{ text_col.green }}, {{ text_col.blue }}, 1);
    --cc-muted:    rgba({{ text_col.red }}, {{ text_col.green }}, {{ text_col.blue }}, 0.55);
    --cc-accent:   rgba({{ accent.red }}, {{ accent.green }}, {{ accent.blue }}, 1);
    --cc-card-bg:  rgba({{ card_bg.red }}, {{ card_bg.green }}, {{ card_bg.blue }}, 1);
    --cc-divider:  rgba({{ text_col.red }}, {{ text_col.green }}, {{ text_col.blue }}, 0.1);
    --cc-input-bg: rgba({{ text_col.red }}, {{ text_col.green }}, {{ text_col.blue }}, 0.06);
  }

  /* ── Shell ── */
  #wtp-comm-cal-{{ section.id }} {
    background-color: var(--cc-bg);
    color: var(--cc-text);
    font-family: var(--font-body-family);
    box-sizing: border-box;
  }

  #wtp-comm-cal-{{ section.id }} *,
  #wtp-comm-cal-{{ section.id }} *::before,
  #wtp-comm-cal-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  /* ── Outer layout ── */
  .cc-layout {
    display: flex;
    gap: 5rem;
    padding: 6rem 5%;
    align-items: flex-start;
  }

  /* ── LEFT PANEL ── */
  .cc-left {
    flex: 0 0 450px;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    position: sticky;
    top: 7rem;
  }

  .cc-headline {
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 6vw, 4.2rem);
    font-style: italic;
    line-height: 1.05;
    margin: 0;
    color: var(--cc-text);
  }

  .cc-description {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--cc-muted);
    margin: 0;
  }

  /* ── Opt-in form ── */
  #wtp-comm-cal-{{ section.id }} .cc-optin {
    background: var(--cc-card-bg);
    border-radius: 20px;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    border: 1px solid var(--cc-divider);
    color: #1B3A2D;
  }

  #wtp-comm-cal-{{ section.id }} .cc-optin__label {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0;
  }

  #wtp-comm-cal-{{ section.id }} .cc-optin__desc {
    font-size: 1.25rem;
    color: #1B3A2D;
    margin: 0;
    line-height: 1.5;
  }

  #wtp-comm-cal-{{ section.id }} .cc-optin__input {
    width: 100%;
    background: #f5f0e8;
    border: 1px solid rgba(27, 58, 45, 0.2);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    color: #1B3A2D;
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  #wtp-comm-cal-{{ section.id }} .cc-optin__input::placeholder {
    color: rgba(27, 58, 45, 0.5);
  }

  #wtp-comm-cal-{{ section.id }} .cc-optin__input:focus {
    border-color: var(--cc-accent);
  }

  .cc-optin__btn {
    width: 100%;
    padding: 1.4rem 1.8rem;
    background: var(--cc-accent);
    color: #fff;
    font-family: var(--font-body-family);
    font-size: 1.35rem;
    font-weight: 600;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .cc-optin__btn:hover {
    opacity: 0.85;
  }

  .cc-optin__success {
    display: none;
    font-size: 1.2rem;
    color: var(--cc-accent);
    text-align: center;
    padding: 0.5rem 0;
  }

  .cc-optin.is-success .cc-optin__form-body {
    display: none;
  }

  .cc-optin.is-success .cc-optin__success {
    display: block;
  }

  /* ── RIGHT PANEL — event rows ── */
  .cc-right {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 0;
  }

  /* ── Event row ── */
  .cc-event {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    align-items: start;
    gap: 0 2rem;
    padding: 3rem 0;
    border-bottom: 1px solid var(--cc-divider);
  }

  .cc-event:first-child {
    border-top: 1px solid var(--cc-divider);
  }

  /* Date block */
  .cc-event__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    padding-top: 0.1rem;
    flex-shrink: 0;
  }

  .cc-event__day {
    font-family: var(--font-heading-family);
    font-size: clamp(5rem, 8vw, 7rem);
    font-weight: 900;
    color: var(--cc-text);
    line-height: .9;
    letter-spacing: -0.02em;
  }

  .cc-event__month {
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cc-accent);
    margin-top: 0.25rem;
  }

  .cc-event__year {
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    letter-spacing: 0.14em;
    color: var(--cc-muted);
    margin-top: 0.15rem;
  }

  /* Middle: title, meta, desc */
  .cc-event__mid {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .cc-event__title-row {
    display: block;
    margin-bottom: 0.15rem;
  }

  .cc-event__title {
    font-family: var(--font-heading-family);
    font-size: clamp(2rem, 3vw, 2.8rem);
    font-weight: 600;
    font-style: italic;
    color: var(--cc-text);
    margin: 0;
    line-height: 1.1;
  }

  .cc-event__meta {
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--cc-muted);
    margin: 0.15rem 0 0;
  }

  .cc-event__desc {
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    color: var(--cc-muted);
    line-height: 1.7;
    margin: 0.75rem 0 0;
    max-width: 80ch;
  }

  .cc-event__spots strong {
    color: var(--cc-text);
  }

  /* Right: tag + RSVP */
  .cc-event__right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.25rem;
    flex-shrink: 0;
    padding-top: 0.15rem;
    min-width: 220px;
  }

  #wtp-comm-cal-{{ section.id }} .cc-event__tag {
    display: inline-block;
    padding: 0.5rem 1.2rem;
    background: #fff;
    color: #1B3A2D;
    border-radius: 50px;
    font-family: var(--font-body-family);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }


  .cc-event__spots {
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    color: var(--cc-muted);
    white-space: nowrap;
    font-weight: 600;
  }

  .cc-event__right-bottom {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
    width: 220px;
  }

  .cc-event__price {
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--cc-accent);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-align: right;
    margin-bottom: 0.25rem;
    display: block;
  }

  .cc-event__spots--sold {
    color: #d73cbe;
    font-weight: 700;
  }

  .cc-event__tag-row {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .cc-event__register {
    background: var(--cc-accent);
    color: #fff;
    padding: 1rem 1.8rem;
    border-radius: 50px;
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
    display: block;
    width: 100%;
    transition: opacity 0.2s ease;
  }

  .cc-event__register:hover {
    opacity: 0.9;
  }

  .cc-event__register.is-sold-out {
    background: var(--cc-input-bg);
    color: var(--cc-muted);
    cursor: not-allowed;
    opacity: 0.7;
    pointer-events: none;
  }

  .cc-event__viewdetails {
    background: transparent;
    border: 1px solid var(--cc-divider);
    color: var(--cc-text);
    padding: 0.9rem 1.8rem;
    border-radius: 50px;
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
    display: block;
    width: 100%;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .cc-event__viewdetails:hover {
    background: var(--cc-input-bg);
    border-color: var(--cc-muted);
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .cc-layout {
      flex-direction: column;
      padding: 2.5rem 1.25rem;
      gap: 2.5rem;
    }

    .cc-left {
      position: static;
      flex: 1 1 100%;
      width: 100%;
    }

    .cc-event {
      grid-template-columns: 48px 1fr;
      grid-template-rows: auto auto;
    }

    .cc-event__date {
      grid-row: 1;
    }

    .cc-event__mid {
      grid-row: 1;
    }

    .cc-event__right {
      grid-column: 1 / -1;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      margin-top: 0.75rem;
    }

    .cc-event__day {
      font-size: 1.5rem;
    }
  }
</style>

{%- comment -%} Resolve tag class helper {%- endcomment -%}

<section id="wtp-comm-cal-{{ section.id }}" aria-label="{{ section.settings.headline | escape }}">
  <div class="cc-layout">
    {%- comment -%} LEFT — headline + optin {%- endcomment -%}
    <div class="cc-left">
      {%- if section.settings.headline != blank -%}
        <h2 class="cc-headline">{{ section.settings.headline | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="cc-description">{{ section.settings.description | escape }}</p>
      {%- endif -%}

      {%- comment -%} Klaviyo opt-in {%- endcomment -%}
      <div class="cc-optin" id="wtp-cc-optin-{{ section.id }}">
        <p class="cc-optin__label">{{ section.settings.optin_label | default: 'Automated Reminders' | escape }}</p>
        <p class="cc-optin__desc">
          {{
            section.settings.optin_desc
            | default: "Never miss an event. We'll send you calendar updates for every stage."
            | escape
          }}
        </p>

        <form
          class="cc-optin__form-body"
          action="https://manage.kmail-lists.com/subscriptions/subscribe"
          data-ajax-submit="/remote/core/subscriptions/ajax_subscribe"
          method="POST"
          target="_blank"
          novalidate
          id="wtp-cc-optin-form-{{ section.id }}"
        >
          <input type="hidden" name="g" value="{{ section.settings.klaviyo_list_id | escape }}">
          <input type="hidden" name="$fields" value="$email">
          <input
            type="email"
            name="email"
            class="cc-optin__input"
            placeholder="{{ section.settings.optin_placeholder | default: 'Enter your email' | escape }}"
            required
          >
          <button type="submit" class="cc-optin__btn">
            {{ section.settings.optin_btn_label | default: 'Keep Me Notified' | escape }}
          </button>
        </form>

        <p class="cc-optin__success">You're in! 🎉 We'll keep you updated.</p>
      </div>
    </div>

    {%- comment -%} RIGHT — upcoming events {%- endcomment -%}
    <div class="cc-right">
      {%- assign today = 'now' | date: '%s' | plus: 0 -%}

      {%- comment -%} Robust Sort by Metafield: Earliest First {%- endcomment -%}
      {%- assign raw_events = collections[section.settings.events_collection].products -%}
      {%- capture events_with_dates -%}
        {%- for p in raw_events -%}
          {%- if p.metafields.custom.event_date != blank -%}
            {{ p.metafields.custom.event_date | date: '%Y%m%d' }}|{{ p.handle }}{% unless forloop.last %},{% endunless %}
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- assign sorted_event_strings = events_with_dates | split: ',' | sort -%}

      {%- assign events_shown = 0 -%}
      {%- for event_string in sorted_event_strings -%}
        {%- if events_shown >= section.settings.events_limit -%}
          {%- break -%}
        {%- endif -%}
        {%- assign handle = event_string | split: '|' | last -%}
        {%- for p in raw_events -%}
          {%- if p.handle == handle -%}
            {%- assign product = p -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- assign event_date_raw = product.metafields.custom.event_date -%}
        {%- assign event_date = event_date_raw | date: '%s' | plus: 0 -%}

        {%- if event_date >= today -%}
          {%- assign events_shown = events_shown | plus: 1 -%}
          {%- liquid
            assign raw_tag = product.metafields.custom.event_tag
          -%}
          <div class="cc-event">
            {%- comment -%} Date {%- endcomment -%}
            <div class="cc-event__date">
              {%- if event_date_raw != blank -%}
                <span class="cc-event__day">{{ event_date_raw | date: '%-d' }}</span>
                <span class="cc-event__month">{{ event_date_raw | date: '%b' | upcase }}</span>
                <span class="cc-event__year">{{ event_date_raw | date: '%Y' }}</span>
              {%- endif -%}
            </div>

            {%- comment -%} Middle {%- endcomment -%}
            <div class="cc-event__mid">
              <div class="cc-event__title-row">
                <h3 class="cc-event__title">{{ product.title | escape }}</h3>
              </div>

              {%- assign event_location = product.metafields.custom.event_location -%}
              {%- if event_location != blank -%}
                <p class="cc-event__meta">Location: {{ event_location | escape }}</p>
              {%- endif -%}

              {%- if product.description != blank -%}
                <p class="cc-event__desc">{{ product.description | strip_html | truncatewords: 60 }}</p>
              {%- endif -%}
            </div>

            {%- comment -%} Right: tag + Actions {%- endcomment -%}
            <div class="cc-event__right" style="align-items: flex-end;">
              <div class="cc-event__tag-row">
                {%- if product.variants.first.inventory_quantity > 0 -%}
                  {%- comment -%} Inventory left {%- endcomment -%}
                {%- else -%}
                  <span class="cc-event__spots cc-event__spots--sold">SOLD OUT</span>
                {%- endif -%}

                {%- if raw_tag != blank -%}
                  <span class="cc-event__tag">{{ raw_tag | escape }}</span>
                {%- endif -%}
              </div>

              <div class="cc-event__right-bottom">
                {%- if product.price > 0 -%}
                  <span class="cc-event__price">{{ product.price | money }}</span>
                {%- endif -%}
                {%- if product.variants.first.inventory_quantity > 0 -%}
                  <a href="{{ routes.cart_url }}/{{ product.variants.first.id }}:1?checkout" class="cc-event__register">Register Now</a>
                {%- else -%}
                  <span class="cc-event__register is-sold-out">FULLY BOOKED</span>
                {%- endif -%}
                <a href="{{ product.url }}" class="cc-event__viewdetails">View Details</a>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var optin = document.getElementById('wtp-cc-optin-{{ section.id }}');
    var form = document.getElementById('wtp-cc-optin-form-{{ section.id }}');
    if (!form || !optin) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var email = form.querySelector('input[type="email"]').value;
      var listId = form.querySelector('input[name="g"]').value;

      if (!email || !listId) return;

      fetch('https://manage.kmail-lists.com/subscriptions/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'g=' + encodeURIComponent(listId) + '&email=' + encodeURIComponent(email) + '&$fields=$email',
      })
        .then(function () {
          optin.classList.add('is-success');
        })
        .catch(function () {
          /* Still show success to avoid UX friction on CORS pre-flight */
          optin.classList.add('is-success');
        });
    });
  })();
</script>

{% schema %}
{
  "name": "Community Calendar",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F0E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1B3A2D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#C8A96E"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Opt-in Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Left Panel"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Community Calendar"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Open events for the WTP community. We keep it personal. Every stage offers curated tastings and brews for all."
    },
    {
      "type": "header",
      "content": "Email Opt-in"
    },
    {
      "type": "text",
      "id": "klaviyo_list_id",
      "label": "Klaviyo List ID",
      "info": "Found in your Klaviyo dashboard under Lists & Segments."
    },
    {
      "type": "text",
      "id": "optin_label",
      "label": "Form Label",
      "default": "Automated Reminders"
    },
    {
      "type": "textarea",
      "id": "optin_desc",
      "label": "Form Description",
      "default": "Never miss an event. We'll send you calendar updates for every stage."
    },
    {
      "type": "text",
      "id": "optin_placeholder",
      "label": "Email Input Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "optin_btn_label",
      "label": "Submit Button Label",
      "default": "Keep Me Notified"
    },
    {
      "type": "range",
      "id": "events_limit",
      "label": "Max Events to Show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "collection",
      "id": "events_collection",
      "label": "Events Collection"
    }
  ],
  "presets": [
    {
      "name": "Community Calendar"
    }
  ]
}
{% endschema %}
