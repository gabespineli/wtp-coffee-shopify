{%- style -%}
  /* ═══════════════════════════════════════
     WTP — Ecosystem of Care (Numbered)
  ═══════════════════════════════════════ */
  #wtp-ecosystem-{{ section.id }} {
    background: #F5F0E8;
    padding: 8rem 5%;
  }

  .eco-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ── Section Header ── */
  .eco-header {
    margin-bottom: 5rem;
    max-width: 640px;
  }

  .eco-title {
    font-family: var(--font-heading-family);
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    font-weight: 700;
    line-height: 1.08;
    color: #1B3A2D;
    margin: 0 0 1rem;
  }

  .eco-subtitle {
    font-family: 'Poppins', sans-serif;
    font-size: 1.1rem;
    line-height: 1.7;
    color: rgba(27, 58, 45, 0.65);
    margin: 0;
  }

  /* ── Three-column grid ── */
  .eco-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    margin-bottom: 4.5rem;
  }

  .eco-item {
    display: flex;
    flex-direction: column;
    border-top: 2px solid #C8A96E;
    padding-top: 2.5rem;
  }

  .eco-item-number {
    font-family: var(--font-heading-family);
    font-size: 3rem;
    font-weight: 700;
    color: #C8A96E;
    line-height: 1;
    margin: 0 0 1.5rem;
  }

  .eco-item-title {
    font-family: var(--font-heading-family);
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1.15;
    color: #1B3A2D;
    margin: 0 0 1rem;
  }

  .eco-item-desc {
    font-family: 'Poppins', sans-serif;
    font-size: 1.2rem;
    line-height: 1.75;
    color: rgba(27, 58, 45, 0.8);
    margin: 0 0 1.5rem;
  }

  .eco-item-bullets {
    font-family: 'Poppins', sans-serif;
    font-size: 1.15rem;
    line-height: 1.6;
    color: #1B3A2D;
    margin-top: auto; /* Pushes bullets to bottom if needed, or just provides gap */
    padding-top: 1rem;
  }

  .eco-item-bullets ul {
    margin: 0;
    padding: 0;
    list-style-type: disc;
    list-style-position: inside;
  }

  .eco-item-bullets li {
    margin-bottom: 0.5rem;
  }

  .eco-item-bullets li::marker {
    color: #C8A96E; /* Gold markers for better visual feedback */
  }

  /* ── Shared CTA ── */
  .eco-cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .eco-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.1rem 2.8rem;
    background: #1B3A2D;
    color: #F5F0E8;
    border-radius: 50px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1.5px solid #1B3A2D;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  .eco-cta:hover {
    background: #C8A96E;
    border-color: #C8A96E;
    color: #1B3A2D;
  }

  /* ═══════════════════════════════════════
     Responsive — Mobile
  ═══════════════════════════════════════ */
  @media screen and (max-width: 900px) {
    .eco-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
  }

  @media screen and (max-width: 600px) {
    #wtp-ecosystem-{{ section.id }} {
      padding: 5rem 1.25rem;
    }
    .eco-header {
      margin-bottom: 3.5rem;
    }
    .eco-cta {
      width: 100%;
    }
  }
{%- endstyle -%}

<section id="wtp-ecosystem-{{ section.id }}" aria-label="{{ section.settings.title | escape }}">
  <div class="eco-inner">

    {%- comment -%} ── Section Header ── {%- endcomment -%}
    <div class="eco-header">
      {%- if section.settings.title != blank -%}
        <h2 class="eco-title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="eco-subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} ── Three-column grid ── {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="eco-grid">
        {%- for block in section.blocks -%}
          {%- assign item_num = forloop.index | prepend: '0' | slice: -2, 2 -%}
          <div class="eco-item" {{ block.shopify_attributes }}>
            <span class="eco-item-number">{{ item_num }}</span>
            
            {%- if block.settings.item_title != blank -%}
              <h3 class="eco-item-title">{{ block.settings.item_title | escape }}</h3>
            {%- endif -%}
            
            {%- if block.settings.item_desc != blank -%}
              <p class="eco-item-desc">{{ block.settings.item_desc | escape }}</p>
            {%- endif -%}

            {%- capture bullets_html -%}
              {%- if block.settings.bullet_1 != blank -%}<li>{{ block.settings.bullet_1 | escape }}</li>{%- endif -%}
              {%- if block.settings.bullet_2 != blank -%}<li>{{ block.settings.bullet_2 | escape }}</li>{%- endif -%}
              {%- if block.settings.bullet_3 != blank -%}<li>{{ block.settings.bullet_3 | escape }}</li>{%- endif -%}
              {%- if block.settings.bullet_4 != blank -%}<li>{{ block.settings.bullet_4 | escape }}</li>{%- endif -%}
              {%- if block.settings.bullet_5 != blank -%}<li>{{ block.settings.bullet_5 | escape }}</li>{%- endif -%}
            {%- endcapture -%}

            {%- if bullets_html != blank -%}
              <div class="eco-item-bullets">
                <ul>{{ bullets_html }}</ul>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── Shared CTA ── {%- endcomment -%}
    {%- if section.settings.btn_label != blank -%}
      <div class="eco-cta-wrap">
        <a
          href="{{ section.settings.btn_url }}"
          class="eco-cta"
          {% if section.settings.btn_url == blank %}aria-disabled="true"{% endif %}
        >
          {{ section.settings.btn_label | escape }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Ecosystem of Care",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Ecosystem of Care"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Cultivating community through every pour."
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Inquire for Bookings →"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "type": "service_item",
      "name": "Service Item",
      "settings": [
        {
          "type": "text",
          "id": "item_title",
          "label": "Title",
          "default": "B2B Solutions (Wholesale)"
        },
        {
          "type": "textarea",
          "id": "item_desc",
          "label": "Description",
          "default": "Tailored coffee programs for businesses — from office setups to retail partnerships built on quality and consistency."
        },
        {
          "type": "header",
          "content": "Bullets"
        },
        {
          "type": "text",
          "id": "bullet_1",
          "label": "Bullet 1"
        },
        {
          "type": "text",
          "id": "bullet_2",
          "label": "Bullet 2"
        },
        {
          "type": "text",
          "id": "bullet_3",
          "label": "Bullet 3"
        },
        {
          "type": "text",
          "id": "bullet_4",
          "label": "Bullet 4"
        },
        {
          "type": "text",
          "id": "bullet_5",
          "label": "Bullet 5"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Ecosystem of Care",
      "blocks": [
        {
          "type": "service_item",
          "settings": {
            "item_title": "B2B Solutions (Wholesale)",
            "item_desc": "Tailored coffee programs for businesses — from office setups to retail partnerships built on quality and consistency.",
            "bullet_1": "Custom Blends",
            "bullet_2": "White Labelling"
          }
        },
        {
          "type": "service_item",
          "settings": {
            "item_title": "Coffee Consultancy + Partnership",
            "item_desc": "Expert guidance on sourcing, roasting, and brewing — helping cafés and brands elevate their coffee experience.",
            "bullet_1": "Basic Coffee Training",
            "bullet_2": "Menu Development"
          }
        },
        {
          "type": "service_item",
          "settings": {
            "item_title": "Event Coffee Services (Coffee Cart)",
            "item_desc": "From intimate gatherings to large-scale functions, our mobile coffee cart brings the full WTP experience to your event.",
            "bullet_1": "Mobile coffee cart for weddings",
            "bullet_2": "Corporate events",
            "bullet_3": "Private gatherings"
          }
        }
      ]
    }
  ]
}
{% endschema %}
