{%- comment -%}
  WTP Newsletter — Full-width email signup banner
  Forest green background with centered typography and Klaviyo integration.
{%- endcomment -%}

<style>
  #wtp-newsletter-{{ section.id }} {
    background: var(--color-background, #F5F0E8);
    padding: 3rem 5%;
    text-align: center;
    color: #1B3A2D;
    font-family: var(--font-body-family);
  }

  #wtp-newsletter-{{ section.id }} *,
  #wtp-newsletter-{{ section.id }} *::before,
  #wtp-newsletter-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  .wn-card {
    background: #F5F0E8;
    border-radius: 24px;
    padding: 5rem 4rem;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .wn-inner {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .wn-eyebrow {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0;
  }

  .wn-headline {
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: #1B3A2D;
    margin: 0;
    line-height: 1.1;
  }

  .wn-desc {
    font-size: 1.1rem;
    color: rgba(27, 58, 45, 0.6);
    margin: 0;
    line-height: 1.7;
    max-width: 520px;
  }

  .wn-form {
    width: 100%;
    max-width: 480px;
    margin-top: 0.5rem;
  }

  .wn-form-pill {
    display: flex;
    align-items: center;
    background: #fff;
    border-radius: 50px;
    padding: 0.5rem 0.5rem 0.5rem 1.5rem;
    gap: 0.5rem;
    width: 100%;
  }

  .wn-form-pill__icon {
    color: rgba(0,0,0,0.35);
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .wn-input {
    flex: 1;
    border: none;
    background: transparent;
    outline: none;
    font-size: 1.15rem;
    color: #1B3A2D;
    padding: 0.6rem 0;
  }

  .wn-input::placeholder {
    color: rgba(0,0,0,0.35);
  }

  .wn-input:focus {
    border-color: transparent;
  }

  .wn-btn {
    background: #1B3A2D;
    color: #fff;
    border: none;
    border-radius: 50px;
    padding: 1.15rem 2.75rem;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
  }

  .wn-btn:hover {
    opacity: 0.85;
  }

  .wn-success {
    display: none;
    color: #1B3A2D;
    font-size: 1.1rem;
    margin-top: 0.5rem;
    font-weight: 600;
  }

  .wn-inner.is-success .wn-form {
    display: none;
  }

  .wn-inner.is-success .wn-success {
    display: block;
  }

  @media (max-width: 600px) {
    .wn-card {
      padding: 3.5rem 1.25rem;
      border-radius: 16px;
    }
  }
</style>

<section id="wtp-newsletter-{{ section.id }}" aria-label="Newsletter Subscription">
  <div class="wn-card">
    <div class="wn-inner" id="wn-inner-{{ section.id }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="wn-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      
      {%- if section.settings.headline != blank -%}
        <h2 class="wn-headline">{{ section.settings.headline | escape }}</h2>
      {%- endif -%}
      
      {%- if section.settings.description != blank -%}
        <p class="wn-desc">{{ section.settings.description | escape }}</p>
      {%- endif -%}

      <form class="wn-form" id="wtp-nl-form-{{ section.id }}">
        <input type="hidden" name="g" value="{{ section.settings.klaviyo_list_id | escape }}">
        <div class="wn-form-pill">
          <span class="wn-form-pill__icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="M2 7l10 7 10-7"/>
            </svg>
          </span>
          <input 
            type="email" 
            name="email" 
            class="wn-input" 
            placeholder="{{ section.settings.placeholder | escape }}" 
            required
            aria-label="Email Address"
          >
          <button type="submit" class="wn-btn">{{ section.settings.btn_label | escape }}</button>
        </div>
      </form>
      
      <p class="wn-success" id="wtp-nl-success-{{ section.id }}">You're in. Welcome to the community.</p>
    </div>
  </div>
</section>

<script>
  (function() {
    var container = document.getElementById('wn-inner-{{ section.id }}');
    var form = document.getElementById('wtp-nl-form-{{ section.id }}');
    if (!form || !container) return;

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var emailInput = form.querySelector('input[name="email"]');
      var listIdInput = form.querySelector('input[name="g"]');
      var email = emailInput ? emailInput.value : '';
      var listId = listIdInput ? listIdInput.value : '';

      if (!email || !listId) {
        if (!listId) console.warn('WTP Newsletter: Missing Klaviyo List ID');
        return;
      }

      fetch('https://manage.kmail-lists.com/subscriptions/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'g=' + encodeURIComponent(listId) + '&email=' + encodeURIComponent(email) + '&$fields=$email',
      })
      .then(function() {
        container.classList.add('is-success');
      })
      .catch(function() {
        /* Fallback: show success even if fetch fails due to CORS, as Klaviyo often still processes it */
        container.classList.add('is-success');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "WTP Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stay in the Loop"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Never Miss a Pour"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Seasonal releases, community events, and brewing notes — delivered straight to your inbox."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email Placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "klaviyo_list_id",
      "label": "Klaviyo List ID",
      "info": "Found in your Klaviyo dashboard under Lists & Segments."
    }
  ],
  "presets": [
    {
      "name": "WTP Newsletter"
    }
  ]
}
{% endschema %}
