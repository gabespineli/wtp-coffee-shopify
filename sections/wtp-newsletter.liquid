{%- comment -%}
  WTP Newsletter — Full-width email signup banner
  Forest green background with centered typography and Klaviyo integration.
{%- endcomment -%}

<style>
  #wtp-newsletter-{{ section.id }} {
    background: #1B3A2D;
    padding: 6rem 5%;
    text-align: center;
    color: #fff;
    font-family: var(--font-body-family);
  }

  #wtp-newsletter-{{ section.id }} *,
  #wtp-newsletter-{{ section.id }} *::before,
  #wtp-newsletter-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  .wn-inner {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .wn-eyebrow {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0;
  }

  .wn-headline {
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: #fff;
    margin: 0;
    line-height: 1.1;
  }

  .wn-desc {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
    line-height: 1.7;
    max-width: 520px;
  }

  .wn-form {
    display: flex;
    gap: 0.75rem;
    width: 100%;
    max-width: 540px;
    margin-top: 0.5rem;
  }

  .wn-input {
    flex: 1;
    padding: 1rem 1.4rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: #fff;
    font-size: 1rem;
    outline: none;
    font-family: var(--font-body-family);
    transition: border-color 0.2s ease;
  }

  .wn-input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .wn-input:focus {
    border-color: rgba(255, 255, 255, 0.5);
  }

  .wn-btn {
    padding: 1rem 2rem;
    background: #F5F0E8;
    color: #1B3A2D;
    font-size: 1rem;
    font-weight: 700;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s ease;
    font-family: var(--font-body-family);
  }

  .wn-btn:hover {
    opacity: 0.85;
  }

  .wn-success {
    display: none;
    color: #C8A96E;
    font-size: 1.1rem;
    margin-top: 0.5rem;
    font-weight: 600;
  }

  .wn-inner.is-success .wn-form {
    display: none;
  }

  .wn-inner.is-success .wn-success {
    display: block;
  }

  @media (max-width: 600px) {
    .wn-form {
      flex-direction: column;
    }
    .wn-btn {
      width: 100%;
    }
  }
</style>

<section id="wtp-newsletter-{{ section.id }}" aria-label="Newsletter Subscription">
  <div class="wn-inner" id="wn-inner-{{ section.id }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="wn-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    
    {%- if section.settings.headline != blank -%}
      <h2 class="wn-headline">{{ section.settings.headline | escape }}</h2>
    {%- endif -%}
    
    {%- if section.settings.description != blank -%}
      <p class="wn-desc">{{ section.settings.description | escape }}</p>
    {%- endif -%}

    <form class="wn-form" id="wtp-nl-form-{{ section.id }}">
      <input type="hidden" name="g" value="{{ section.settings.klaviyo_list_id | escape }}">
      <input 
        type="email" 
        name="email" 
        class="wn-input" 
        placeholder="{{ section.settings.placeholder | escape }}" 
        required
        aria-label="Email Address"
      >
      <button type="submit" class="wn-btn">{{ section.settings.btn_label | escape }}</button>
    </form>
    
    <p class="wn-success" id="wtp-nl-success-{{ section.id }}">You're in. Welcome to the community.</p>
  </div>
</section>

<script>
  (function() {
    var container = document.getElementById('wn-inner-{{ section.id }}');
    var form = document.getElementById('wtp-nl-form-{{ section.id }}');
    if (!form || !container) return;

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var emailInput = form.querySelector('input[name="email"]');
      var listIdInput = form.querySelector('input[name="g"]');
      var email = emailInput ? emailInput.value : '';
      var listId = listIdInput ? listIdInput.value : '';

      if (!email || !listId) {
        if (!listId) console.warn('WTP Newsletter: Missing Klaviyo List ID');
        return;
      }

      fetch('https://manage.kmail-lists.com/subscriptions/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'g=' + encodeURIComponent(listId) + '&email=' + encodeURIComponent(email) + '&$fields=$email',
      })
      .then(function() {
        container.classList.add('is-success');
      })
      .catch(function() {
        /* Fallback: show success even if fetch fails due to CORS, as Klaviyo often still processes it */
        container.classList.add('is-success');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "WTP Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stay in the Loop"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Never Miss a Pour"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Seasonal releases, community events, and brewing notes — delivered straight to your inbox."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email Placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "klaviyo_list_id",
      "label": "Klaviyo List ID",
      "info": "Found in your Klaviyo dashboard under Lists & Segments."
    }
  ],
  "presets": [
    {
      "name": "WTP Newsletter"
    }
  ]
}
{% endschema %}
