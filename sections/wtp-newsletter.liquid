{%- comment -%}
  WTP Newsletter — Full-width email signup banner
  Forest green background with centered typography and Klaviyo integration.
{%- endcomment -%}

<style>
  #wtp-newsletter-{{ section.id }} {
    background: var(--color-background, #F5F0E8);
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: 5%;
    padding-right: 5%;
    text-align: center;
    color: #1B3A2D;
    font-family: var(--font-body-family);
  }

  @media screen and (min-width: 750px) {
    #wtp-newsletter-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #wtp-newsletter-{{ section.id }} *,
  #wtp-newsletter-{{ section.id }} *::before,
  #wtp-newsletter-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  .wn-card {
    background: #F5F0E8;
    border-radius: 20px;
    padding: 5rem 4rem;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .wn-inner {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .wn-eyebrow {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0;
  }

  .wn-headline {
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: #1B3A2D;
    margin: 0;
    line-height: 1.1;
  }

  .wn-desc {
    font-size: 1.1rem;
    color: rgba(27, 58, 45, 0.6);
    margin: 0;
    line-height: 1.7;
    max-width: 520px;
  }

  .wn-form {
    width: 100%;
    max-width: 480px;
    margin-top: 0.5rem;
  }

  .wn-form-pill {
    display: flex;
    align-items: center;
    background: #fff;
    border-radius: 50px;
    padding: 0.5rem 0.5rem 0.5rem 1.5rem;
    gap: 0.5rem;
    width: 100%;
  }

  .wn-form-pill__icon {
    color: rgba(0,0,0,0.35);
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .wn-input {
    flex: 1;
    border: none;
    background: transparent;
    outline: none;
    font-size: 1.15rem;
    color: #1B3A2D;
    padding: 0.6rem 0;
  }

  .wn-input::placeholder {
    color: rgba(0,0,0,0.35);
  }

  .wn-input:focus {
    border-color: transparent;
  }

  .wn-btn {
    background: #1B3A2D;
    color: #fff;
    border: none;
    border-radius: 50px;
    padding: 1.15rem 2.75rem;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
  }

  .wn-btn:hover {
    opacity: 0.85;
  }

  .wn-success {
    color: #1B3A2D;
    font-size: 1.1rem;
    margin-top: 0.5rem;
    font-weight: 600;
  }

  .wn-error {
    color: #8b1a1a;
    font-size: 1rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 600px) {
    .wn-card {
      padding: 3.5rem 1.25rem;
      border-radius: 16px;
    }
  }
</style>

<section id="wtp-newsletter-{{ section.id }}" aria-label="Newsletter Subscription">
  <div class="wn-card">
    <div class="wn-inner" id="wn-inner-{{ section.id }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="wn-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      
      {%- if section.settings.headline != blank -%}
        <h2 class="wn-headline">{{ section.settings.headline | escape }}</h2>
      {%- endif -%}
      
      {%- if section.settings.description != blank -%}
        <p class="wn-desc">{{ section.settings.description | escape }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'wn-form', id: 'wtp-nl-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        
        {%- if form.posted_successfully? -%}
          <p class="wn-success">Thanks for subscribing!</p>
        {%- else -%}
          <div class="wn-form-pill">
            <span class="wn-form-pill__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="M2 7l10 7 10-7"/>
              </svg>
            </span>
            <input 
              type="email" 
              name="contact[email]" 
              class="wn-input" 
              placeholder="{{ section.settings.placeholder | escape }}" 
              required
              aria-label="Email Address"
            >
            <button type="submit" class="wn-btn">{{ section.settings.btn_label | escape }}</button>
          </div>
          {%- if form.errors -%}
            <p class="wn-error">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>



{% schema %}
{
  "name": "WTP Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stay in the Loop"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Join the WTP Community"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Subscribe for updates and releases — delivered straight to your inbox."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email Placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "WTP Newsletter"
    }
  ]
}
{% endschema %}
