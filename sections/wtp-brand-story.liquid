{% comment %}
  WTP Brand Story Section
  Two-column layout: Left text, Right image with overlapping stat card.
{% endcomment %}

<style>
  #wtp-brand-story-{{ section.id }} {
    background: var(--color-background, #F5F0E8);
    padding: 9rem 5%;
    overflow: hidden;
  }

  .bs-layout {
    display: flex;
    gap: 7rem;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  .bs-layout--image-first {
    flex-direction: row-reverse;
  }

  /* ── LEFT ── */
  .bs-left {
    flex: 0 0 45%;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .bs-eyebrow {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #C8A96E;
    margin: 0;
  }

  .bs-headline {
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    font-weight: 700;
    line-height: 1.05;
    color: #1B3A2D;
    margin: 0;
  }

  .bs-headline em {
    font-style: italic;
    font-weight: 600;
  }

  .bs-body {
    font-size: 1.15rem;
    line-height: 1.85;
    color: rgba(27,58,45,0.65);
    margin: 0;
  }

  .bs-cta {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #F5F0E8;
    background: #1B3A2D;
    text-decoration: none;
    border-radius: 50px;
    padding: 1.1rem 2.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.5rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .bs-cta:hover {
    background: #1B3A2D;
    opacity: 0.92;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(27, 58, 45, 0.2);
    color: #F5F0E8;
  }

  .bs-cta svg {
    transition: transform 0.3s ease;
  }

  .bs-cta:hover svg {
    transform: translateX(4px);
  }

  /* ── RIGHT ── */
  .bs-right {
    flex: 1 1 auto;
    position: relative;
  }

  .bs-image-wrapper {
    border-radius: 16px;
    overflow: hidden;
    width: 100%;
  }

  .bs-image {
    width: 100%;
    height: 520px;
    object-fit: cover;
    display: block;
  }

  .bs-stat-card {
    position: absolute;
    bottom: -2rem;
    left: -3rem;
    background: #1B3A2D;
    color: #fff;
    border-radius: 14px;
    padding: 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 180px;
    z-index: 2;
  }

  .bs-stat-card__number {
    font-family: var(--font-heading-family);
    font-size: 2.8rem;
    font-weight: 800;
    color: #C8A96E;
    margin: 0;
    line-height: 1;
  }

  .bs-stat-card__label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.65);
    margin: 0;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    #wtp-brand-story-{{ section.id }} {
      padding: 4rem 5%;
    }

    .bs-layout {
      flex-direction: column;
      gap: 3rem;
    }

    .bs-left {
      flex: 1 1 100%;
      text-align: center;
      align-items: center;
    }

    .bs-image {
      height: 320px;
    }

    .bs-stat-card {
      position: absolute;
      bottom: -1.5rem;
      left: 1rem;
      padding: 1.25rem 1.5rem;
      min-width: 150px;
    }

    .bs-stat-card__number {
      font-size: 2.2rem;
    }
  }
</style>

<section id="wtp-brand-story-{{ section.id }}" aria-label="{{ section.settings.headline_plain | escape }} {{ section.settings.headline_italic | escape }}">
  <div class="bs-layout {% if section.settings.layout == 'image_first' %}bs-layout--image-first{% endif %}">

    <!-- LEFT -->
    <div class="bs-left">
      {%- if section.settings.eyebrow != blank -%}
        <p class="bs-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      
      <h2 class="bs-headline">
        {{ section.settings.headline_plain | escape }}<br>
        <em>{{ section.settings.headline_italic | escape }}</em>
      </h2>

      {%- if section.settings.body_1 != blank -%}
        <p class="bs-body">{{ section.settings.body_1 | escape }}</p>
      {%- endif -%}
      
      {%- if section.settings.body_2 != blank -%}
        <p class="bs-body">{{ section.settings.body_2 | escape }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="bs-cta">
          {{ section.settings.cta_label | escape }}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <!-- RIGHT -->
    <div class="bs-right">
      {%- if section.settings.main_image != blank -%}
        <div class="bs-image-wrapper">
          {{ section.settings.main_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'bs-image' }}
        </div>
      {%- else -%}
        <div class="bs-image-wrapper">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'bs-image' }}
        </div>
      {%- endif -%}

      {%- if section.settings.stat_number != blank -%}
        <div class="bs-stat-card">
          <p class="bs-stat-card__number">{{ section.settings.stat_number | escape }}</p>
          <p class="bs-stat-card__label">{{ section.settings.stat_label | escape }}</p>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "WTP Brand Story",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout Direction",
      "options": [
        {
          "value": "image_first",
          "label": "Image first"
        },
        {
          "value": "text_first",
          "label": "Text first"
        }
      ],
      "default": "text_first"
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Our Philosophy"
    },
    {
      "type": "text",
      "id": "headline_plain",
      "label": "Headline (Plain)",
      "default": "Perfecting"
    },
    {
      "type": "text",
      "id": "headline_italic",
      "label": "Headline (Italic)",
      "default": "The Art of the Roast"
    },
    {
      "type": "textarea",
      "id": "body_1",
      "label": "Body Paragraph 1",
      "default": "At We The People (WTP), our journey begins long before the first pour. We are relentless in our pursuit of the perfect profile, continuously developing our own roasting processes to honor the unique character of every harvest."
    },
    {
      "type": "textarea",
      "id": "body_2",
      "label": "Body Paragraph 2",
      "default": "By mastering the delicate science behind the bean, we transform raw potential into a shared experience, ensuring every cup reflects our dedication to the craft and our community."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "Discover Our Roasting Journey"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "header",
      "content": "Visuals & Stats"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "text",
      "id": "stat_number",
      "label": "Stat Number",
      "default": "15+"
    },
    {
      "type": "text",
      "id": "stat_label",
      "label": "Stat Label",
      "default": "Local Producers Supported"
    }
  ],
  "presets": [
    {
      "name": "WTP Brand Story"
    }
  ]
}
{% endschema %}
