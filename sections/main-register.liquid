{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* ════════════════════════════════════════
     WTP Register Page — Auth Design System
  ════════════════════════════════════════ */
  .wtp-auth {
    --auth-bg:       #F5F0E8;
    --auth-green:    #1B3A2D;
    --auth-gold:     #C8A96E;
    --auth-muted:    rgba(27, 58, 45, 0.5);
    --auth-border:   rgba(27, 58, 45, 0.25);
    --auth-border-focus: #1B3A2D;
    background: var(--auth-bg);
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 1.5rem;
    font-family: var(--font-body-family);
  }

  .wtp-auth__card {
    width: 100%;
    max-width: 500px;
  }

  .wtp-auth__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--auth-gold);
    display: block;
    text-align: center;
    margin-bottom: 0.75rem;
  }

  .wtp-auth__title {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    font-style: italic;
    font-weight: 700;
    line-height: 1.1;
    color: var(--auth-green);
    text-align: center;
    margin: 0 0 0.5rem;
  }

  .wtp-auth__divider {
    width: 40px;
    height: 2px;
    background: var(--auth-gold);
    border: none;
    margin: 1rem auto 2.5rem;
  }

  .wtp-auth__field {
    position: relative;
    margin-bottom: 1.75rem;
  }

  .wtp-auth__label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--auth-muted);
    margin-bottom: 0.5rem;
  }

  .wtp-auth__input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1.5px solid var(--auth-border);
    border-radius: 0;
    padding: 0.75rem 0;
    font-family: var(--font-body-family);
    font-size: 1.05rem;
    color: var(--auth-green);
    outline: none;
    transition: border-color 0.2s ease;
    -webkit-appearance: none;
  }

  .wtp-auth__input:focus {
    border-bottom-color: var(--auth-border-focus);
  }

  .wtp-auth__input::placeholder {
    color: rgba(27, 58, 45, 0.3);
  }

  .wtp-auth__field-error {
    display: block;
    font-size: 0.8rem;
    color: #a03030;
    margin-top: 0.4rem;
  }

  .wtp-auth__submit {
    width: 100%;
    background: var(--auth-green);
    color: #F5F0E8;
    border: none;
    border-radius: 50px;
    padding: 1.1rem 2rem;
    font-family: var(--font-body-family);
    font-size: 0.88rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
    margin-top: 0.5rem;
  }

  .wtp-auth__submit:hover {
    background: #142e22;
    transform: translateY(-1px);
  }

  .wtp-auth__link {
    display: block;
    text-align: center;
    font-size: 0.9rem;
    color: var(--auth-muted);
    text-decoration: none;
    margin-top: 1.25rem;
    transition: color 0.2s ease;
  }

  .wtp-auth__link:hover {
    color: var(--auth-green);
  }

  .wtp-auth__message {
    padding: 1rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .wtp-auth__message--error {
    background: rgba(200, 60, 60, 0.07);
    border-left: 3px solid #c83c3c;
    color: #7a1a1a;
  }

  .wtp-auth__message--error ul {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
  }

  .wtp-auth__message--error a {
    color: inherit;
    font-weight: 700;
  }

  .wtp-auth__two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 1.5rem;
  }
{%- endstyle -%}

<div class="wtp-auth">
  <div class="wtp-auth__card">

    <span class="wtp-auth__eyebrow">WTP Coffee</span>
    <h1 class="wtp-auth__title">{{ 'customer.register.title' | t }}</h1>
    <hr class="wtp-auth__divider" aria-hidden="true">

    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div class="wtp-auth__message wtp-auth__message--error" tabindex="-1" autofocus role="alert">
          <strong>{{ 'templates.contact.form.error_heading' | t }}</strong>
          <ul>
            {%- for field in form.errors -%}
              <li>
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  <a href="#RegisterForm-{{ field }}">
                    {{ form.errors.translated_fields[field] | capitalize }}
                    {{ form.errors.messages[field] }}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="wtp-auth__two-col">
        <div class="wtp-auth__field">
          <label class="wtp-auth__label" for="RegisterForm-FirstName">{{ 'customer.register.first_name' | t }}</label>
          <input
            type="text"
            name="customer[first_name]"
            id="RegisterForm-FirstName"
            class="wtp-auth__input"
            {% if form.first_name %}value="{{ form.first_name }}"{% endif %}
            autocomplete="given-name"
            placeholder="{{ 'customer.register.first_name' | t }}"
          >
        </div>
        <div class="wtp-auth__field">
          <label class="wtp-auth__label" for="RegisterForm-LastName">{{ 'customer.register.last_name' | t }}</label>
          <input
            type="text"
            name="customer[last_name]"
            id="RegisterForm-LastName"
            class="wtp-auth__input"
            {% if form.last_name %}value="{{ form.last_name }}"{% endif %}
            autocomplete="family-name"
            placeholder="{{ 'customer.register.last_name' | t }}"
          >
        </div>
      </div>

      <div class="wtp-auth__field">
        <label class="wtp-auth__label" for="RegisterForm-email">{{ 'customer.register.email' | t }}</label>
        <input
          type="email"
          name="customer[email]"
          id="RegisterForm-email"
          class="wtp-auth__input"
          {% if form.email %}value="{{ form.email }}"{% endif %}
          spellcheck="false"
          autocapitalize="off"
          autocomplete="email"
          aria-required="true"
          {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="RegisterForm-email-error"{% endif %}
          placeholder="{{ 'customer.register.email' | t }}"
        >
        {%- if form.errors contains 'email' -%}
          <span id="RegisterForm-email-error" class="wtp-auth__field-error">
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}.
          </span>
        {%- endif -%}
      </div>

      <div class="wtp-auth__field">
        <label class="wtp-auth__label" for="RegisterForm-password">{{ 'customer.register.password' | t }}</label>
        <input
          type="password"
          name="customer[password]"
          id="RegisterForm-password"
          class="wtp-auth__input"
          aria-required="true"
          {% if form.errors contains 'password' %}aria-invalid="true" aria-describedby="RegisterForm-password-error"{% endif %}
          placeholder="{{ 'customer.register.password' | t }}"
        >
        {%- if form.errors contains 'password' -%}
          <span id="RegisterForm-password-error" class="wtp-auth__field-error">
            {{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}.
          </span>
        {%- endif -%}
      </div>

      <button class="wtp-auth__submit">{{ 'customer.register.submit' | t }}</button>
      <a href="{{ routes.account_login_url }}" class="wtp-auth__link">Already have an account? Sign in</a>
    {%- endform -%}

  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-register.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
